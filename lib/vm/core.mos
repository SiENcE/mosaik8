-- vm.core -- the VM8 interpreter + frame loop (docs/vm8-spec.md).
--
-- The VM8 8-bit game virtual machine implemented in mosaik. It owns the frame
-- -- input, the script scheduler, native actor render, present -- and runs up
-- to VM_CTXS cooperative THREADS (contexts), each a PC into a bytecode blob. A
-- round-robin scheduler runs up to QUANT instructions per thread per frame
-- (spec R3); WAITABLE ops (idle, wait N frames, actor move-to, text) suspend a
-- thread without blocking the game by rewinding the PC to the op and yielding
-- (spec Â§9); a LOCK pins execution to the locking thread (plus the exempt
-- music thread) and freezes every other thread (the cutscene primitive).
-- Threads take arguments (THREADN, spec Â§6 op 0x07), are joinable through
-- heap-cell HANDLEs (Â§3/Â§11), and scene change / reset / load-complete are one
-- RAISE exception mechanism serviced by the frame loop (Â§10).
--
-- mosaik has no pointers, so the two conventions that would need them are
-- recast exactly as the spec demands:
--   * PC is a plain u16 offset; bytecode is read through a GAME-provided fetch
--     CALLBACK (function(u16) -> u8) -- the banking/streaming seam (spec R2);
--     the blob lives in the project's `scripts` module.
--   * dispatch is a `switch` over the opcode byte; each case reads its own
--     operands with f8()/f16(). Operand widths come from mosaik_vm/isa.py (the
--     one ISA table, spec R4) -- keep them in lockstep.

-- `bank(0)` ON THE INTERPRETER, and only on it (`[build] code_banks` may now
-- list "vm.core"). Banking is per MODULE but hotness is per FUNCTION: the
-- fetch/dispatch/RPN path (step, rpn_eval, run, run_context, f8/f16,
-- vpush/vpop, the state accessors, the per-frame input + timer ticks) runs per
-- INSTRUCTION BYTE and must never pay a cross-bank trampoline -- that is the
-- Lynx cart-page-reader mistake. Everything NOT pinned here runs once at boot,
-- once per scene change or once per event: boot itself, the ~19 seam setters,
-- spawn/kill/reset_scene_ui/fade_out/font_preload/clear_player. Letting that
-- half bank frees ~880 B of GB bank 0 (measured on the reference-engine sample conversion's GBC,
-- which had 94 B spare) with the hot path provably 100% resident.
-- A `bank(0)` pin is a NO-OP unless the build opts vm.core into code_banks,
-- so every project that does not is byte-identical.
module "vm.core" {
    import "platform.video"
    import "platform.input"
    import "platform.system"
    import "graphics.sprite"
    import "graphics.text"
    import "vm.actor"
    import "vm.player"
    import "vm.fx"
    import "engine.menu"

    -- UNIFORM sizing on every console (VM8 spec Â§14), pinned to the leanest
    -- target (the Lynx: cc65 packs CODE+RODATA+DATA+BSS into ONE ~48 KB
    -- MAIN). One size set means one blob, one compiler check, and no "works on
    -- GB, corrupts on Lynx" bug class. The context arrays below (vm_stack /
    -- vm_call / vm_arg) mirror these sizes with LITERALS (mosaik array sizes
    -- must be a NUMBER, so they can't be VM_CTXS * VM_STACK -- keep in step).
    const VM_CTXS = 8       -- concurrent threads
    -- QUANT: instructions per thread per frame (spec R3 budget). Spec 14 pins it
    -- at 16 and lets a BUILD raise it via `[build] vm_quant = 512`, which states
    -- VM_QUANT_MIN = false. An ABSENT flag stays unresolvable, and an unresolvable
    -- module-level condition keeps its `then` arm -- so the default is 16 and
    -- byte-identical. Raising it is a CORRECTNESS lever for a program that keeps
    -- scratch state in shared heap cells across a CALL chain: the whole critical
    -- section has to finish in one slice or another thread interleaves and
    -- clobbers the arguments (see the falling-block assembly sample).
    if VM_QUANT_MIN {
        const QUANT = 16
    } else {
        const QUANT = 512
    }
    -- The vm.actor pool size (the `[build] actor_pool` knob, default 8). Core
    -- clamps every actor-index it stores or resolves against THIS, never a
    -- literal 8: a grown pool with a hardcoded clamp silently redirected every
    -- script op on slots 8+ to actor 0.
    const VM_ACTORS = VM_ACTOR_POOL
    -- The frame lock's display-clock sample (see run()). Declared INSIDE the
    -- fork so a project that does not lock emits no byte of it at all.
    if VM_FRAME_LOCK_ON {
        var lk_t0: u8
    }
    const VM_HEAP = 128     -- i16 game-variable cells; the SAVE payload
    const VM_STACK = 8      -- i16 expr-stack cells/thread (statically verified)
    const CALL_DEPTH = 4    -- nested subroutine calls/thread
    const NARGS = 4         -- thread arguments/thread (THREADN / the ARG token)

    if platform == "lynx" {
        -- The Lynx is DOUBLE-BUFFERED: present recomposites the frame and WIPES the
        -- once-drawn text box/menu, so run() must re-draw them AFTER present. Every
        -- other console keeps a persistent tilemap/name-table, where the run_scripts
        -- draw stays put -- and re-plotting a framed box (a clear_area + ~130 tile
        -- writes) AFTER present, during active display, TEARS = a 3-frame flicker
        -- (vm-uiquest's title menu). So the post-present redraw is Lynx-only.
        const NEEDS_PRESENT_REDRAW = 1
    } else {
        const NEEDS_PRESENT_REDRAW = 0
    }

    -- SMS / GAME GEAR draw UI into the SCROLLING scene map and have no window
    -- overlay to bottom-anchor it. Three things follow, all of which the GB
    -- family gets from the window layer for free, and each is a STATEMENT-level
    -- `if platform` at its own site (so every other console compiles out to the
    -- byte-identical code it had):
    --
    --  * A menu's `row` comes out of TARGET-NEUTRAL bytecode, so the assembler
    --    picks it for the SHORTEST screen (isa.MIN_SCREEN_ROWS = 12, the
    --    Lynx/PCE text grid). On an 18-row GB that is fine because to_window
    --    relocates the box to the bottom regardless; on a 24-row SMS nothing
    --    relocated it, so a default-row menu drew across the MIDDLE of the
    --    screen. OP_MENU re-anchors it below - the runtime is the only place
    --    that knows the real SCREEN_ROWS.
    --  * The box's cells belong to the scene, so closing it must REPAINT them:
    --    core.set_redraw, wired by the generated rooms.mos (before this the
    --    seam had never been wired by any generator, so has_redraw was always
    --    0 and the close left a blank band).
    --  * The camera must HOLD while the box is open, or the box scrolls away
    --    with the level - vm.player's follow_and_render.

    -- step() status
    const ST_CONT = 0       -- ran an op, keep executing this thread
    const ST_YIELD = 1      -- waitable/idle -- stop this thread for the frame
    const ST_END = 2        -- thread terminated

    -- opcodes: the VM8 map (spec Â§6; lockstep with mosaik_vm/isa.py OPS)
    const OP_STOP = 0x00
    const OP_JUMP = 0x01
    const OP_IDLE = 0x02
    const OP_WAIT = 0x03
    const OP_LOCK = 0x04
    const OP_UNLOCK = 0x05
    const OP_THREAD = 0x06
    const OP_THREADN = 0x07     -- (t, n) spawn with n popped args (last-pushed -> arg[n-1])
    const OP_RPN = 0x08         -- evaluate an inline RPN expression -> stack top
    const OP_SET_CONST = 0x09
    const OP_SET_VAR = 0x0A     -- heap[idx] = pop()
    const OP_IF = 0x0B          -- pop(); if == 0 jump (branch-if-false)
    const OP_SWITCH = 0x0C      -- pop(); jump table: u8 count, count*(i16 val, u16 target)
    const OP_CALL = 0x0D        -- call a script subroutine (push return addr)
    const OP_RET = 0x0E         -- return from a subroutine (pop); empty stack = end
    const OP_RAISE = 0x0F       -- (code, a, b, c) raise an exception + end this thread (Â§10)
    const OP_SET_STATE = 0x10   -- (id) pop(); write a curated engine-state field
    const OP_PLAYER_SETPOS = 0x11  -- (x, y) engine-state write: move the player
    const OP_PLAYER_SETPOS_E = 0x12 -- (pops x,y) move the player to expr coords
    const OP_HANDLE = 0x13      -- (i) bind THIS thread's liveness to heap[i] (join, Â§11)
    const OP_HANDLE_NEXT = 0x14 -- (i) one-shot latch: HANDLE the next THREAD/THREADN child
    const OP_SELF = 0x15        -- (a) bind the thread's SELF actor from bytecode
    const OP_CHANGE_SCENE_E = 0x16 -- (pops room,x,y) RAISE 2 to a COMPUTED room
    const OP_A_ACTIVATE = 0x20

    -- exception codes (the RAISE op / raise_ex native API, spec Â§10)
    const EX_RESET = 1          -- kill all threads, keep the heap, restart entry
    const EX_CHANGE_SCENE = 2   -- (room=a, x=b, y=c) through the scene-change pack
    const EX_LOAD_COMPLETE = 3  -- as CHANGE_SCENE, raised by the save pack's restore

    -- Curated engine-state ids (SET_STATE writes, the GET_STATE RPN token reads).
    -- The safe pointer-free bridge: no raw addresses
    -- in bytecode. Kept in lockstep with mosaik_vm.py's STATES map.
    const ST_PLAYER_X = 0
    const ST_PLAYER_Y = 1
    const ST_CAMERA_X = 2       -- writing camera x/y PINS (locks) the scripted camera
    const ST_CAMERA_Y = 3
    -- the reference engine's `camera_settings` BYTE, flag for flag (the reference VM's camera.h):
    -- LOCK_X 0x01 / LOCK_Y 0x02 mean the camera FOLLOWS on that axis, and
    -- X_MIN 0x04 / X_MAX 0x08 / Y_MIN 0x10 / Y_MAX 0x20 are its
    -- `preventScroll` directions (left / right / up / down), each clamping the
    -- camera against its own PREVIOUS position. 0x03 (follow both) is
    -- `camera_init`'s value and ours.
    --
    -- THE POLARITY IS THE OPPOSITE OF WHAT THIS STATE USED TO MEAN. It was a
    -- single bool, "write 0 = release (resume follow), 1 = hold here" - GB
    -- Studio's word with the reference engine's sense inverted, which the importer got
    -- right only by accident of shape. Now 0 is the full pin and 3 resumes.
    -- The authoring EVENTS are unchanged: `camera_lock` still pins at (x, y),
    -- `camera_release` still resumes.
    const ST_CAMERA_LOCK = 4
    const ST_SCENE = 5          -- read-only: the current room id
    const ST_SAVE_EXISTS = 6    -- read-only: 1 when a valid battery save is present
    const ST_PLAYER_DIR = 7     -- the player's facing (0 down/1 up/2 left/3 right); WRITABLE
    -- Read-only, and answered by the CONSOLE, not the game: 1 on colour
    -- hardware. It is a runtime read rather than a compile-time `if platform`
    -- fork because ONE bytecode blob serves every target - the reference engine's
    -- EVENT_IF_COLOR_SUPPORTED tests its own `_is_CGB` exactly this way.
    const ST_IS_COLOR = 8
    -- WRITE-only: reseed the host RNG that backs rand(). The reference engine's
    -- EVENT_RNG_SEED; a state write rather than an opcode because the seed is
    -- already an expression the RPN stack carries.
    const ST_RAND_SEED = 9
    -- READ-only: a free-running u16 VM-FRAME counter (the reference engine's sys_time) -
    -- the clock a bytecode-level rate limit compares against. It counts VM
    -- frames, not display frames (spec R3), so it measures GAME time.
    const ST_GAME_TIME = 10
    -- WRITE-only: 1 = other ACTORS block the player, 0 = the player walks
    -- through them (the reference engine's EVENT_ACTOR_COLLISIONS_DISABLE aimed at the
    -- player, whose actors[0] carries the same flag). A state rather than an
    -- opcode: the actor op's operand is a pool slot and the player is not in
    -- the pool. Unset, the player blocks exactly as before.
    const ST_PLAYER_COLLIDE = 11
    -- WRITE-only: the player's movement speed (px per VM frame) and its
    -- animation MASK (the reference engine's anim_tick; 255 = paused, 0 = back to the
    -- clip's own period). The reference engine keeps the player at actors[0] and its
    -- vm_actor_set_move_speed / vm_actor_set_anim_tick write the field with no
    -- PLAYER fork at all, so both are ordinary actor events aimed at the
    -- player - and states here for the reason ST_PLAYER_COLLIDE is one: the
    -- actor opcode's operand is a POOL SLOT the player does not occupy.
    const ST_PLAYER_SPEED = 12
    const ST_PLAYER_ANIM_SPEED = 13
    -- WRITE-only: the reference engine's platformer BLANK state and the gravity it falls
    -- under (its `plat_blank_grav` engine field). Blank is what a PIT raises -
    -- the pad is ignored, the horizontal is zeroed, the sprite wears its HURT
    -- set and the player drops at a gravity the script chooses, which is the
    -- death fall a respawn plays before it teleports. TWO CONSECUTIVE ids, so
    -- the arm below is one range test for the pair rather than two `else if`s
    -- in resident image, and they fold away together under VM_ST_PLAYER_BLANK.
    const ST_PLAYER_BLANK = 14
    const ST_PLAYER_BLANK_GRAV = 15
    -- The follow camera's CLAMP RECTANGLE in world pixels (the reference engine's
    -- scroll_x_min / _max / scroll_y_min / _max). FOUR CONSECUTIVE ids on
    -- purpose: the arm below is one range test and one call for all of them,
    -- and they fold away together.
    const ST_CAM_MIN_X = 25
    const ST_CAM_MAX_Y = 28
    -- 8..15 are reserved core (spec 5.3); 16+ are PACK-defined. Ours:
    const ST_HELD_BASE = 16     -- read-only: 16 + button id = that button HELD (5.4)
    const ST_UI_OPEN = 24       -- read-only: 1 while a text box or menu is up
    const ST_PAD_HELD = 29      -- read-only: ALL held buttons as one bitmask
    -- WRITE-only, ONE-SHOT: arm the NEXT menu so B cancels it (the reference engine's
    -- .UI_MENU_CANCEL_B). Consumed when OP_MENU opens; a cancel writes -1 to
    -- the menu's variable. The whole arm folds away under VM_ST_MENU_CANCEL.
    const ST_MENU_CANCEL = 30
    -- WRITE-only, ONE-SHOT: hold the NEXT text box for n VM frames and close
    -- it with NO key press. The reference engine's two non-key close modes are this
    -- shape (`closeWhen: "text"` = an _overlayWait carrying no button flag
    -- then wait_frames; `notModal` leaves the box up for a later close), and
    -- the countdown runs AFTER the typewriter reveal, which is that same
    -- .UI_WAIT_TEXT-then-wait order. Consumed when OP_UI_TEXT opens. The whole
    -- arm folds away under VM_ST_BOX_HOLD.
    const ST_BOX_HOLD = 31
    -- WRITE-only, PERSISTENT: which way every later fade goes, in GB
    -- Studio's `fade_style` numbering (0 = towards white, 1 = towards
    -- black). Handed to vm.fx, which owns both ramps; the arm folds away under
    -- VM_ST_FADE_STYLE and fx's white ramp under VM_FADE_STYLE (stated by the
    -- build from this state OR a rooms.mos `[scenes] fade_style` default).
    const ST_FADE_STYLE = 32
    -- WRITE-only: restart timer v's countdown (the reference engine's `vm_timer_reset`,
    -- `remains = value`); a stopped timer stays stopped. VM_ST_TIMER_RESET.
    const ST_TIMER_RESET = 33
    -- WRITE-only, PERSISTENT: 1 hides every sprite, 0 shows them (the reference engine's
    -- `hide_sprites`, VM_HIDE_SPRITES / VM_SHOW_SPRITES). VM_ST_SPRITES_HIDDEN.
    const ST_SPRITES_HIDDEN = 34
    -- WRITE-only: 1 pauses the scene type's update (g_player: the player
    -- handler, trigger scan, entity update), 0 resumes; a scene load clears it
    -- (the reference engine's `pause_state_update`). VM_ST_SCENE_UPDATE_PAUSED.
    const ST_SCENE_UPDATE_PAUSED = 35
    -- WRITE-only: the reference engine's four EVENT_CAMERA_PROPERTY_SET fields. The DEAD
    -- ZONE is a follow tolerance in px (the camera holds still while the focus
    -- stays inside it - how a follow camera stops jittering), clamped 0..40 as
    -- its own compiler clamps it; the OFFSET shifts the followed point, so a
    -- positive x offset draws the player right of centre.
    --
    -- THEIR LIFETIMES DIFFER: the reference VM's `camera_reset()` zeroes the DEADZONES and
    -- is called from `load_scene`'s `if (init_data)`, while the offsets are
    -- written only by `camera_init`. So a dead zone is per scene and an offset
    -- is global. FOUR CONSECUTIVE ids, one range test, all folding away
    -- together under VM_CAM_PROPS.
    const ST_CAM_DEADZONE_X = 36
    const ST_CAM_OFFSET_Y = 39
    -- WRITE-only ONE-SHOT LATCH: which of the three save slots the next SAVE /
    -- LOAD / DATA_CLEAR / DATA_PEEK / ST_SAVE_EXISTS uses (W7c). The reference engine
    -- gives every one of those events its own `saveSlot` field, and this is how
    -- the value reaches ops whose operands may not change - the ST_MENU_CANCEL
    -- / ST_BOX_HOLD shape. Handed straight to vm.sram, which owns the latch and
    -- consumes it; the whole block folds away under VM_SAVE_SLOTS.
    const ST_SAVE_SLOT = 40
    -- WRITE-only, PERSISTENT: the SCANLINE at which the window OVERLAY stops
    -- (the reference engine's `overlay_cut_scanline`, W7d phase 2). At that line the
    -- window layer goes off and the sprites come back, so an overlay - the
    -- curtain, a full-width box - covers only the TOP of the screen with the
    -- room playing below it. Its default is 150, off the bottom of a 144-line
    -- screen, so a project that never writes it has no cut and pays nothing.
    -- Handed straight to the text layer, which owns the LYC stop; a no-op on
    -- every console with no GB-style window. VM_ST_OVERLAY_CUT.
    const ST_OVERLAY_CUT = 41
                                -- (bit = portable button id); one read where an
                                -- await-any-input poll used to take eight

    const OP_MENU = 0x31     -- (dest,row,count,ids...) modal choice -> heap[dest]
    const OP_HUD_SHOW = 0x32    -- (on) HUD visibility (0 hide / non-0 show)
    const OP_FADE = 0x38        -- (dir, frames) waitable fade out(0)/in(1)
    const OP_SHAKE = 0x39       -- (frames, amp) start a screen shake
    const OP_SHAKE_OPTS = 0x4C  -- (axis, wait) one-shot latch consumed by SHAKE
    -- REPLACE A BACKGROUND TILE'S DATA (the reference engine's VM_REPLACE_TILE): rewrite
    -- the 16 bytes of tile `dst` from the world's replacement bank, so every
    -- map cell holding that index redraws at once. Routed through the opt-in
    -- g_bkg_tile seam (scenes.replace_tile), so a world with no replacement
    -- bank links none of it.
    -- (layer, slot, pal) a RUNTIME palette write: library palette `pal` into
    -- hardware slot `slot` of the sprite (0) or background (1) palette table.
    -- The reference engine's EVENT_PALETTE_SET_SPRITE / _BACKGROUND / _UI / _EMOTE are
    -- all this one primitive there too (its UI palette is background slot 7,
    -- its emote palette sprite slot 7). Routed through the opt-in
    -- core.set_pal_write seam, so a game that never recolours links nothing.
    const OP_PAL_SET = 0x4F
    const OP_BKG_TILE = 0x4D    -- (dst, src) literal replacement tile
    const OP_BKG_TILE_E = 0x4E  -- (dst; pops src) the COMPUTED one -- a digit readout
    const OP_CAM_MOVE_TO = 0x3A -- (x, y, step) waitable scripted camera pan
    const OP_SHMUP_SCROLL = 0x33 -- PACK op: (pace, dir) shmup auto-scroll (pace 0 = pause; dir 2 = keep; dir 3 = endless loop)
    const OP_PLAYER_VISIBLE = 0x34 -- (on) show/hide the PLAYER's sprite (reference-engine ACTOR_FLAG_HIDDEN)
    const OP_A_VISIBLE = 0x3D      -- (i, on) the same flag on a POOL actor
    const OP_TEXT_SPEED = 0x3E  -- (speed 0-7, ff) typewriter reveal speed (0 = instant)
    const OP_TEXT_BLIP = 0x3F   -- (freq16, frames) per-char blip tone (freq 0 = off)
    const OP_SCROLL_BG = 0x3B   -- (vx, vy) generic background scroll velocity (signed 1/4-px/frame; 0,0 = stop)
    const OP_PROJ_LAUNCH = 0x60 -- (x, y, vx, vy, tile, life) fire a native projectile
    const OP_PROJ_LAUNCH_E = 0x61 -- (tile,life | pops x,y,vx,vy) fire a projectile with expr coords
    const OP_PROJ_LAUNCH_M = 0x62 -- (x,y,vx,vy,tile,life,mask) a projectile with a collision mask (F3.5)
    const OP_PROJ_LAUNCH_EM = 0x63 -- (tile,life,mask | pops x,y,vx,vy) masked + expr coords
    const OP_PROJ_LAUNCH_A = 0x64 -- (tile,life,mask | pops x,y,angle,speed) fire along an ANGLE
    const OP_PROJ_ANIM = 0x65   -- (frames, period) animate the NEXT launch (one-shot latch)
    const OP_TIMER_SET = 0x40   -- (id, period, entry) fire a thread every period
    const OP_TIMER_STOP = 0x41  -- (id) stop a timer

    const NTIMERS = 4
    const OP_INPUT_ATTACH = 0x42  -- (btn_id, entry) spawn a script on a button rising edge
    const OP_INPUT_DETACH = 0x43  -- (btn_id) remove a button attachment
    const OP_SAVE = 0x44          -- snapshot heap + engine state to battery SRAM (vm.sram)
    const OP_LOAD = 0x45          -- restore from SRAM (a no-op with no valid save)
    const OP_SET_PLAYER_HIT = 0x46 -- (entry) register the player-hit script (F3.5)
    const OP_DATA_CLEAR = 0x47    -- clear the latched save slot's signature (vm.sram)
    const OP_DATA_PEEK = 0x48     -- (src, dst) read ONE heap cell out of a slot
    const OP_MUSIC_ROUTINE = 0x49 -- (slot, entry) attach a script to a hUGE `6xy`
    -- The window OVERLAY CURTAIN (the reference engine's ui.c): a solid cover on the
    -- window layer at a tile ROW (0 = whole screen, 18 = gone), slid one
    -- row per ui_time_masks[speed]+1 frames. NOT a fade - the palettes
    -- stay bright and the scene is revealed row by row.
    const OP_OVERLAY_SHOW = 0x4A     -- (row) put the curtain there NOW
    const OP_OVERLAY_MOVE_TO = 0x4B  -- (row, speed) WAIT while it slides
    const OP_SFX = 0x50           -- (id) play a canned SFX (vm.snd -> sound.sfx)
    const OP_TONE = 0x51          -- (freq:u16, frames:u8) play a square tone (vm.snd -> sound.beep)
    const OP_SND_STOP = 0x52      -- stop the sound channel (vm.snd -> sound.stop)
    const OP_MUSIC_PLAY = 0x53    -- (entry:u16) spawn the looping SONG thread, TRACKED
    const OP_MUSIC_STOP = 0x54    -- kill the song thread + silence the music channel
    const OP_MUSIC_TONE = 0x55    -- (freq:u16, frames:u8) a tone on the MUSIC voice (own channel)
    const OP_MUSIC_SONG = 0x56    -- (song:u8) play a registered SONG through the music driver (vm.music)
    const OP_MUSIC_PAUSE = 0x57   -- pause the driven song (silence, keep position)
    const OP_MUSIC_RESUME = 0x58  -- resume a paused song
    const OP_MUSIC_MUTE = 0x59    -- (mask:u8) persistent per-channel MUSIC mute mask
    const OP_A_CLEAR_ANIM_STATE = 0x5A -- (i) release A_SET_ANIM_STATE's pin (a lodger)
    const OP_THREAD_STOP = 0x5B   -- (i) end the live thread whose join handle is heap[i]
    const OP_A_SET_BOX = 0x5C     -- (i, w, h, ox, oy) replace an actor's collision box
    const OP_A_GET_DIR = 0x5D     -- (i, v) heap[v] = actor i's facing
    const OP_A_START_UPDATE = 0x5E -- (i) start actor i's On Update if it is not running
    const NIN = 8                 -- concurrent input attachments (one per portable button)
    -- portable button ids (the bytecode carries these, NOT the per-console
    -- INPUT_* masks, so a script is portable; btn_held maps id -> the mask).
    const BTN_A = 0
    const BTN_B = 1
    const BTN_START = 2
    const BTN_SELECT = 3
    const BTN_UP = 4
    const BTN_DOWN = 5
    const BTN_LEFT = 6
    const BTN_RIGHT = 7
    const OP_A_SET_POS = 0x21
    const OP_A_MOVE_TO = 0x22
    const OP_A_SPEED = 0x23
    const OP_A_MOVE_START = 0x24  -- (i, x, y) non-blocking native move (cutscene concurrency)
    const OP_A_SET_CLIP = 0x25   -- (i, kind) assign a clip KIND (data-driven vm.anim)
    -- Expression-valued variants (the `_E` rule, spec Â§6): the position args come
    -- off the per-thread expression stack (preceding OP_RPN instrs) instead of
    -- inline literals, so a script can chase / shoot with computed coords
    -- (actor_move(self, player_x(), ...)).
    const OP_A_SET_POS_E = 0x26     -- (i | pops x,y) actor.set_pos with expr coords
    const OP_A_MOVE_START_E = 0x27  -- (i | pops x,y) non-blocking native move to expr coords
    const OP_A_DEACTIVATE = 0x28    -- (i) retire an actor (killed enemy / picked-up item)
    -- (i) bring a retired actor back IN PLACE (the reference engine's own ACTIVATE, which
    -- takes nothing but the actor). OP_A_ACTIVATE is the SPAWN form and would
    -- re-seed tile + position from literals the script cannot know.
    const OP_A_REACTIVATE = 0x1C
    const OP_A_AWAIT_MOVE = 0x1D -- (actor) WAIT until its native auto-move lands
    -- (x16, y16, mode) WAITABLE player walk -- A_MOVE_TO's player twin. The
    -- coords are u16 because the player's are WORLD pixels (a wide room walks
    -- to x = 1272, which the actor op's u8 operand cannot say). `mode` is GB
    -- Studio's moveType axis order: 0 diagonal / 1 horizontal / 2 vertical.
    const OP_PLAYER_MOVE_TO = 0x1E
    -- (mode, coll) ARM the next actor move with the reference engine's moveType +
    -- useCollisions/collideWith. A one-shot latch (the PROJ_ANIM shape), so the
    -- move ops keep their encodings and a game that never asks is unchanged.
    const OP_A_MOVE_OPTS = 0x1F
    const OP_A_SET_GROUP = 0x29     -- (i, group) set an actor's collision group / faction
    const OP_A_SET_HP = 0x2A        -- (i, hp) set an actor's HP (multi-HP foes)
    const OP_A_DAMAGE = 0x2B        -- (i, amount) subtract from an actor's HP (clamped at 0)
    const OP_A_SET_DIR = 0x2C       -- (i, dir) set an actor's facing (0 dn/1 up/2 lt/3 rt)
    const OP_A_SET_COLLISION = 0x2D -- (i, on) 1 = the actor BLOCKS the player
    -- SCRIPT-DRIVEN animation. Both write a vm.actor FIELD that vm.canim reads
    -- on its next tick, rather than calling the animator: vm.core does not
    -- import vm.canim, and a game with no animation must link none of it.
    const OP_A_SET_FRAME_E = 0x1B   -- (i | pops frame) pin a COMPUTED frame
    const OP_A_SET_FRAME = 0x2E     -- (i, frame) pin one animation frame
    const OP_A_SET_ANIM_SPEED = 0x2F -- (i, mask) the reference engine's animation-speed mask
    const OP_PLAYER_BOUNCE = 0x17   -- (h) upward impulse: 0 low / 1 medium / 2 high
    const OP_PLAYER_KNOCKBACK = 0x35 -- () throw the player away from its facing
    const OP_PROJ_GROUP = 0x36      -- (g) latch the next shot's OWN collision group
    const OP_A_SET_ANIM_STATE = 0x37 -- (i, st) pin an actor's clip STATE
    const OP_PLAYER_MOVE_TO_E = 0x3C -- (mode; pops y, x) the computed waitable walk
    -- Two ACTOR-scoped ops that could not be grouped with their siblings: the
    -- 0x2x actor group is FULL (A_SET_FRAME / A_SET_ANIM_SPEED took its last
    -- two encodings), so these sit in the 0x1x group's free space. Nothing
    -- about either is player-scoped -- the encoding is only where the room was.
    const OP_A_STOP_UPDATE = 0x18   -- (i) kill the actor's On Update thread
    const OP_A_PUSH = 0x19          -- (i, tiles) shove an actor along the player's facing
    const OP_A_EMOTE = 0x1A         -- (i, id) waitable emote bubble over an actor
    const OP_UI_TEXT = 0x30

    -- "self" actor operand (the reference engine's SELF): an actor-index operand of SELF_ACTOR
    -- resolves to the thread's BOUND actor (vm_self, set by vm.entity when it spawns
    -- an actor's On Init/Update/Interact slot script), so a PER-INSTANCE slot script
    -- addresses ITS OWN actor without hardcoding a pool index. Actor pool is 0..7,
    -- so 0xFE is a safe sentinel (a literal actor operand is always < 8).
    const SELF_ACTOR = 0xFE

    -- The PLAYER as an actor operand. The reference engine keeps the player at its
    -- actors[0] so any actor event may aim at it, and our pool has no slot for
    -- it - so the ops that CAN answer for the player take this sentinel. Only
    -- A_EMOTE reads it (the bubble hangs over the player); everything else the
    -- player needed became an engine STATE or an op of its own. An arm that
    -- does not handle it must keep resolving through resolve_actor, where
    -- 0xFF clamps to actor 0 rather than indexing past the pool arrays.
    const PLAYER_ACTOR = 0xFF

    -- contexts (struct-of-arrays)
    var vm_active: array[u8, 8]     -- 1 = allocated + running
    var vm_pc: array[u16, 8]        -- byte offset into the blob
    var vm_waiting: array[u8, 8]    -- 1 = mid-waitable (WAIT/TEXT re-entry)
    var vm_scratch: array[u16, 8]   -- per-thread waitable scratch (WAIT counter)

    var vm_lockcount: u8            -- >0 = a cutscene owns the frame
    var vm_lockowner: u8            -- the locking thread

    -- per-thread expression stack (RPN scratch), flat: thread c owns cells
    -- [c*VM_STACK .. c*VM_STACK+VM_STACK). vm_sp[c] = its depth.
    var vm_stack: array[i16, 64]    -- VM_CTXS * VM_STACK = 8 * 8
    var vm_sp: array[u8, 8]         -- u8: 64 cells, and a u8 index is one add on
                                    -- sdcc/cc65 where the u16 one was two + a carry

    -- per-thread CALL stack (return addresses), for script subroutines.
    var vm_call: array[u16, 32]     -- VM_CTXS * CALL_DEPTH = 8 * 4
    var vm_csp: array[u8, 8]

    -- per-thread BOUND actor (the SELF operand resolves to this); default 0.
    var vm_self: array[u8, 8]

    -- per-thread ARGUMENTS (THREADN loads them, the RPN ARG token reads them).
    var vm_arg: array[i16, 32]      -- VM_CTXS * NARGS = 8 * 4
    -- per-thread JOIN handle (spec Â§3/Â§11): 255, or a heap index MIRRORING this
    -- thread's liveness (HANDLE writes 1; the Â§11 death path writes 0) -- the
    -- pointer-free join: a parent polls heap[h] with no thread ids exposed.
    var vm_handle: array[u8, 8]
    -- HANDLE_NEXT one-shot latch: applied to this thread's next successful
    -- THREAD/THREADN spawn (parent watches child), then cleared.
    var vm_hnext: array[u8, 8]
    -- scratch argv for THREADN (pops happen before the child context exists)
    var argv_scratch: array[i16, 4]
    -- per-context SPAWN GENERATION: bumped by every spawn() that lands in the
    -- context, so a module holding a thread handle can tell "the thread I
    -- spawned" from "an unrelated thread the pool put in the same slot after
    -- mine ended" (kill_gen below). A u8 wrap needs 256 reuses of one context
    -- between the stale kill and the spawn it stamped - not reachable inside
    -- one room.
    var vm_gen: array[u8, 8]

    var cur: u8                     -- the thread step() is executing (for f8/f16)
    -- 1 while run_context has a slice LIVE for `cur` (its pc/sp are in the
    -- registers below). alloc_ctx never hands out `cur` while this is set:
    -- an op that kills its own thread and then spawns (MUSIC_PLAY from the
    -- song thread, A_STOP_UPDATE from the On Update thread it stops) used to
    -- get `cur` back from the pool -- spawn wrote the child's entry into
    -- vm_pc[cur], the slice kept running on pcr, and run_context's write-back
    -- then overwrote the child's entry with the dead thread's pc. The child
    -- never ran and the dead thread ran on.
    var slice_live: u8

    -- ---- THE SLICE REGISTERS (the interpreter's hot state) ----
    -- `vm_pc[cur]` / `vm_sp[cur]` are read AND written for every single byte the
    -- decoder fetches and every RPN token it evaluates, and an ARRAY element
    -- indexed by a variable is the most expensive thing an 8-bit C compiler can
    -- be asked for: cc65 recomputed `&vm_pc[cur]` (load cur, 16-bit shift, add
    -- the base, call a deref helper) TWICE per fetched byte -- once to read the
    -- PC and once to increment it -- and sdcc is no better. Measured on the
    -- Lynx, one `f8()` cost ~2,577 ticks, of which the two address computations
    -- were the bulk; the whole interpreter was ~60% of a VM frame.
    --
    -- So `run_context` LOADS the running thread's pc/sp into plain module-scope
    -- scalars for the duration of its slice and STORES them back before it
    -- returns. A scalar is a fixed absolute address: the read is `LDA pcr` and
    -- the bump an `INC`. Nothing else changes -- the arrays remain the truth
    -- between slices.
    --
    -- THE INVARIANT, and it is the whole safety argument: while a slice runs,
    -- `pcr`/`spr` are authoritative for thread `cur` and `vm_pc[cur]`/
    -- `vm_sp[cur]` are STALE. So every site that touches the CURRENT thread's
    -- pc or sp must use the register (all of `step` and `rpn_eval` do -- they
    -- only ever run under a slice), and every site that touches ANOTHER
    -- thread's -- `boot`, `spawn`, `kill` -- must use the array. spawn() always
    -- allocates a context that is not `cur` (cur is active), so the two never
    -- alias. run_context writes back on EVERY return path, including the
    -- thread-death one.
    var pcr: u16                    -- the running thread's PC
    var spr: u8                     -- ...its expression-stack depth (0..VM_STACK)
    var sbase: u8                   -- ...and its stack's base cell (cur * VM_STACK),
                                    -- so vpush/vpop need no multiply either

    -- game heap (variables). i16 cells (VM_HEAP of them); the SAVE payload.
    -- NOT cleared by boot (spec Â§4): zero-initialized once at program start
    -- (BSS) and it survives a re-boot / RESET exception.
    var heap: array[i16, 128]

    -- game callbacks (mosaik has no pointers -- the blob + strings are game data)
    var g_fetch: function(u16) -> u8    -- read bytecode byte at offset
    -- THE CODE WINDOW (review V-5): when the shell registers one, every byte
    -- the interpreter fetches INSIDE a slice is a plain inline read at
    -- code_base + pc (hw.peek) instead of a call through g_fetch into the
    -- generated fetch into the blob - and where the blob lives in a switchable
    -- ROM bank, the bank is mapped ONCE per slice (g_code_enter, which hands
    -- back the bank to restore) rather than saved, switched and restored per
    -- byte. Everything outside a slice (the menu's option ids) keeps g_fetch.
    -- Unregistered, the interpreter is unchanged.
    var code_base: addr
    var g_code_enter: function() -> u8
    var g_code_leave: function(u8)
    var has_code_window: u8
    -- 1 = the blob lives in a switchable ROM bank and every slice must map it
    -- (the enter/leave pair); 0 = the blob is RESIDENT and the pair is
    -- skipped (review V-5's last item, 2026-09-03). A resident blob's
    -- enter/leave were already no-ops in the generated scripts module
    -- (`assets.bank_enter` of a resident symbol lowers to 0) - but two seam
    -- calls a slice to do nothing, measured ~620 T-cycles on the sm83, a
    -- fifth of a one-instruction WAIT slice.
    var code_banked: u8
    var g_text: function(u8)            -- render string id into the text box

    -- optional native per-scene player handler (vm.player). Runs every UNLOCKED
    -- frame (a cutscene lock freezes it); movement/collision
    -- stay native, scripts only orchestrate.
    var g_player: function()
    var has_player: u8
    -- The LOCKED-frame / box-snap player DRAW (vm.player.draw). A SEAM, not a
    -- direct call, for the reason set_ui_freeze spells out: a direct
    -- `player.draw()` here made `follow_and_render` and its whole chain
    -- (put_player, focus_x/y, clamp_bound, room_maxy, calc_wide_cam,
    -- camera.axis/follow) reachable from core.run in EVERY project - so a
    -- game with no player at all linked ~1.2 KB of player camera code it can
    -- never run (measured on the falling-block assembly sample, whose Lynx MAIN it pushed
    -- 779 B over). Registered by set_player, which only a player game calls,
    -- so it moves in lockstep with has_player and a player-less project links
    -- nothing.
    var g_pdraw: function()
    -- opt-in UI freeze (see set_ui_freeze): 1 while a box/menu owns the screen
    var g_ui_freeze: function(u8)
    var has_ui_freeze: u8
    -- opt-in CONSUMED-BUTTON mask (see set_input_consume): the buttons an
    -- overriding input attachment has taken away from the player handler.
    -- Pushed only when the set CHANGES (attach / detach / scene reset), never
    -- per frame.
    var g_consume: function(u8)
    var has_consume: u8
    -- opt-in player VISIBILITY (see set_player_vis): PLAYER_VISIBLE's target.
    var g_pvis: function(u8)
    var has_pvis: u8
    -- TYPEWRITER text reveal (TEXT_SPEED / TEXT_BLIP + the set_text_step
    -- seam) - the reference engine's text_draw_speed model: one printable char whenever
    -- `frame & mask == 0`, counted in DISPLAY frames (its game_time; the
    -- ui_time_masks table is {0,0,1,3,7,15,31,63} and the mask is derived
    -- when the op runs, never stored as a resident const table). All state
    -- is BSS and every reader folds away with the two op defines, so a
    -- program that never sets a speed is byte-identical and draws whole
    -- boxes through g_text as it always did.
    var tw_idx: u8              -- speed index 0..7 (0 = instant, the default)
    var tw_mask: u8             -- ui_time_masks[tw_idx], derived in the op arm
    var tw_ff_ok: u8            -- 1 = A/B held fast-forwards the reveal
    var tw_run: u8              -- 1 = the OPEN box is still revealing
    var tw_pos: u8              -- printable chars already plotted
    var tw_frame: u8            -- the reveal's own frame counter (game_time)
    var tw_last: u16            -- last system.frames() sample (elapsed clock)
    var blip_freq: u16          -- TEXT_BLIP: tone per reveal step (0 = off)
    var blip_len: u8            -- ... and its length in frames
    -- draw printable chars [from, upto) of string `id`, return how many were
    -- plotted - the generated scripts.render_text_step, registered only when
    -- the program sets a text speed (the set_save wiring pattern).
    var g_tstep: function(u8, u8, u8) -> u8
    var has_tstep: u8
    -- the atan2 RPN token's implementation (see set_atan2)
    var g_atan2: function(i16, i16) -> u8
    var has_atan2: u8

    -- The ONE exception mechanism (spec Â§10): RAISE records (code, a, b, c) and
    -- ends the raising thread; run() services it between script and player
    -- steps. Codes: 1 RESET, 2 CHANGE_SCENE (through the game's ONE scene-load
    -- callback: paint + reposition + respawn), 3 LOAD_COMPLETE. Only one can be
    -- pending; a later RAISE in the same frame overwrites (last-writer-wins).
    var g_change: function(u8, u16, u16)
    var has_change: u8
    var pend_code: u8
    -- AUTO-FADE OUT (studio.toml [scenes] fade, registered by set_fade): LCD
    -- frames held per darkness step while the OUTGOING room ramps to black.
    -- 0 = the historical hard cut, byte-identical.
    var fade_hold: u8

    -- OPTIONAL "redraw the background" callback (the shell wraps scenes.paint of the
    -- current room). On the GB family + SMS/GG the dialogue text is plotted INTO the
    -- bkg tilemap, so closing a box (clear_area writes spaces) leaves a blank band
    -- where the room tiles were -- visible on a room bigger than the screen. When
    -- registered, core repaints the background after a box/menu closes so the room
    -- shows through again. Unregistered = the old clear-only behaviour (fine for a
    -- room SMALLER than the screen, where the box sits below the map).
    var g_redraw: function()
    var has_redraw: u8
    -- ...and its column-SLICED form, used by the staged close on SMS/GG (see
    -- ui_stage). Registered by the same generated block as g_redraw, so a shell
    -- that wires one wires both; unregistered, the close falls back to the one
    -- big g_redraw and behaves exactly as it did.
    var g_redraw_cols: function(u8, u8)
    var has_redraw_cols: u8
    -- ...and its ROW-BAND form, which is what a box close actually needs. A box
    -- damages `box_h` ROWS of the ring, so the column walk repaints 32x28 cells
    -- to undo 32x3 - measured on vm-uiscroll's Game Gear teardown at 43 display
    -- frames, of which the per-cell writes alone are 24. Registered beside the
    -- other two; unregistered, the close falls back to the column walk and
    -- behaves exactly as it did.
    var g_redraw_rows: function(u8, u8)
    var has_redraw_rows: u8
    -- OPTIONAL data-driven actor animation hook (actor.animate). Registered by a
    -- game with [animations] (the generated shell calls set_anim); run() drives it
    -- each frame. Unset, engine.anim is never referenced -> zero cost for a
    -- non-animating VM game (the byte-identical-when-absent rule).
    var g_anim: function()
    var has_anim: u8
    -- OPTIONAL background tile-animation hook (scenes.anim_tick, the reference-engine
    -- animate-background-tiles trick). Registered by a game whose world has
    -- [[animated_tile]] (the generated rooms.mos calls set_bkg_anim); run() fires
    -- it each frame BEFORE present so the timed bkg.set_data lands before the
    -- recompose. A SEPARATE slot from g_anim because a game can have BOTH actor
    -- clips and animated bkg tiles. Unset -> scenes.anim_tick is never referenced
    -- (zero cost, byte-identical for a world without animated tiles).
    var g_bkg_anim: function()
    var has_bkg_anim: u8
    -- OPTIONAL background tile REPLACEMENT hook (scenes.replace_tile, the reference engine's
    -- VM_REPLACE_TILE). Registered by a game whose world declares a replacement
    -- tile bank (the generated rooms.mos calls set_bkg_tile); the BKG_TILE ops
    -- route through it. Takes the ROOM as well as (dst, src) because on SMS/GG a
    -- tile's pixels carry its palette, so the writer has to look the destination
    -- cell's slot up in that scene's per-tile table - exactly what the animated
    -- tile path does. Unset -> the ops are no-ops and scenes.replace_tile (and its
    -- tile bank) is never referenced.
    var g_bkg_tile: function(u8, u8, u8)
    var has_bkg_tile: u8
    -- The RUNTIME palette write (OP_PAL_SET): the generated scenes module owns
    -- the [[palette]] library table, so the writer is a callback, exactly as
    -- the replacement-tile writer above is.
    var g_pal_write: function(u8, u8, u8)
    var has_pal_write: u8
    -- OPTIONAL generated-HUD hooks (src/hud.mos, the studio HUD editor). Registered
    -- by a game that authored an overlay PANEL (set_hud). TWO callbacks because the
    -- HUD renders differently per display model:
    --   * g_hud_update (hud.update): a DIFF redraw (only fields whose heap cell
    --     changed). Run each frame in the MAIN LOOP on a persistent-tilemap console
    --     (GB window map / SMS-GG name table), where a once-drawn HUD stays put.
    --   * g_hud_draw (hud.draw): a FULL redraw of the whole panel. Run inside the
    --     PRESENT hook (draw_open_ui) on the double-buffered Lynx, where every
    --     present recomposites the framebuffer and would otherwise wipe the HUD
    --     (the same reason boxes/menus redraw there).
    -- Unset, vm.hud is never referenced -> zero cost for a HUD-less VM game.
    var g_hud_update: function()
    var g_hud_draw: function()
    var has_hud: u8
    -- The HUD's re-show hook (`set_hud_show`, the generated hud.reshow): on
    -- the GB family the HUD band IS the window, which a text box / menu
    -- borrows and `text.to_bkg()` hides on close, and a room change hides
    -- too. With the hook registered (VM_HUD_RESHOW, stated by the build off
    -- the shell's call) every such close re-raises the band, and HUD_SHOW
    -- 1 / 0 raises / hides it. BSS only; the call sites fold away off.
    var g_hud_show: function()
    var has_hud_show: u8
    var hud_visible: u8 = 1         -- HUD_SHOW op: 0 hides a registered HUD
    var pend_a: u8                  -- exception parameters (room for codes 2/3)
    var pend_b: u16
    var pend_c: u16
    var boot_entry: u16             -- the boot entry offset (EX_RESET restarts here)
    var cur_scene: u8               -- the current room (ST_SCENE read; set on change)
    -- The ST_GAME_TIME clock: a free-running VM-frame counter, wrapping at 16
    -- bits exactly as the reference engine's sys_time does (a rate limit's compare relies
    -- on the wrap). Kept ONLY when the program's blob reads the state -
    -- run()'s increment is folded away otherwise, so every game that does not
    -- rate-limit is byte-identical. No `= 0`: BSS is free, an initialised
    -- global is resident image.
    var vm_time: u16

    -- projectile pack (vm.projectile) -- OPT-IN so a game that fires no shots does
    -- not link its pool (tight-target gating). A shell
    -- that wants projectiles imports vm.projectile + core.set_projectiles(...); the
    -- PROJ_LAUNCH op + the per-frame update/render route through these callbacks
    -- (a no-op when unregistered).
    -- OP_A_STOP_UPDATE's route into vm.entity (which owns the per-actor On
    -- Update thread handle). A seam rather than an import for the same reason
    -- the projectile pack is one: an unregistered seam links zero code.
    var g_stop_update: function(u8)
    var has_stop_update: u8
    -- ...and OP_A_START_UPDATE's (the same seam shape).
    var g_start_update: function(u8)
    var has_start_update: u8
    -- The scene-update pause (state 35), declared inside its fold likewise.
    if VM_ST_SCENE_UPDATE_PAUSED {
        var scene_paused: u8
    }

    -- OP_A_EMOTE's route into vm.emote (the emote-bubble pack). Three calls
    -- because the op both STARTS the bubble and waits on it, and the bubble has
    -- to follow its actor every frame. Unregistered, the op is a no-op and none
    -- of the pack links.
    var g_emote_show: function(u8, u8)
    var g_emote_active: function() -> u8
    var g_emote_update: function()
    var has_emote: u8

    var g_proj_launch: function(i16, i16, i16, i16, u8, u16, u8)   -- +collision mask (F3.5)
    -- The ANGLE launcher (vm.projectile.launch_angle), its own seam because
    -- set_projectiles' three-callback shape is what every hand-written shell
    -- already calls. Registered by the generated rooms.mos only when a script
    -- fires at an angle; unregistered, OP_PROJ_LAUNCH_A is an honest no-op.
    var g_proj_angle: function(i16, i16, u8, i16, u8, u16, u8)
    var has_proj_angle: u8
    -- the flight-animation latch (vm.projectile.set_anim, wired by rooms.mos
    -- only when a script's launch carries `frames`); unregistered, OP_PROJ_ANIM
    -- is an honest no-op and the launch stays a static tile.
    var g_proj_anim: function(u8, u8, u8)
    var has_proj_anim: u8
    -- the shot's own collision GROUP latch (vm.projectile.set_group, wired by
    -- rooms.mos beside the animation one); unregistered, OP_PROJ_GROUP is an
    -- honest no-op and a shot arrives ungrouped.
    var g_proj_group: function(u8)
    var has_proj_group: u8
    var g_proj_update: function()
    var g_proj_render: function()
    var has_proj: u8
    -- The default projectile collision mask (F3.5): hit every enemy group, NOT the
    -- player (bit 0). The compact PROJ_LAUNCH/_E ops pass this, so a default-mask shot
    -- is byte-identical + reproduces F3's "hit any enemy". Lockstep with events.py.
    const MASK_DEFAULT = 0xFE
    -- Player-hit script (F3.5): a scene registers (via the set_player_hit event) a
    -- script run when a projectile masking the player strikes it. vm.projectile calls
    -- fire_player_hit() through its set_player_hit seam. Cleared on a scene change.
    var player_hit_entry: u16 = 0xFFFF
    var has_player_hit: u8
    -- W7h - THE hUGE `6xy` CALL-ROUTINE SLOTS (the reference engine's music_events[4]).
    -- A `6xy` cell in a hUGE module runs a script: the driver calls a thunk
    -- from its TIMER INTERRUPT, the thunk queues the effect's parameter byte,
    -- and the MAIN LOOP drains the queue and spawns. Splitting it that way is
    -- the reference's own design (`music_manager.c`: `hUGETrackerRoutine`
    -- enqueues, `music_events_update` drains from `core.c`'s loop) and it is
    -- not a style choice - our music tick IS an interrupt (_wants_music_isr),
    -- and a script may not be spawned from one.
    --
    -- The QUEUE lives on the C side, with the thunk that fills it, because
    -- only C can take a CRITICAL section around a ring an interrupt writes;
    -- `g_mrt` is the seam that hands the next byte over (0xFFFF = empty).
    -- Everything here folds away unless the blob carries OP_MUSIC_ROUTINE.
    var music_rt_entry: array[u16, 4]
    -- ATTACHED-ness is a BITMASK, not a 0xFFFF sentinel in the entry array: an
    -- initialized global costs resident image and BSS is free, and script
    -- entry 0 is a legal address (it is usually the boot script). Cleared on a
    -- scene change, as the reference VM clears music_events there.
    var music_rt_on: u8
    var music_rt_ctx: array[u8, 4]
    var music_rt_gen: array[u8, 4]
    var g_mrt: function() -> u16
    var has_mrt: u8
    -- The overlay CURTAIN seam (vm.fx.overlay): op 0 = put it at row `a`,
    -- op 1 = step one frame toward row `a` at speed `b`, 1 = arrived. ONE
    -- entry point rather than three, so the interpreter spends one resident
    -- pointer; the loop-shaped body lives in the (banking) pack, the rule
    -- actor_push documents. Unregistered the ops are skipped, so a game that
    -- never raises a curtain is byte-identical.
    var g_overlay: function(u8, u8, u8) -> u8
    var has_overlay: u8

    -- persistent-save pack (vm.sram) -- OPT-IN so a game with no save links no
    -- battery-SRAM code (and stays byte-identical). A shell that wants save/continue
    -- imports vm.sram + core.set_save(persist, restore, has); the SAVE/LOAD ops +
    -- the ST_SAVE_EXISTS read route through these callbacks (a no-op unregistered).
    -- vm.sram reads/writes the heap (var_get/var_set) + scene() + vm.player pos.
    var g_save_persist: function()
    var g_save_restore: function()
    var g_save_has: function() -> u8
    var has_save_pack: u8

    -- SAVE SLOTS (W7c), an ADDITIVE second seam rather than a wider first one.
    -- `set_save` keeps its three arguments, so every shell and every generated
    -- rooms.mos that registers a save today is untouched; a project that uses
    -- more than slot 0 registers these three as well. All of it - the globals,
    -- the setter body, the SET_STATE arm and the two op arms - folds away under
    -- VM_SAVE_SLOTS, which the build states from the blob (the `save_slot`
    -- state OR either new opcode), so a slot-0-only project is byte-identical.
    --
    -- The LATCH ITSELF LIVES IN vm.sram, not here: persist / restore / has_save
    -- need it too and their signatures may not change, so the slot is pushed to
    -- the pack the moment a script writes it and the pack consumes it when the
    -- operation runs.
    if VM_SAVE_SLOTS {
        var g_save_slot: function(u8)
        var g_save_clear: function()
        var g_save_peek: function(u8, u8)
        var has_save_slots: u8
    }

    -- sound pack (vm.snd) -- OPT-IN so a game that plays no sound links no audio
    -- code (byte-identical). A shell that wants sound
    -- imports vm.snd + core.set_sound(snd.sfx, snd.tone, snd.stop); the SFX / TONE /
    -- SND_STOP ops route through these (a no-op unregistered). vm.snd wraps
    -- platform.sound (one square-wave channel on every console).
    var g_sfx: function(u8)
    var g_tone: function(u16, u8)
    var g_snd_stop: function()
    var has_snd: u8
    -- the OPT-IN 2nd (MUSIC) voice: a tone on its own hardware channel so music
    -- coexists with SFX (audio plan Stage 3/4b). Registered via set_music_voice
    -- (a game without music links no 2nd-channel code). MUSIC_TONE routes here, and
    -- MUSIC_STOP silences THIS channel (not the SFX one).
    var g_mtone: function(u16, u8)
    var g_mstop: function()
    var has_mvoice: u8
    -- the OPT-IN multi-channel MUSIC DRIVER (audio plan Stage 4b): a real chip driver
    -- (vm.music) that sequences a SONG from DATA across several channels, ticked every
    -- frame. Registered via set_music_driver; MUSIC_SONG plays a song by index and
    -- MUSIC_STOP also stops the driver. Unregistered -> no driver code linked.
    var g_music_song: function(u8)
    var g_music_update: function()
    -- The display-frame counter at the last music tick, and the ceiling on how
    -- many ticks one game frame may catch up. 8 is ~130 ms of song: past that
    -- something blocked (a room load, a long text box) and replaying it would
    -- fast-forward rather than keep time. BSS, so it costs no resident image.
    var m_last_frame: u8
    const MUSIC_CATCHUP_MAX: u8 = 8
    var g_music_drv_stop: function()
    var has_music_drv: u8
    -- PUMP the driven song from inside a LONG BLOCKING operation - a room load,
    -- a streamer refill, a box-close repaint. Those all run inside ONE VM frame,
    -- and the driver is otherwise advanced only by run()'s per-frame arm, so the
    -- song simply STOPS for their duration: the reported "vm.music stops when a
    -- new scene loads, and when a dialogue box is cleared". hUGEDriver does not
    -- have this because its tick is a 64 Hz timer INTERRUPT and its per-frame
    -- seam call is deliberately empty; this is the main-loop equivalent, with no
    -- re-entrancy at all because a pump runs where the driver already runs.
    --
    -- The FLOOR is what makes this different from run()'s arm, not the catch-up:
    -- there, a game frame faster than the display counter still owes one tick,
    -- so a zero delta ticks once. A pump may be called SEVERAL TIMES inside one
    -- display frame, so the same floor would run the song fast. It ticks only
    -- genuinely elapsed frames and is a no-op otherwise.
    --
    -- The arithmetic is deliberately DUPLICATED from run()'s arm rather than
    -- shared: `run` is `bank(0)`-pinned and this is not, so factoring them into
    -- one helper would put a cross-bank trampoline on the per-frame path - the
    -- regression `interact_pressed` already cost once (the code-banking
    -- rule). Keep the two in step.
    function music_pump() {
        if VM_MUSIC_ISR {
            -- 6.6 stage 2: the pump is UNCHANGED in spirit - it still advances
            -- the song from the main loop at every splittable phase of a room
            -- load - but the pacing lives in the prelude now, shared with the
            -- watchdog interrupt that covers the one unsplittable call (the
            -- streamer's refill) this could never reach.
            if has_music_drv == 1 {
                system.music_tick()
            }
        } else {
            if has_music_drv == 0 {
                return
            }
            var fnow: u8 = system.frames()
            var fd: u8 = fnow - m_last_frame
            m_last_frame = fnow
            if fd > MUSIC_CATCHUP_MAX {
                fd = MUSIC_CATCHUP_MAX
            }
            while fd > 0 {
                g_music_update()
                fd = fd - 1
            }
        }
    }

    -- OPT-IN music TRANSPORT (pause / resume / per-channel mute), registered via
    -- set_music_ctl. Unwired -> MUSIC_PAUSE/RESUME/MUTE are no-ops (byte-identical).
    var g_music_pause: function()
    var g_music_resume: function()
    var g_music_mute: function(u8)
    var has_music_ctl: u8
    -- minimal MUSIC: a "song" is a LOOPING script of tones; MUSIC_PLAY spawns it
    -- as the EXEMPT context (spec Â§3/Â§8.2) so MUSIC_STOP can kill it instantly
    -- AND it keeps running under a cutscene lock (cutscene music never hangs on
    -- its last tone). 255 = no exempt thread. (A song script MUST loop -- a
    -- non-looping one that ends frees its context; the Â§11 death path clears
    -- exempt_ctx so a reused context is never mistaken for it.)
    var exempt_ctx: u8 = 255

    -- modal choice menu (OP_MENU): option rendering is game data, so the game
    -- provides a per-option renderer g_menu(string_id, row, selected). The menu
    -- mechanics (cursor/nav/confirm) reuse engine.menu; only re-render on change.
    var g_menu: function(u8, u8, u8)
    var has_menu: u8
    var menu_open: u8
    var menu_last: u8 = 255
    -- open-menu geometry (re-drawn each frame after present, like the textbox, so a
    -- menu survives the double-buffered Lynx recomposite): the row, the option
    -- count, and the bytecode offset of the first option id (read back via g_fetch).
    var menu_row: u8
    var menu_count: u8
    var menu_ids: u16
    -- B-cancel (ST_MENU_CANCEL): the one-shot latch a script arms before its
    -- MENU, the copy the OPEN menu took of it, and the B held-last-frame latch
    -- for the cancel edge (armed like menu.arm(): the B that opened a box must
    -- release first). All three fold away under VM_ST_MENU_CANCEL.
    var menu_cancel: u8
    var menu_cancel_live: u8
    var menu_prev_b: u8

    -- Timed box (ST_BOX_HOLD): the one-shot latch a script arms before its
    -- text box, and the countdown the OPEN box took of it. Both fold away
    -- under VM_ST_BOX_HOLD.
    var box_hold: u8
    var box_hold_live: u8

    -- timer contexts: fire a thread at `entry` every `period` frames.
    var tmr_active: array[u8, 4]
    var tmr_period: array[u16, 4]
    var tmr_count: array[u16, 4]
    var tmr_entry: array[u16, 4]

    -- input attachments: spawn a script when a button crosses a rising edge.
    var in_active: array[u8, 8]
    var in_btn: array[u8, 8]        -- BTN_* id
    var in_entry: array[u16, 8]
    var in_prev: array[u8, 8]       -- was-held-last-frame latch (rising edge)
    -- OVERRIDE (the reference engine's `input_slots[i] & 0x80`, events.c): an overriding
    -- attachment CONSUMES its button, so the native player handler never sees
    -- it. Its events_update() clears the bit out of `joy` and runs BEFORE
    -- state_update(), which is the only reason a menu cursor built on the
    -- PLAYER does not also walk on the held d-pad. We publish the consumed set
    -- as a bitmask through the set_input_consume seam instead, so vm.player
    -- stays decoupled and an unregistered seam is byte-identical.
    var in_over: array[u8, 8]       -- per-slot override flag
    var in_consume: u8              -- bit b = button b is consumed

    -- THE BUSY GATE (the reference engine's SCRIPT_TERMINATED check, events.c): a timer
    -- tick / button press fires NOTHING while the instance it last spawned is
    -- still running. Without it a 30-frame timer whose script runs for seconds
    -- piles up concurrent instances (the shooter conversion's falling-hazard flow spawned a new
    -- hazard thread every 30 frames), and holding A over an input script with
    -- a cooldown `wait` autofires straight through the cooldown. Each slot
    -- remembers the SPAWNED CONTEXT (255 = none); the central thread-death
    -- path releases it (event_release), so a recycled context index can never
    -- be mistaken for a still-running instance. Initialised to 255 in boot()
    -- (an initialiser here would cost resident bank-0 image).
    var tmr_ctx: array[u8, 4]
    var in_ctx: array[u8, 8]

    -- Map a portable BTN_* id to the target's NATIVE input mask, so the mask we
    -- publish can be AND-ed straight against what vm.player already passes to
    -- input.held (one AND on its hot path instead of an id translation per
    -- read). A console that lacks the button defines its INPUT_* as 0, which
    -- masks nothing - the honest answer for a button that cannot be pressed.
    local function btn_mask(id: u8) -> u8 {
        if id == BTN_A {
            return INPUT_A
        } else if id == BTN_B {
            return INPUT_B
        } else if id == BTN_START {
            return INPUT_START
        } else if id == BTN_SELECT {
            return INPUT_SELECT
        } else if id == BTN_UP {
            return INPUT_UP
        } else if id == BTN_DOWN {
            return INPUT_DOWN
        } else if id == BTN_LEFT {
            return INPUT_LEFT
        } else if id == BTN_RIGHT {
            return INPUT_RIGHT
        }
        return 0
    }

    -- Recompute the consumed-button mask and push it at the player pack. Called
    -- from the three sites that can change it (attach, detach, reset_scene_ui),
    -- so the per-frame cost is zero.
    local function publish_consume() {
        var m: u8 = 0
        for i in 0..NIN {
            if in_active[i] == 1 {
                if in_over[i] == 1 {
                    m = m | btn_mask(in_btn[i])
                }
            }
        }
        in_consume = m
        if has_consume == 1 {
            g_consume(m)
        }
    }

    -- Release any timer / input slot whose last spawned instance is thread `c`
    -- (it just died). Called from BOTH death sites - run_context's central
    -- ST_END path and kill() - the same rule as the lock/UI releases there.
    bank(0) local function event_release(c: u8) {
        for i in 0..NTIMERS {
            if tmr_ctx[i] == c {
                tmr_ctx[i] = 255
            }
        }
        for i in 0..NIN {
            if in_ctx[i] == c {
                in_ctx[i] = 255
            }
        }
    }

    -- textbox + input-edge state
    var box_open: u8
    var box_id: u8              -- the open box's string id (re-drawn each frame)
    var prev_a: u8
    var a_edge: u8
    -- UI OWNER latch: the box/menu globals above are single, so two threads both
    -- opening a box/menu in the same window would clobber each other's id/geometry
    -- and a single A-dismiss would close both. `ui_owner` is the context that owns
    -- the open UI (255 = free); a SECOND thread hitting UI_TEXT/UI_MENU while the UI
    -- is owned by another thread YIELDS and retries next frame, so concurrent boxes
    -- serialize. Single-UI-at-a-time (the common case) is unaffected (owner goes
    -- 255 -> c -> 255, the busy check never trips).
    var ui_owner: u8 = 255
    -- Lynx box/menu redraw countdown. The double-buffered Lynx present wipes a
    -- box/menu for the ~2 frames it recomposites after a change, so it must be
    -- re-drawn to seed BOTH flip buffers; but once static the present-skip holds
    -- the box, and re-plotting a FRAMED box every frame then TEARS its border each
    -- frame = a per-cell shimmer. So redraw only for a few frames after a CHANGE
    -- (open / dismiss / cursor move), then stop and let the present-skip hold it.
    -- Set on every change, counted down in run()'s post-present block (Lynx only).
    var ui_redraw: u8

    -- OPTIONAL framed text/menu boxes (engine.box's portable 9-slice over the text
    -- layer). This is an OPT-IN PACK: vm.core does
    -- NOT import engine.box, so a game that never frames a box never links it (the
    -- ~1 KB draw_frame CODE stays off the tight Lynx MAIN). A shell that wants
    -- framed boxes imports engine.box + core.set_box(box.draw_box); UI_TEXT/MENU
    -- then draw the frame through g_box_draw. Unregistered (box_framed = 0, the
    -- default) is the plain box, byte-behaviour-identical. The custom FONT is
    -- orthogonal (the shell calls text.set_font at boot); both DEGRADE GRACEFULLY --
    -- draw_box is a no-op on the NES and text.set_font is a no-op on Lynx/PCE/NES
    -- (they keep the built-in font), so a framed/custom-font game still builds there.
    var box_framed: u8
    var g_box_draw: function(u8, u8, u8, u8)    -- engine.box.draw_box, when registered
    const BOX_COL = 1           -- a bottom text box; the row is SCREEN_ROWS-relative
    const BOX_ROW = SCREEN_ROWS - 4   -- so it sits at the bottom on EVERY console
    const BOX_H = 4                   -- (row 14 on the 18-row GB; row 8 on the 12-row Lynx)

    -- ---- DIALOGUE BOX GEOMETRY (the reference engine's model) ----
    -- The box is BOTTOM-ANCHORED and CORE owns every number: the generated
    -- render_text asks for the text origin (box_left/box_top) rather than
    -- computing rows itself, so the frame and the text can never disagree.
    -- Both knobs are opt-in and default to the historical box exactly:
    --
    --  * set_box_metrics(col, w) -- the box's COLUMN span. Default 1 /
    --    SCREEN_COLS-2 (an inset box, text at col 2). The reference engine spans the FULL
    --    width (0 / SCREEN_COLS, text at col 1) so nothing of the scene shows
    --    beside the box; that is what an import registers.
    --  * set_text_lines(cb) -- how many LINES string `id` holds, so the box can
    --    be `lines + 2` rows tall like the reference engine's (border + text + border).
    --    Unregistered it stays the fixed BOX_H, which is what every text of up
    --    to 2 lines already got; a 3-LINE text then had nowhere to put its
    --    bottom border and overwrote it (the reported "text does not fit").
    var box_col: u8 = BOX_COL
    var box_w: u8 = SCREEN_COLS - 2
    var box_h: u8 = BOX_H               -- the OPEN box's height, in rows
    var g_tlines: function(u8) -> u8    -- scripts.text_lines, when registered
    var has_tlines: u8

    function set_box_metrics(col: u8, w: u8) {
        box_col = col
        box_w = w
        if VM_NO_VIEW {
        } else {
            box_w0 = w
        }
    }

    -- THE LETTERBOX VIEW (`studio.toml [scenes] letterbox`). On a console
    -- whose screen is bigger than the room (the SMS's 32x24 cells, the PC
    -- Engine's 32x28), the generated rooms module centres the room with
    -- video.set_view and tells core the room's VISIBLE size here, so the box
    -- anchors to the room's bottom edge and spans at most its width instead
    -- of opening in the margin below it. Everything else already lives in
    -- room-view space: the prelude adds the offset at the scroll commit and
    -- at every sprite placement. `box_w0` keeps the AUTHORED width (a
    -- full-width box is SCREEN_COLS) so each room clamps from it afresh.
    -- Folded on VM_NO_VIEW (true unless rooms calls core.set_view), and both
    -- cells are BSS, so a project without the knob pays nothing.
    var view_rows: u8
    var box_w0: u8

    function set_view(cols: u8, rows: u8) {
        if box_w0 == 0 {
            box_w0 = box_w
        }
        view_rows = rows
        var w: u8 = box_w0
        if box_col + w > cols {
            w = cols - box_col
        }
        box_w = w
    }

    function set_text_lines(cb: function(u8) -> u8) {
        g_tlines = cb
        has_tlines = 1
    }

    -- OPT-IN: while a box/menu owns the window overlay, keep SPRITES off it.
    -- OBJ draws above the window on GB hardware, so an actor standing low in
    -- the room shows through an open box (measured: the player's lower objects
    -- intruded 4 px). The reference engine cuts them with an LCD interrupt at the window's
    -- first scanline; text.win_sprite_cut is that. Kept to the BOX rather than
    -- to text.to_window, because a persistent overlay HUD wants its actors
    -- visible - the reference engine draws the same distinction (show_actors_on_overlay).
    var box_cut: u8

    function set_box_cut(on: u8) {
        box_cut = on
    }

    -- The dialogue box's MINIMUM height in rows (the reference engine's per-text
    -- `minHeight`). 0 = no floor, which is the historical behaviour and what
    -- a hand-authored game keeps byte-identically.
    --
    -- The reference engine sizes a box `max(minHeight, min(maxHeight, min(lines,
    -- textHeight) + textY + showFrame))` (`shared/lib/helpers/dialogue.ts`),
    -- and its own DEFAULT minHeight is 4 - so its one-line box is four rows
    -- where `lines + 2` gives three, and the platformer conversion authors 5 on every box, so its
    -- two-line boxes are five where ours gave four. The box is
    -- BOTTOM-anchored, so a box one row too short puts its text one row too
    -- LOW: measured against the reference ROM, our narration sat 8 px below
    -- it (reported from play 2026-08-22).
    --
    -- A per-PROJECT floor rather than a per-string height: `minHeight` is
    -- authored per text event but is a project style in practice (every box of the platformer
    -- conversion but one debug box says 5), and a floor needs one byte of state and
    -- one compare where a per-string height needs a second table, a second
    -- seam and a second registration. The importer emits the value its texts
    -- agree on and reports any box that wanted a different one.
    var box_min: u8

    function set_box_min(rows: u8) {
        box_min = rows
    }

    -- SMS: the left-column blank (bkg.edge_mask) hides screen column 0 in a
    -- STREAMED room, so a box that reaches it - the reference engine's full-width
    -- set_box_metrics(0, SCREEN_COLS) - drew its left border under the mask.
    -- While the mask is armed the box INSETS to the 31 visible columns:
    -- column 0 becomes 1 and the width clamps so the right border stays on
    -- the last visible column. The masked strip beside it shows the backdrop,
    -- so the box still spans everything the player can see. A painted SMS
    -- room (mask off) and every other console keep the authored span
    -- verbatim - the helpers and every call fold away off the SMS.
    if platform == "sms" {
    bank(0) local function eff_box_col() -> u8 {
        if player.edge_masked() == 1 {
            if box_col == 0 {
                return 1
            }
        }
        return box_col
    }
    bank(0) local function eff_box_w() -> u8 {
        if player.edge_masked() == 1 {
            if box_col == 0 {
                if box_w > SCREEN_COLS - 1 {
                    return SCREEN_COLS - 1
                }
            }
        }
        return box_w
    }
    }

    -- The open box's top row, and the first row/column its TEXT goes on (one
    -- cell inside the frame). The generated render_text prints at
    -- box_left(), box_top() + lineno.
    bank(0) function box_row() -> u8 {
        if VM_NO_VIEW {
            return SCREEN_ROWS - box_h
        } else {
            return view_rows - box_h
        }
    }
    bank(0) function box_top() -> u8 {
        if VM_NO_VIEW {
            return SCREEN_ROWS - box_h + 1
        } else {
            return view_rows - box_h + 1
        }
    }
    bank(0) function box_left() -> u8 {
        if platform == "sms" {
            return eff_box_col() + 1
        }
        return box_col + 1
    }

    -- Size the box for string `id` before the frame is drawn: `lines + 2`,
    -- clamped to the 3 lines render_text draws and to a box that still fits
    -- the shortest screen (the 12-row Lynx).
    bank(0) local function size_box(id: u8) {
        box_h = BOX_H
        if has_tlines == 1 {
            var n: u8 = g_tlines(id)
            if n < 1 {
                n = 1
            }
            if n > 3 {
                n = 3
            }
            box_h = n + 2
        }
        if box_h < box_min {
            box_h = box_min
        }
    }

    -- One TYPEWRITER reveal step (the OP_UI_TEXT wait path calls it once per
    -- VM frame while tw_run == 1). The reference engine's ui_update, on our clocks:
    --   * paced on ELAPSED DISPLAY frames (system.frames(), capped at 8 like
    --     the music catch-up) - its `game_time & mask` counts LCD frames, and
    --     a VM frame is 1..3 of those depending on the room, so counting
    --     calls would reveal at a different speed in every scene.
    --   * A or B HELD fast-forwards (its INPUT_A_OR_B_PRESSED), when the
    --     TEXT_SPEED op allowed it. The same press cannot ALSO dismiss the
    --     box: read_input runs before run_scripts and its dismiss arm stands
    --     down while tw_run == 1, and by the next frame the held button no
    --     longer edges.
    --   * the BLIP plays once per step that drew at least one char, through
    --     the g_tone seam - so it costs nothing without vm.snd, exactly like
    --     the sound ops.
    -- The step renderer contract: g_tstep(id, from, upto) plots printable
    -- chars [from, upto) and returns how many it plotted - fewer than asked
    -- means the text ran out, which is the completion signal (255 = all).
    if VM_OP_TEXT_SPEED {
        hot local function tw_step() {
            if tw_ff_ok == 1 {
                var ff: u8 = 0
                if input.held(INPUT_A) {
                    ff = 1
                }
                if input.held(INPUT_B) {
                    ff = 1
                }
                if ff == 1 {
                    g_tstep(box_id, tw_pos, 255)
                    tw_run = 0
                    return
                }
            }
            var now: u16 = system.frames()
            var el: u16 = now - tw_last
            tw_last = now
            if el > 8 {
                el = 8
            }
            var step: u8 = 0
            while el > 0 {
                if (tw_frame & tw_mask) == 0 {
                    step += 1
                }
                tw_frame += 1
                el -= 1
            }
            if step > 0 {
                var drawn: u8 = g_tstep(box_id, tw_pos, tw_pos + step)
                tw_pos += drawn
                if drawn < step {
                    tw_run = 0          -- the text ran out: reveal complete
                }
                if VM_OP_TEXT_BLIP {
                    if drawn > 0 {
                        if blip_freq > 0 {
                            if has_snd == 1 {
                                g_tone(blip_freq, blip_len)
                            }
                        }
                    }
                }
            }
        }
    }

    -- ---- bytecode reads (advance the current thread's PC) ----
    -- The slice fetch, spelled out at each site rather than as a helper: a
    -- mosaik function is a C function and sdcc/cc65 do not inline, so the
    -- helper cost a call per byte - the very thing the window removes. With
    -- a window it is one 16-bit add and a load; without, the g_fetch call.
    bank(0) local function f8() -> u8 {
        var b: u8
        if has_code_window == 1 {
            b = hw.peek(code_base + pcr)
        } else {
            b = g_fetch(pcr)
        }
        pcr += 1
        return b
    }
    bank(0) local function f16() -> u16 {
        var lo: u8
        var hi: u8
        var p1: u16 = pcr + 1
        if has_code_window == 1 {
            lo = hw.peek(code_base + pcr)
            hi = hw.peek(code_base + p1)
        } else {
            lo = g_fetch(pcr)
            hi = g_fetch(p1)
        }
        pcr += 2
        var h: u16 = hi
        var l: u16 = lo
        return (h << 8) | l
    }

    -- ---- expression stack (per executing thread `cur`) ----
    bank(0) local function vpush(v: i16) {
        if spr >= VM_STACK {
            return              -- FULL: drop the push rather than write past this
                                -- thread's cells into the NEXT thread's stack.
        }
        var idx: u8 = sbase + spr
        vm_stack[idx] = v
        spr += 1
    }
    bank(0) local function vpop() -> i16 {
        if spr == 0 {
            return 0            -- EMPTY: a bare `-= 1` would wrap `spr` to 255
                                -- to 65535 and index far out of the 64/128-cell
                                -- array (an OOB console RAM read). Clamp to 0.
        }
        spr -= 1
        var idx: u8 = sbase + spr
        return vm_stack[idx]
    }

    -- Evaluate an inline RPN token stream (terminated by 0xFF), leaving its
    -- result on the thread stack. The reference VM's VM_RPN semantics, written pointer-free:
    -- const/var/engine-state pushes + the full operator set. No raw addresses --
    -- variables are heap indices and engine state comes through id accessors
    -- (the safe pointer-free bridge). Signed i16 throughout.
    -- Returns 1 when the stream ended (0xFF or an unknown token), 0 when it
    -- ran past the 255-token cap (spec §8.2): a stream with no terminator --
    -- hand-authored, or a corrupt blob -- used to run until the next
    -- unknown byte, and the u16 pc wraps, so nothing bounded it. The caller
    -- ends the thread, the runaway-PC guard's answer (§13.5).
    bank(0) local function rpn_eval() -> u8 {
        var ntk: u8 = 0
        loop {
            if ntk == 255 {
                return 0
            }
            ntk += 1
            var tk: u8
            if has_code_window == 1 {
                tk = hw.peek(code_base + pcr)
            } else {
                tk = g_fetch(pcr)
            }
            pcr += 1
            if tk == 0xFF {
                return 1
            }
            -- ONE switch on the token, not a 40-arm if-chain that paid up to
            -- 40 compares for a late token (review V-6). The 0xFF terminator
            -- is tested BEFORE the switch on purpose: with it as a case the
            -- value range was 0..255 for 38 labels and sdcc laid the switch
            -- out as a compare ladder (38 cp/jp pairs, ~150 M-cycles for a
            -- late token - measured on the falling-block assembly sample); without it the range is
            -- 0x01..0x51 and sdcc emits a JUMP TABLE. Each arm is still
            -- guarded by its VM_RPN_* dispatch flag: a pruned arm folds to an
            -- EMPTY case, which breaks out of the switch to the `return 1`
            -- below and ends the evaluation, exactly like an unknown token
            -- (spec 13.5).
            switch tk {
            case 0x01 {    -- PUSH const (u16 bits -> i16)
                if VM_RPN_PUSH {
                    var v: u16 = f16()
                    vpush(v)
                    continue
                }
            }
            case 0x02 {    -- PUSH var heap[idx]
                if VM_RPN_VAR {
                    var idx: u8 = f8()
                    if idx < VM_HEAP {          -- OOB read guard (see SET_CONST)
                        vpush(heap[idx])
                    } else {
                        vpush(0)
                    }
                    continue
                }
            }
            case 0x20 {    -- ==
                if VM_RPN_EQ {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a == b { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x21 {    -- !=
                if VM_RPN_NE {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a != b { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x22 {    -- <
                if VM_RPN_LT {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a < b { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x23 {    -- >
                if VM_RPN_GT {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a > b { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x24 {    -- <=
                if VM_RPN_LE {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a <= b { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x25 {    -- >=
                if VM_RPN_GE {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a >= b { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x10 {    -- +
                if VM_RPN_ADD {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    vpush(a + b)
                    continue
                }
            }
            case 0x11 {    -- -
                if VM_RPN_SUB {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    vpush(a - b)
                    continue
                }
            }
            case 0x12 {    -- *
                if VM_RPN_MUL {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    vpush(a * b)
                    continue
                }
            }
            case 0x13 {    -- / (div-by-zero -> 0)
                if VM_RPN_DIV {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if b == 0 { vpush(0) } else { vpush(a / b) }
                    continue
                }
            }
            case 0x14 {    -- % (mod-by-zero -> 0)
                if VM_RPN_MOD {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if b == 0 { vpush(0) } else { vpush(a % b) }
                    continue
                }
            }
            case 0x15 {    -- & (bitwise and)
                if VM_RPN_B_AND {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    vpush(a & b)
                    continue
                }
            }
            case 0x16 {    -- | (bitwise or)
                if VM_RPN_B_OR {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    vpush(a | b)
                    continue
                }
            }
            case 0x17 {    -- ^ (bitwise xor)
                if VM_RPN_B_XOR {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    vpush(a ^ b)
                    continue
                }
            }
            case 0x18 {    -- << (count masked 0..15)
                if VM_RPN_SHL {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    var au: u16 = a
                    var sh: u8 = b & 15
                    var ru: u16 = au << sh
                    var r: i16 = ru
                    vpush(r)
                    continue
                }
            }
            case 0x19 {    -- >> (LOGICAL shift on the u16 bits)
                if VM_RPN_SHR {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    var au: u16 = a
                    var sh: u8 = b & 15
                    var ru: u16 = au >> sh
                    var r: i16 = ru
                    vpush(r)
                    continue
                }
            }
            case 0x30 {    -- and
                if VM_RPN_AND {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a != 0 and b != 0 { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x31 {    -- or
                if VM_RPN_OR {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a != 0 or b != 0 { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x32 {    -- not
                if VM_RPN_NOT {
                    var a: i16 = vpop()
                    if a == 0 { vpush(1) } else { vpush(0) }
                    continue
                }
            }
            case 0x40 {    -- min
                if VM_RPN_MIN {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a < b { vpush(a) } else { vpush(b) }
                    continue
                }
            }
            case 0x41 {    -- max
                if VM_RPN_MAX {
                    var b: i16 = vpop()
                    var a: i16 = vpop()
                    if a > b { vpush(a) } else { vpush(b) }
                    continue
                }
            }
            case 0x42 {    -- neg
                if VM_RPN_NEG {
                    var a: i16 = vpop()
                    vpush(0 - a)
                    continue
                }
            }
            case 0x43 {    -- abs
                if VM_RPN_ABS {
                    var a: i16 = vpop()
                    if a < 0 { vpush(0 - a) } else { vpush(a) }
                    continue
                }
            }
            case 0x44 {    -- ~ (bitwise complement)
                if VM_RPN_B_NOT {
                    var a: i16 = vpop()
                    var au: u16 = a
                    var ru: u16 = au ^ 0xFFFF
                    var r: i16 = ru
                    vpush(r)
                    continue
                }
            }
            case 0x03 {    -- PUSH actor x (literal id or SELF ->
                if VM_RPN_ACTOR_X {
                    var i: u8 = resolve_actor(f8())   -- the thread's bound actor)
                    vpush(actor.x_of(i))
                    continue
                }
            }
            case 0x04 {    -- PUSH actor y
                if VM_RPN_ACTOR_Y {
                    var i: u8 = resolve_actor(f8())
                    vpush(actor.y_of(i))
                    continue
                }
            }
            case 0x05 {    -- PUSH player x (engine state)
                if VM_RPN_PLAYER_X {
                    vpush(player.pos_x())
                    continue
                }
            }
            case 0x06 {    -- PUSH player y
                if VM_RPN_PLAYER_Y {
                    vpush(player.pos_y())
                    continue
                }
            }
            case 0x07 {    -- GET_STATE: push a curated engine field
                if VM_RPN_GET_STATE {
                    var sid: u8 = f8()
                    vpush(get_state(sid))
                    continue
                }
            }
            case 0x08 {    -- PUSH actor HP (literal id or SELF)
                if VM_RPN_ACTOR_HP {
                    var i: u8 = resolve_actor(f8())
                    var h: i16 = actor.hp_of(i)
                    vpush(h)
                    continue
                }
            }
            case 0x09 {    -- PUSH the bound actor's slot (self_slot())
                if VM_RPN_SELF_SLOT {
                    var s: i16 = vm_self[cur]
                    vpush(s)
                    continue
                }
            }
            case 0x0A {    -- ARG: push thread argument n (THREADN)
                if VM_RPN_ARG {
                    var n: u8 = f8()
                    if n < NARGS {
                        var ci: u16 = cur
                        vpush(vm_arg[ci * NARGS + n])
                    } else {
                        vpush(0)
                    }
                    continue
                }
            }
            case 0x0B {    -- PUSH: is the actor's
                if VM_RPN_ACTOR_MOVING {
                    var i: u8 = resolve_actor(f8())   -- native auto-move still in
                    var m: i16 = actor.is_moving(i)   -- flight? (the waitable-move
                    vpush(m)                          -- poll idiom)
                    continue
                }
            }
            case 0x50 {    -- RAND: push random in [0, mod)
                if VM_RPN_RAND {
                    var md: u16 = f16()
                    var r: u16 = system.random()
                    if md > 0 {
                        vpush(r % md)
                    } else {
                        vpush(0)
                    }
                    continue
                }
            }
            case 0x51 {    -- atan2(y, x) -> 0..255
                if VM_RPN_ATAN2 {
                    var b: i16 = vpop()             -- x (pushed second)
                    var a: i16 = vpop()             -- y
                    if has_atan2 == 1 {
                        var ang: u8 = g_atan2(a, b)
                        var angi: i16 = ang
                        vpush(angi)
                    } else {
                        vpush(0)                    -- pack absent: an honest 0 (R5)
                    }
                    continue
                }
            }
            }
            return 1                    -- unknown (or pruned) token: end the evaluation (spec 13.5)
        }
    }

    -- Curated engine-state bridge (GET_STATE token / SET_STATE op). An id selects
    -- a field; no raw addresses reach the bytecode. Player x/y route to vm.player,
    -- camera to vm.player's scripted-camera lock, scene to the room tracker.
    bank(0) local function get_state(sid: u8) -> i16 {
        -- The BATCHED pad read: every held button in one i16 (bit = portable
        -- button id). A converted EVENT_AWAIT_INPUT polls "any of these
        -- buttons" every lap, and spelled as per-button reads that is eight
        -- GET_STATE tokens OR'd - 15 RPN tokens a poll (the platformer conversion's room 2).
        -- One read + one B_AND asks
        -- the same question. Whole arm behind the flag (the VM_ST_CAMERA_MIN_X
        -- shape), so a blob that never reads it is byte-identical.
        if VM_ST_PAD_HELD {
            if sid == ST_PAD_HELD {
                var m: i16 = 0
                if btn_held(BTN_A) == 1 { m |= 1 }
                if btn_held(BTN_B) == 1 { m |= 2 }
                if btn_held(BTN_START) == 1 { m |= 4 }
                if btn_held(BTN_SELECT) == 1 { m |= 8 }
                if btn_held(BTN_UP) == 1 { m |= 16 }
                if btn_held(BTN_DOWN) == 1 { m |= 32 }
                if btn_held(BTN_LEFT) == 1 { m |= 64 }
                if btn_held(BTN_RIGHT) == 1 { m |= 128 }
                return m
            }
        }
        -- ONE switch on the id for the exact ids (review V-6: a compare
        -- ladder / jump table instead of a 12-arm if-chain paid per read);
        -- the two RANGES (held buttons, and anything unknown) follow it.
        switch sid {
        case ST_PLAYER_X {
            return player.pos_x()
        }
        case ST_PLAYER_Y {
            return player.pos_y()
        }
        case ST_CAMERA_X {
            return player.cam_x()
        }
        case ST_CAMERA_Y {
            return player.cam_y()
        }
        case ST_CAMERA_LOCK {
            return player.cam_settings()
        }
        case ST_SCENE {
            var s: i16 = cur_scene
            return s
        }
        case ST_SAVE_EXISTS {
            if has_save_pack == 1 {
                var h: i16 = g_save_has()
                return h
            }
            return 0
        }
        case ST_PLAYER_DIR {
            return player.face()
        }
        case ST_IS_COLOR {
            if platform == "gameboy_color" {
                return 1
            } else if platform == "analogue_pocket" {
                return 1
            } else if platform == "pce" {
                return 1
            } else if platform == "sms" {
                return 1
            } else if platform == "gamegear" {
                return 1
            } else if platform == "lynx" {
                return 1
            } else {
                return 0
            }
        }
        case ST_GAME_TIME {
            -- The free-running VM-frame clock. The counter is only MAINTAINED
            -- when the program reads it (VM_ST_GAME_TIME, from the blob scan),
            -- so a game that never rate-limits pays nothing per frame; this
            -- read then answers 0, which is the honest value of a clock that
            -- was never started.
            var t: i16 = vm_time
            return t
        }
        case ST_UI_OPEN {
            -- The pack ids (spec 5.3 "16+ pack-defined"). A script polls these
            -- to drive continuous motion itself: an auto-repeat / DAS loop needs
            -- the button STILL HELD, which the edge-triggered input_attach
            -- cannot answer. ST_UI_OPEN lets the same loop stand down while a
            -- box owns the screen.
            if box_open == 1 {
                return 1
            }
            if menu_open == 1 {
                return 1
            }
            return 0
        }
        }
        if sid >= ST_HELD_BASE {
            if sid < ST_UI_OPEN {
                var b: i16 = btn_held(sid - ST_HELD_BASE)
                return b
            }
        }
        return 0
    }
    -- The bodies of three W6 arms live OUT of bank 0: `set_state` and `step`
    -- are resident, and these run on a script's request, never per frame, so
    -- under `[build] code_banks` a helper costs the resident image one call
    -- where its body inline cost it everything (measured on the reference-engine sample conversion's GBC).
    -- The OPERANDS stay fetched in the resident arm: a banked function maps
    -- its own bank over a banked bytecode window.
    local function timer_restart(v: i16) {
        if v >= 0 {
            if v < NTIMERS {
                var ti: u8 = v
                tmr_count[ti] = tmr_period[ti]
            }
        }
    }

    -- End every OTHER live thread bound to join cell `hs`; 1 when the
    -- executing thread `c` is bound to it too (the arm then ends it through
    -- the central ST_END path).
    local function stop_handle(hs: u8, c: u8) -> u8 {
        var self_hit: u8 = 0
        if hs < VM_HEAP {
            for k in 0..VM_CTXS {
                if vm_active[k] == 1 {
                    if vm_handle[k] == hs {
                        if k == c {
                            self_hit = 1
                        } else {
                            kill(k)
                        }
                    }
                }
            }
        }
        return self_hit
    }

    local function get_dir_into(i: u8, v: u8) {
        if v < VM_HEAP {
            heap[v] = actor.dir_of(i)
        }
    }

    bank(0) local function set_state(sid: u8, v: i16) {
        switch sid {            -- one switch, not a 10-arm chain (review V-6)
        case ST_PLAYER_X {
            player.set_pos_x(v)
        }
        case ST_PLAYER_Y {
            player.set_pos_y(v)
        }
        case ST_CAMERA_X {
            player.cam_set_x(v)
        }
        case ST_CAMERA_Y {
            player.cam_set_y(v)
        }
        case ST_CAMERA_LOCK {
            player.set_cam_settings(v)
        }
        case ST_PLAYER_DIR {
            player.set_face(v & 3)      -- turn the player without moving it
        }
        case ST_RAND_SEED {
            system.seed_random(v)       -- the reference engine's EVENT_RNG_SEED
        }
        case ST_PLAYER_COLLIDE {
            player.set_actor_collide(v) -- actors block the player, or not
        }
        case ST_PLAYER_SPEED {
            player.set_speed(v)         -- px per VM frame (clamped to >= 1)
        }
        case ST_PLAYER_ANIM_SPEED {
            player.set_anim_speed(v)    -- read back by vm.canim.tick_player
        }
        }
        -- The camera clamp rectangle, as ONE guarded range rather than four
        -- arms in the chain above: set_state is `bank(0)` RESIDENT image, so
        -- four `else if`s would be paid by every project on every console.
        -- The four ids are consecutive, and the blob scan states the flag for
        -- the first of them (a script sets all four together - the reference engine's
        -- event writes them in one go and there is no other producer).
        if VM_ST_CAMERA_MIN_X {
            if sid >= ST_CAM_MIN_X {
                if sid <= ST_CAM_MAX_Y {
                    player.set_cam_bound(sid - ST_CAM_MIN_X, v)
                }
            }
        }
        -- The four CAMERA PROPERTIES (dead zone x/y, follow offset x/y), the
        -- camera-clamp shape above: four consecutive ids behind one flag, so
        -- a game that never tunes its follow camera pays nothing in resident
        -- image. Unlike the clamp rectangle, the reference engine's event writes ONE of
        -- them per use, so the build states the flag from all four ids
        -- (VM_CAM_PROPS), not from the first.
        if VM_CAM_PROPS {
            if sid >= ST_CAM_DEADZONE_X {
                if sid <= ST_CAM_OFFSET_Y {
                    player.set_cam_prop(sid - ST_CAM_DEADZONE_X, v)
                }
            }
        }
        -- The BLANK state pair, the same shape and for the same reason: two
        -- consecutive ids behind one flag, so a game with no pit pays nothing
        -- for them in resident image. The flag is stated for the FIRST id
        -- because the two always ship together - a script that raises the
        -- state is the only thing that sets its gravity.
        if VM_ST_PLAYER_BLANK {
            if sid == ST_PLAYER_BLANK {
                player.set_blank(v)
            } else if sid == ST_PLAYER_BLANK_GRAV {
                player.set_blank_grav(v)
            }
        }
        -- The menu B-cancel latch: one-shot, read by the next OP_MENU open.
        if VM_ST_MENU_CANCEL {
            if sid == ST_MENU_CANCEL {
                menu_cancel = v
            }
        }
        -- The timed-box latch: one-shot, read by the next OP_UI_TEXT open.
        if VM_ST_BOX_HOLD {
            if sid == ST_BOX_HOLD {
                box_hold = v
            }
        }
        -- The fade direction: persistent, read by every later ramp (the FADE
        -- op's and the room-load auto-fade's alike, both go through fx).
        if VM_ST_FADE_STYLE {
            if sid == ST_FADE_STYLE {
                fx.set_style(v)
            }
        }
        -- Restart a timer's countdown. The active flag is left alone, so a
        -- stopped timer stays stopped - the reference VM's reset writes `remains` only.
        if VM_ST_TIMER_RESET {
            if sid == ST_TIMER_RESET {
                timer_restart(v)
            }
        }
        -- Pause / resume the scene type's update (run() reads it).
        if VM_ST_SCENE_UPDATE_PAUSED {
            if sid == ST_SCENE_UPDATE_PAUSED {
                if v == 0 {
                    scene_paused = 0
                } else {
                    scene_paused = 1
                }
            }
        }
        -- The SAVE SLOT latch: one-shot, consumed by the next save / load /
        -- clear / peek / save_exists() (W7c). Pushed straight to vm.sram, which
        -- is what owns it - see the seam note above.
        if VM_SAVE_SLOTS {
            if sid == ST_SAVE_SLOT {
                if has_save_slots == 1 {
                    var sl: u8 = v
                    g_save_slot(sl)
                }
            }
        }
        -- Where the window OVERLAY stops. Persistent, read by the emitted
        -- LCD interrupt at every later frame; the verb is what owns the stop
        -- (and is an honest no-op on a console with no window layer). The
        -- whole arm folds away under VM_ST_OVERLAY_CUT, which is what keeps
        -- `text.win_overlay_cut` out of a program that never writes the state
        -- - the by-use scan that decides the emitted interrupt's shape reads
        -- the FOLDED source, so the third LYC tenant appears only here.
        if VM_ST_OVERLAY_CUT {
            if sid == ST_OVERLAY_CUT {
                var ocut: u8 = v
                text.win_overlay_cut(ocut)
            }
        }
        -- Hide / show every sprite, through the video VERB (its GBDK form
        -- records the program's wish, so a box's sprite cut restores it).
        if VM_ST_SPRITES_HIDDEN {
            if sid == ST_SPRITES_HIDDEN {
                if v == 0 {
                    video.show_sprites()
                } else {
                    video.hide_sprites()
                }
            }
        }
    }

    -- Resolve an actor-index operand: SELF_ACTOR -> the executing thread's bound
    -- actor (vm_self, always kept a valid pool index by set_self + the 0
    -- default), else the literal index CLAMPED to the vm.actor pool (the
    -- assembler validates against the same bound, but hand-authored bytecode is
    -- first-class and the pool arrays index with this value -- an OOB literal
    -- would corrupt RAM). The bound is VM_ACTOR_POOL, not a literal 8: the
    -- `[build] actor_pool` knob grows the pool, and a hardcoded 8 here silently
    -- redirected every script op on slots 8+ to actor 0.
    bank(0) local function resolve_actor(i: u8) -> u8 {
        if i == SELF_ACTOR {
            return vm_self[cur]
        }
        if i >= VM_ACTORS {
            return 0
        }
        return i
    }

    -- Find a free context, or 255 if the pool is full.
    bank(0) local function alloc_ctx() -> u8 {
        for i in 0..VM_CTXS {
            if vm_active[i] == 0 {
                -- the running slice's context is not free even after a
                -- self-kill (see slice_live): its registers are still live
                if slice_live == 0 or i != cur {
                    return i
                }
            }
        }
        return 255
    }

    -- Spawn a child of the EXECUTING thread (the THREAD/THREADN ops): a plain
    -- spawn plus the HANDLE_NEXT latch transfer (spec Â§8.3) -- if the spawner
    -- armed a latch, the child is bound to it (heap cell reads 1 while the
    -- child runs; the Â§11 death path writes 0) and the latch clears.
    bank(0) local function spawn_child(t: u16) -> u8 {
        var s: u8 = spawn(t)
        if s != 255 {
            if vm_hnext[cur] != 255 {
                vm_handle[s] = vm_hnext[cur]
                heap[vm_handle[s]] = 1      -- hnext is guarded < VM_HEAP at set
                vm_hnext[cur] = 255
            }
        }
        return s
    }

    -- Execute ONE instruction of thread `c`. Returns an ST_* status.
    bank(0) local function step(c: u8) -> u8 {
        cur = c
        var op: u8
        if has_code_window == 1 {
            op = hw.peek(code_base + pcr)
        } else {
            op = g_fetch(pcr)
        }
        pcr += 1
        switch op {
            case OP_STOP {
                if VM_OP_STOP {
                    vm_active[c] = 0            -- lock/music cleanup: run_context's
                    return ST_END               -- central ST_END path
                }
            }
            case OP_JUMP {
                if VM_OP_JUMP {
                    var t: u16 = f16()
                    pcr = t
                    return ST_CONT
                }
            }
            case OP_IDLE {
                if VM_OP_IDLE {
                    return ST_YIELD
                }
            }
            case OP_WAIT {
                if VM_OP_WAIT {
                    var frames: u8 = f8()
                    if vm_waiting[c] == 0 {
                        vm_waiting[c] = 1
                        vm_scratch[c] = frames
                    }
                    -- test BEFORE decrementing: WAIT n yields on n frames
                    -- (the reference VM seeds n+1 and decrements first - same timing,
                    -- but n+1 would wrap a u8 at 255)
                    if vm_scratch[c] > 0 {
                        vm_scratch[c] -= 1
                        pcr -= 2       -- rewind opcode + operand: re-enter next frame
                        return ST_YIELD
                    }
                    vm_waiting[c] = 0
                    return ST_CONT
                }
            }
            case OP_LOCK {
                if VM_OP_LOCK {
                    vm_lockcount += 1
                    vm_lockowner = c
                    return ST_CONT
                }
            }
            case OP_UNLOCK {
                if VM_OP_UNLOCK {
                    if vm_lockcount > 0 {
                        vm_lockcount -= 1
                    }
                    return ST_CONT
                }
            }
            case OP_OVERLAY_SHOW {
                if VM_OP_OVERLAY_SHOW {
                    var r: u8 = f8()
                    if has_overlay == 1 {
                        g_overlay(0, r, 0)
                    }
                    return ST_CONT
                }
            }
            case OP_OVERLAY_MOVE_TO {
                if VM_OP_OVERLAY_MOVE_TO {
                    var r: u8 = f8()
                    var sp: u8 = f8()
                    if has_overlay == 1 {
                        if g_overlay(1, r, sp) == 0 {
                            pcr -= 3   -- rewind opcode + 2 operands: re-enter next frame
                            return ST_YIELD
                        }
                    }
                    return ST_CONT
                }
            }
            case OP_THREAD {
                if VM_OP_THREAD {
                    var t: u16 = f16()
                    spawn_child(t)          -- ONE context-init path (spawn also clears
                                            -- vm_sp/vm_csp/vm_self/args/handle, so a
                                            -- reused context never inherits stale state)
                    return ST_CONT
                }
            }
            case OP_THREADN {
                if VM_OP_THREADN {
                    var t: u16 = f16()
                    var n: u8 = f8()
                    for j in 0..NARGS {
                        argv_scratch[j] = 0
                    }
                    -- pop n values, last-pushed -> arg[n-1]; extras past NARGS are
                    -- popped AND DROPPED; the pops happen even if the pool is full
                    -- (stack discipline, spec Â§6 op 0x07)
                    var k: u8 = n
                    while k >= 1 {
                        var v: i16 = vpop()
                        if k <= NARGS {
                            argv_scratch[k - 1] = v
                        }
                        k -= 1
                    }
                    var s: u8 = spawn_child(t)
                    if s != 255 {
                        var si: u16 = s
                        for j in 0..NARGS {
                            vm_arg[si * NARGS + j] = argv_scratch[j]
                        }
                    }
                    return ST_CONT
                }
            }
            case OP_SET_CONST {
                if VM_OP_SET_CONST {
                    var idx: u8 = f8()
                    var v: u16 = f16()
                    if idx < VM_HEAP {      -- a u8 operand can carry 64..255: guard
                        heap[idx] = v       -- the OOB write (hand-authored bytecode
                    }                       -- is first-class; compiler emits 0..63)
                    return ST_CONT
                }
            }
            case OP_RPN {
                if VM_OP_RPN {
                    if rpn_eval() == 0 {
                        vm_active[c] = 0        -- runaway token stream: END
                        return ST_END
                    }
                    return ST_CONT
                }
            }
            case OP_SET_VAR {
                if VM_OP_SET_VAR {
                    var idx: u8 = f8()
                    var sv: i16 = vpop()    -- always pop (stack discipline), then
                    if idx < VM_HEAP {      -- guard the write like SET_CONST
                        heap[idx] = sv
                    }
                    return ST_CONT
                }
            }
            case OP_IF {
                if VM_OP_IF {
                    var t: u16 = f16()
                    var v: i16 = vpop()
                    if v == 0 {
                        pcr = t
                    }
                    return ST_CONT
                }
            }
            case OP_RAISE {
                if VM_OP_RAISE {
                    var code: u8 = f8()
                    var a: u8 = f8()
                    var b: u16 = f16()
                    var d: u16 = f16()
                    pend_code = code        -- last-writer-wins (spec Â§10)
                    pend_a = a
                    pend_b = b
                    pend_c = d
                    vm_active[c] = 0        -- END the raising thread; run() services
                                            -- the exception at frame step 4. A
                                            -- `lock ... raise` cutscene's lock is
                                            -- released by run_context's central
                                            -- ST_END cleanup (under a lock only the
                                            -- owner runs, so the raiser IS the owner).
                    return ST_END
                }
            }
            case OP_CHANGE_SCENE_E {
                if VM_OP_CHANGE_SCENE_E {
                    -- RAISE 2 with the room taken off the expression stack
                    -- (pushed room, x, y -- so y is on top). Lets a scene
                    -- change target a COMPUTED room, which the literal RAISE
                    -- cannot: a scene STACK stores scene() in a heap cell and
                    -- returns to it later.
                    var ey: i16 = vpop()
                    var ex: i16 = vpop()
                    var er: i16 = vpop()
                    pend_code = 2           -- last-writer-wins (spec Â§10)
                    pend_a = er
                    pend_b = ex
                    pend_c = ey
                    vm_active[c] = 0        -- END the raising thread, like RAISE
                    return ST_END
                }
            }
            case OP_HANDLE {
                if VM_OP_HANDLE {
                    var i: u8 = f8()
                    if i < VM_HEAP {        -- bind THIS thread's liveness to heap[i]
                        vm_handle[c] = i
                        heap[i] = 1
                    } else {
                        vm_handle[c] = 255
                    }
                    return ST_CONT
                }
            }
            case OP_HANDLE_NEXT {
                if VM_OP_HANDLE_NEXT {
                    var i: u8 = f8()
                    if i < VM_HEAP {        -- arm the one-shot latch for the next child
                        vm_hnext[c] = i
                    } else {
                        vm_hnext[c] = 255
                    }
                    return ST_CONT
                }
            }
            case OP_SELF {
                if VM_OP_SELF {
                    var a: u8 = f8()
                    if a < VM_ACTORS {      -- bind the SELF actor from bytecode
                        vm_self[c] = a
                    }
                    return ST_CONT
                }
            }
            case OP_CALL {
                if VM_OP_CALL {
                    var entry: u16 = f16()             -- pc now = the return address
                    if vm_csp[c] < CALL_DEPTH {
                        vm_call[c * CALL_DEPTH + vm_csp[c]] = pcr
                        vm_csp[c] += 1
                        pcr = entry
                    }
                    return ST_CONT
                }
            }
            case OP_RET {
                if VM_OP_RET {
                    if vm_csp[c] > 0 {
                        vm_csp[c] -= 1
                        pcr = vm_call[c * CALL_DEPTH + vm_csp[c]]
                        return ST_CONT
                    }
                    vm_active[c] = 0                   -- RET with no caller = end thread
                    return ST_END
                }
            }
            case OP_PLAYER_SETPOS {
                if VM_OP_PLAYER_SETPOS {
                    var x: u16 = f16()
                    var y: u16 = f16()
                    player.set_pos(x, y)
                    return ST_CONT
                }
            }
            case OP_PLAYER_SETPOS_E {
                if VM_OP_PLAYER_SETPOS_E {
                    var y: i16 = vpop()         -- pushed x then y: y is on top
                    var x: i16 = vpop()
                    var xu: u16 = x
                    var yu: u16 = y
                    player.set_pos(xu, yu)
                    return ST_CONT
                }
            }
            case OP_SWITCH {
                if VM_OP_SWITCH {
                    var v: i16 = vpop()
                    var n: u8 = f8()
                    var i: u8 = 0
                    while i < n {
                        var cv: i16 = f16()     -- case value (i16 bits)
                        if cv == v {
                            -- MATCH: read THIS entry's target and jump. The walk
                            -- exists only to land the PC past the table when
                            -- nothing matches, and a match overwrites the PC
                            -- anyway, so reading the remaining entries was pure
                            -- cost - a real one at 4 bytes per entry through
                            -- the fetch seam (the falling-block assembly sample's 20-case row dispatch
                            -- measured a MEDIAN 32,000 cycles per SWITCH, half
                            -- a DMG frame, for ONE instruction).
                            pcr = f16()
                            return ST_CONT
                        }
                        -- MISMATCH: step over the target without FETCHING it.
                        -- Only the value decides, so half the bytes this loop
                        -- used to read never had to be read at all.
                        pcr += 2
                        i += 1
                    }
                    return ST_CONT     -- no match: fall through past the table
                }
            }
            case OP_SET_STATE {
                if VM_OP_SET_STATE {
                    var sid: u8 = f8()
                    var v: i16 = vpop()
                    set_state(sid, v)
                    return ST_CONT
                }
            }
            case OP_A_ACTIVATE {
                if VM_OP_A_ACTIVATE {
                    var i: u8 = resolve_actor(f8())
                    var tile: u8 = f8()
                    -- u16: an actor's position is a WORLD pixel and a room runs
                    -- past 255 (see the ISA note on the position operands).
                    var x: u16 = f16()
                    var y: u16 = f16()
                    actor.activate(i, tile, x, y)
                    return ST_CONT
                }
            }
            case OP_A_SET_POS {
                if VM_OP_A_SET_POS {
                    var i: u8 = resolve_actor(f8())
                    var x: u16 = f16()
                    var y: u16 = f16()
                    actor.set_pos(i, x, y)
                    return ST_CONT
                }
            }
            case OP_A_MOVE_TO {
                if VM_OP_A_MOVE_TO {
                    var i: u8 = resolve_actor(f8())
                    var x: u16 = f16()
                    var y: u16 = f16()
                    var done: bool = actor.step_to(i, x, y)
                    if not done {
                        pcr -= 6       -- rewind opcode + u8 + u16 + u16: step again next frame
                        return ST_YIELD
                    }
                    return ST_CONT
                }
            }
            case OP_A_MOVE_OPTS {
                if VM_OP_A_MOVE_OPTS {
                    var md: u8 = f8()
                    var cl: u8 = f8()
                    actor.set_move_opts(md, cl)
                    return ST_CONT
                }
            }
            case OP_PLAYER_MOVE_TO_E {
                if VM_OP_PLAYER_MOVE_TO_E {
                    -- The computed twin of PLAYER_MOVE_TO below. A rewound
                    -- re-entry cannot re-read popped operands, so the target
                    -- LATCHES on first entry (vm_waiting, the A_EMOTE shape).
                    -- The latch STATE and the stepping both live in vm.player,
                    -- which BANKS: this arm is `bank(0)` resident image, so it
                    -- keeps only the fetch, the pops and the rewind - the rule
                    -- A_PUSH documents (its tile walk cost 608 B of bank 0 in
                    -- core against 34 B in the pack).
                    var m: u8 = f8()
                    if vm_waiting[c] == 0 {
                        vm_waiting[c] = 1
                        var ty: i16 = vpop()    -- pushed x then y: y on top
                        var tx: i16 = vpop()
                        player.set_walk_target(tx, ty)
                    }
                    if not player.step_walk(m) {
                        pcr -= 2                -- opcode + mode
                        return ST_YIELD
                    }
                    vm_waiting[c] = 0
                    return ST_CONT
                }
            }
            case OP_PLAYER_MOVE_TO {
                if VM_OP_PLAYER_MOVE_TO {
                    -- The player's own A_MOVE_TO: step once per frame toward
                    -- the target, rewind + yield until it lands. The stepping
                    -- lives in vm.player (which banks) - this arm is resident
                    -- image, so it stays a fetch, a call and a rewind.
                    var x: u16 = f16()
                    var y: u16 = f16()
                    var m: u8 = f8()
                    var done: bool = player.step_to(x, y, m)
                    if not done {
                        pcr -= 6       -- opcode + 2 + 2 + 1 operand bytes
                        return ST_YIELD
                    }
                    return ST_CONT
                }
            }
            case OP_A_SPEED {
                if VM_OP_A_SPEED {
                    var i: u8 = resolve_actor(f8())
                    var s: u8 = f8()
                    actor.set_speed(i, s)
                    return ST_CONT
                }
            }
            case OP_A_MOVE_START {
                if VM_OP_A_MOVE_START {
                    var i: u8 = resolve_actor(f8())
                    var x: u16 = f16()
                    var y: u16 = f16()
                    actor.move_start(i, x, y)   -- non-blocking: step_all() moves it
                    return ST_CONT
                }
            }
            case OP_A_SET_CLIP {
                if VM_OP_A_SET_CLIP {
                    var i: u8 = resolve_actor(f8())
                    var kind: u8 = f8()
                    actor.set_clip(i, kind)     -- data-driven animation (vm.anim reads it)
                    return ST_CONT
                }
            }
            case OP_A_DEACTIVATE {
                if VM_OP_A_DEACTIVATE {
                    var i: u8 = resolve_actor(f8())
                    actor.deactivate(i)         -- retire the actor (killed / picked up)
                    return ST_CONT
                }
            }
            case OP_A_REACTIVATE {
                if VM_OP_A_REACTIVATE {
                    var i: u8 = resolve_actor(f8())
                    actor.reactivate(i)         -- respawn it exactly as placed
                    return ST_CONT
                }
            }
            case OP_A_AWAIT_MOVE {
                if VM_OP_A_AWAIT_MOVE {
                    -- WAIT for the actor's auto-move: yield + rewind while it
                    -- is in flight. Arrival-timed at any speed, and a
                    -- deactivate cancels the move, so a mid-flight kill (the
                    -- shot falling hazard) releases the waiting thread the same frame.
                    var i: u8 = resolve_actor(f8())
                    if actor.is_moving(i) == 1 {
                        pcr -= 2       -- rewind opcode + operand: re-enter next frame
                        return ST_YIELD
                    }
                    return ST_CONT
                }
            }
            case OP_A_SET_POS_E {
                if VM_OP_A_SET_POS_E {
                    var i: u8 = resolve_actor(f8())
                    var y: i16 = vpop()         -- pushed x then y: y is on top
                    var x: i16 = vpop()
                    var xu: u16 = x             -- u16 world pixels (see A_MOVE_START_E)
                    var yu: u16 = y
                    actor.set_pos(i, xu, yu)
                    return ST_CONT
                }
            }
            case OP_A_MOVE_START_E {
                if VM_OP_A_MOVE_START_E {
                    var i: u8 = resolve_actor(f8())
                    var y: i16 = vpop()
                    var x: i16 = vpop()
                    -- u16, NOT u8: actor positions are WORLD pixels and a room
                    -- runs well past 255 (the town room is 448 px square). The
                    -- truncation sent every computed move in a big room to a
                    -- WRAPPED destination - a converted NPC, standing at
                    -- x 376, was told to walk to 120 and set off leftwards
                    -- forever, so the await behind it never released and its
                    -- dialogue never ran.
                    var xu: u16 = x
                    var yu: u16 = y
                    actor.move_start(i, xu, yu)  -- non-blocking: step_all() moves it
                    return ST_CONT
                }
            }
            case OP_UI_TEXT {
                if VM_OP_UI_TEXT {
                    var id: u8 = f8()
                    if vm_waiting[c] == 0 {
                        if platform == "sms" or platform == "gamegear" {
                            if ui_close != 0 {
                                pcr -= 2   -- the PREVIOUS box is still tearing down
                                return ST_YIELD
                            }
                        }
                        if ui_owner != 255 {
                            if ui_owner != c {
                                pcr -= 2   -- UI busy with another thread: retry next frame
                                return ST_YIELD
                            }
                        }
                        ui_owner = c
                        vm_waiting[c] = 1
                        box_open = 1
                        box_id = id         -- remembered so the redraw path can re-draw it
                        if VM_ST_BOX_HOLD {
                            box_hold_live = box_hold   -- consume the one-shot latch
                            box_hold = 0
                        }
                        ui_redraw = 4       -- LYNX: run() draws it over the settle frames
                        -- GB family: overlay the box on the WINDOW layer (bottom-anchored,
                        -- the reference engine's model) so it never touches the scrolling scene map.
                        -- A no-op on every other console (their box stays on the bkg/fb).
                        size_box(id)    -- the reference engine: lines + 2, bottom-anchored
                        text.to_window(box_row(), box_h)
                        -- THE CUT IS ARMED BEFORE THE RE-PLACE, not after it.
                        -- `ui_snap_sprites` is the one pass that walks the
                        -- whole pool here, and the objects it writes must
                        -- already be filtered or they are drawn in the box's
                        -- band and nothing walks again (see ui_sprite_cut).
                        if box_cut == 1 {
                            text.win_sprite_cut(1)   -- no sprites over the box
                            if platform == "sms" or platform == "gamegear" {
                                ui_sprite_cut(box_row() * 8)   -- no window here: park the
                                                              -- objects in the box's band
                            }
                        }
                        if platform == "sms" or platform == "gamegear" {
                            ui_snap_sprites(1)   -- the scroll just snapped; see the helper
                        }
                        if platform == "sms" or platform == "gamegear" {
                            -- STAGED: the border next frame, the text the frame
                            -- after. This frame ends here, having done only the
                            -- snap and the sprite re-place (both sub-frame).
                            ui_stage = 1
                            pcr -= 2
                            return ST_YIELD
                        }
                        if NEEDS_PRESENT_REDRAW == 0 {   -- tilemap consoles: draw once, pre-present
                            if box_framed == 1 {
                                if platform == "sms" {
                                    g_box_draw(eff_box_col(), box_row(), eff_box_w(), box_h)
                                } else {
                                    g_box_draw(box_col, box_row(), box_w, box_h)
                                }
                            } else {
                                -- AN UNFRAMED BOX STILL NEEDS ITS PAPER. A frame
                                -- drawer clears its own interior (engine.box's
                                -- draw_box opens with a clear_area), so only the
                                -- UNFRAMED box has to blank the band itself - and
                                -- on the GB family it never had to, because
                                -- text.to_window MOVES the box onto the window
                                -- layer and clears that band on the way. So the
                                -- gate is the same one the box CLOSE already
                                -- uses: window_active() == 0 means the box is
                                -- plotted into the SCENE's own map, and without
                                -- this the room showed straight through the text
                                -- (measured on vm-uiscroll: the striped wall ran
                                -- through SCROLL HOLD TEST on the GG, and the box
                                -- had no paper at all on SMS/PCE). The Lynx
                                -- already did exactly this in draw_open_ui; this
                                -- is that same else arm, on the tilemap consoles.
                                if text.window_active() == 0 {
                                    text.clear_area(0, box_row(), SCREEN_COLS, box_h)
                                }
                            }
                            if VM_OP_TEXT_SPEED {
                                -- TYPEWRITER: with a speed set and the step
                                -- renderer registered, the frame draws now
                                -- and the TEXT reveals over the frames below.
                                -- Lynx/PCE never reach this branch (their box
                                -- redraws per present) and stay instant.
                                tw_run = 0
                                if has_tstep == 1 {
                                    if tw_idx > 0 {
                                        tw_run = 1
                                        tw_pos = 0
                                        tw_frame = 0
                                        tw_last = system.frames()
                                    }
                                }
                                if tw_run == 0 {
                                    g_text(id)
                                }
                            } else {
                                g_text(id)
                            }
                            -- ...AND ONLY NOW SHOW IT. `text.to_window` put the
                            -- band in place and blanked it; the layer goes on
                            -- here, with the frame and the text already in the
                            -- window map. Switching it on at `to_window` meant
                            -- the box was DISPLAYED half-built - measured on
                            -- the reference-engine sample conversion: blank paper, then the border, then
                            -- the text, one display frame each, because this
                            -- whole block runs inside one VM frame and a VM
                            -- frame is more than one LCD frame. Under the
                            -- TYPEWRITER the text is MEANT to arrive over the
                            -- frames below, and the reveal still belongs here:
                            -- what must not be seen arriving is the BOX.
                            -- An honest no-op on every console without a
                            -- window layer (their box is written straight into
                            -- what is already on screen).
                            text.win_reveal()
                        }
                    }
                    if platform == "sms" or platform == "gamegear" {
                        if ui_stage == 1 {
                            if box_framed == 1 {
                                -- eff_box_* are defined on the SMS ONLY (the
                                -- left-column mask inset), so naming them on the
                                -- Game Gear is an implicit declaration and a LINK
                                -- ERROR. Same fork as the unstaged path.
                                if platform == "sms" {
                                    g_box_draw(eff_box_col(), box_row(), eff_box_w(), box_h)
                                } else {
                                    g_box_draw(box_col, box_row(), box_w, box_h)
                                }
                            } else {
                                text.clear_area(0, box_row(), SCREEN_COLS, box_h)
                            }
                            ui_stage = 2
                            pcr -= 2
                            return ST_YIELD
                        }
                        if ui_stage == 2 {
                            tw_run = 0
                            if VM_OP_TEXT_SPEED {
                                if has_tstep == 1 {
                                    if tw_idx > 0 {
                                        tw_run = 1
                                        tw_pos = 0
                                        tw_frame = 0
                                        tw_last = system.frames()
                                    }
                                }
                            }
                            if tw_run == 0 {
                                -- THE PAGE IS STILL ONE FRAME (2-6 display
                                -- frames, measured). Chunking it needs the
                                -- typewriter's own step seam, g_tstep(id,
                                -- from, upto), and that is registered only
                                -- where the blob sets a TEXT SPEED - which no
                                -- SMS/GG conversion does, so a sliced path
                                -- here would be code no ROM we ship ever
                                -- runs. Recipe if it is ever wanted: emit
                                -- render_text_step unconditionally and walk a
                                -- character cursor by a fixed step per frame.
                                g_text(box_id)
                            }
                            ui_stage = 0
                            pcr -= 2
                            return ST_YIELD
                        }
                    }
                    if VM_OP_TEXT_SPEED {
                        if tw_run == 1 {
                            tw_step()   -- reveal the next chars (this thread
                        }               -- re-enters once per VM frame)
                    }
                    if box_open == 1 {
                        pcr -= 2       -- wait for the A-dismiss (read_input closes it)
                        return ST_YIELD
                    }
                    vm_waiting[c] = 0
                    return ST_CONT
                }
            }
            case OP_MENU {
                if VM_OP_MENU {
                    var op_pc: u16 = pcr - 1        -- rewind here to re-enter
                    var dest: u8 = f8()
                    var row: u8 = f8()
                    var count: u8 = f8()
                    -- NOTE: `row` is the SCRIPT-authored menu top. Unlike the dialogue
                    -- box (engine-positioned at BOX_ROW = SCREEN_ROWS - 4), the menu row
                    -- is the author's choice, so it must fit the SHORTEST target screen:
                    -- the Lynx text grid is only ~12 rows, so a GB-style row (e.g. 14)
                    -- runs the whole menu off the bottom and NOTHING shows on the Lynx.
                    -- A defensive engine clamp here would cost bytes the tight Lynx MAIN
                    -- can't spare (it overflows vm-bigquest / vm-maxcaps-lynx, which sit
                    -- at the ~48 KB edge), so keep vm.core lean and author menu rows
                    -- <= SCREEN_ROWS - count - 1.
                    -- ... and on a console that draws UI into the scene map with no
                    -- window to relocate it (SMS/GG), re-anchor that 12-row default to
                    -- THIS screen's bottom. The box spans `row - 1 .. row + count`, so
                    -- bottom-anchored is row = SCREEN_ROWS - 1 - count; a menu too tall
                    -- for the screen keeps row 1 rather than underflowing to 255.
                    -- The PC Engine draws its UI into the BAT the same way (and
                    -- its 28 rows put a row-12 menu in the MIDDLE of the screen,
                    -- above its own bottom-anchored text boxes), so it re-anchors too.
                    if platform == "sms" or platform == "gamegear" or platform == "pce" {
                        if VM_NO_VIEW {
                            if count + 2 > SCREEN_ROWS {
                                row = 1
                            } else {
                                row = SCREEN_ROWS - 1 - count
                            }
                        } else {
                            -- letterboxed: the bottom of the ROOM, not the screen
                            if count + 2 > view_rows {
                                row = 1
                            } else {
                                row = view_rows - 1 - count
                            }
                        }
                    }
                    if vm_waiting[c] == 0 {
                        if platform == "sms" or platform == "gamegear" {
                            if ui_close != 0 {
                                pcr = op_pc         -- the box is still tearing down
                                return ST_YIELD
                            }
                        }
                        if ui_owner != 255 {
                            if ui_owner != c {
                                pcr = op_pc         -- UI busy with another thread: retry
                                return ST_YIELD
                            }
                        }
                        ui_owner = c
                        vm_waiting[c] = 1
                        menu.set_cursor(0)
                        menu.arm()                       -- the opening button must release first
                        if VM_ST_MENU_CANCEL {
                            menu_cancel_live = menu_cancel   -- consume the one-shot latch
                            menu_cancel = 0
                            menu_prev_b = 1                  -- ...and arm B like A
                        }
                        menu_open = 1
                        menu_last = 255
                        menu_row = row
                        menu_count = count
                        menu_ids = pcr              -- first option id offset (the redraw re-draws)
                        ui_redraw = 4                    -- LYNX: run() draws the box over the settle frames
                        -- GB family: bottom-anchor the menu box on the WINDOW overlay
                        -- (the box authored at `row` is relocated to the bottom, the reference engine
                        -- style). A no-op elsewhere -- their menu stays at `row` on the bkg.
                        text.to_window(row - 1, count + 2)
                        if box_cut == 1 {
                            text.win_sprite_cut(1)   -- no sprites over the menu
                            if platform == "sms" or platform == "gamegear" {
                                ui_sprite_cut((row - 1) * 8)   -- as the box above
                            }
                        }
                        if platform == "sms" or platform == "gamegear" {
                            ui_snap_sprites(1)   -- armed FIRST, as the box above
                        }
                        if NEEDS_PRESENT_REDRAW == 0 {   -- tilemap consoles: frame once, pre-present
                            if box_framed == 1 {
                                if platform == "sms" {
                                    g_box_draw(eff_box_col(), row - 1, eff_box_w(), count + 2)
                                } else {
                                    g_box_draw(box_col, row - 1, box_w, count + 2)
                                }
                            } else {
                                -- AN UNFRAMED MENU NEEDS ITS PAPER TOO (the text
                                -- box's arm above, which the menu never got): the
                                -- options plot only their glyphs, so on a console
                                -- with no window layer the room showed through the
                                -- spaces and around them (the showcase RPG's title
                                -- band on the Game Gear). The GB family's menu is
                                -- on the window, which to_window cleared, so the
                                -- fork keeps its bytes.
                                if platform == "sms" or platform == "gamegear" or platform == "pce" or platform == "nes" {
                                    if text.window_active() == 0 {
                                        text.clear_area(0, row - 1, SCREEN_COLS, count + 2)
                                    }
                                }
                            }
                        }
                    }
                    menu.nav(count)                      -- Up/Down moves the cursor
                    var dirty: u8 = 0
                    if menu.cursor != menu_last {
                        dirty = 1
                        menu_last = menu.cursor
                        ui_redraw = 4                    -- cursor moved: re-seed the buffers (Lynx)
                    }
                    var i: u8 = 0
                    while i < count {
                        var id: u8 = f8()                -- read (advance PC past) each option id
                        -- Tilemap consoles: (re)draw the option on change, pre-present.
                        -- The Lynx does it in run()'s post-present settle instead.
                        if NEEDS_PRESENT_REDRAW == 0 {
                            if dirty == 1 {
                                if has_menu == 1 {
                                    var sel: u8 = 0
                                    if i == menu.cursor {
                                        sel = 1
                                    }
                                    g_menu(id, row + i, sel)
                                }
                            }
                        }
                        i += 1
                    }
                    -- ...AND ONLY NOW SHOW IT (see the box site above). A menu
                    -- is drawn in TWO places - the frame in the open block, the
                    -- OPTIONS in the loop just above - so the reveal cannot sit
                    -- with the frame: it belongs after the last thing that
                    -- writes into the band. `dirty` is 1 on the frame a menu
                    -- opens (cursor 0 against menu_last 255) and on every
                    -- cursor move, which is exactly when the band was written.
                    if dirty == 1 {
                        text.win_reveal()
                    }
                    var go: u8 = 0
                    if menu.confirmed() {
                        go = 1
                    }
                    -- B CANCELS an armed menu (the reference engine's .UI_MENU_CANCEL_B):
                    -- the same close as a confirm, writing -1 instead of the
                    -- cursor. Its own edge latch, armed at open like menu's A.
                    if VM_ST_MENU_CANCEL {
                        if menu_cancel_live == 1 {
                            if input.held(INPUT_B) {
                                if menu_prev_b == 0 {
                                    go = 2
                                }
                                menu_prev_b = 1
                            } else {
                                menu_prev_b = 0
                            }
                        }
                    }
                    if go != 0 {
                        if go == 1 {
                            -- THE CONFIRMING PRESS IS SPENT for read_input too.
                            -- read_input samples A at the top of the VM frame;
                            -- menu.confirmed() reads the pad LIVE, later in the
                            -- same frame. A press that lands in between (a VM
                            -- frame is several LCD frames in a busy room)
                            -- confirmed the menu while prev_a still said
                            -- "released", so the NEXT frame read the same held
                            -- A as a fresh edge and dismissed the text box the
                            -- script opened right after the menu - "Save Game"
                            -- skipped straight past "Game progress has been
                            -- saved." (the adventure check project, a 6-frame press).
                            prev_a = 1
                        }
                        if dest < VM_HEAP {     -- OOB write guard (see SET_CONST)
                            heap[dest] = menu.cursor
                            if VM_ST_MENU_CANCEL {
                                if go == 2 {
                                    heap[dest] = 0 - 1   -- cancelled: no option
                                }
                            }
                        }
                        vm_waiting[c] = 0
                        menu_open = 0
                        ui_owner = 255          -- release the UI latch (a waiting thread may open)
                        -- On the WINDOW overlay (GB family) the scene map is untouched --
                        -- just hide the window (below). Otherwise clear the menu box off
                        -- the bkg/fb + repaint the room behind it (a scrolling room).
                        if text.window_active() == 0 {
                            text.clear_area(0, row - 1, SCREEN_COLS, count + 2)
                            if has_redraw == 1 {
                                g_redraw()
                                -- The repaint re-seeds the whole streamed ring
                                -- (32 columns) inside this ONE VM frame, so the
                                -- song is not advanced across it and stops -
                                -- the reported "it stops when a dialogue box is
                                -- cleared". A no-op without a driver.
                                music_pump()
                            }
                        }
                        text.to_bkg()   -- GB: hide the overlay window; a no-op elsewhere
                        if VM_HUD_RESHOW {
                            hud_band()  -- ...and bring the HUD band back
                        }
                        if box_cut == 1 {
                            text.win_sprite_cut(0)   -- sprites back over the scene
                            if platform == "sms" or platform == "gamegear" {
                                ui_sprite_cut(255)   -- the band is the scene again
                            }
                        }
                        if platform == "sms" or platform == "gamegear" {
                            ui_snap_sprites(0)   -- the scroll just restored; see the helper
                        }
                        return ST_CONT
                    }
                    pcr = op_pc
                    return ST_YIELD
                }
            }
            case OP_FADE {
                if VM_OP_FADE {
                    var dir: u8 = f8()
                    var frames: u8 = f8()
                    if vm_waiting[c] == 0 {
                        vm_waiting[c] = 1
                        vm_scratch[c] = frames
                    }
                    if vm_scratch[c] > 0 {
                        vm_scratch[c] -= 1
                    }
                    var total: u16 = frames
                    var prog: u16 = total - vm_scratch[c]      -- 0..frames
                    var lvl16: u16 = 0
                    if total > 0 {
                        lvl16 = prog * 4 / total
                    }
                    if lvl16 > 3 {
                        lvl16 = 3
                    }
                    var lvl: u8 = lvl16
                    if dir == 1 {
                        lvl = 3 - lvl                          -- fade IN reverses
                    }
                    fx.set_level(lvl)
                    if vm_scratch[c] > 0 {
                        pcr -= 3
                        return ST_YIELD
                    }
                    vm_waiting[c] = 0
                    if dir == 1 {
                        fx.set_level(0)                        -- end normal
                    } else {
                        fx.set_level(3)                        -- end black
                    }
                    return ST_CONT
                }
            }
            case OP_SHAKE {
                if VM_OP_SHAKE {
                    var frames: u8 = f8()
                    var amp: u8 = f8()
                    -- The latch decides whether this BLOCKS (the reference engine's
                    -- camera_shake_frames sets ctx->waitable and returns FALSE
                    -- until the frames run out). vm_waiting keeps the re-entry
                    -- from restarting the shake it is waiting on - the
                    -- CAM_MOVE_TO shape.
                    if vm_waiting[c] == 0 {
                        vm_waiting[c] = 1
                        player.shake_start(frames, amp)
                    }
                    if player.shake_waits() == 1 {
                        if player.shake_active() == 1 {
                            pcr -= 3        -- opcode + frames + amp
                            return ST_YIELD
                        }
                    }
                    vm_waiting[c] = 0
                    return ST_CONT
                }
            }
            case OP_SHAKE_OPTS {
                if VM_OP_SHAKE_OPTS {
                    var ax: u8 = f8()
                    var wt: u8 = f8()
                    player.set_shake_opts(ax, wt)
                    return ST_CONT
                }
            }
            case OP_PAL_SET {
                if VM_OP_PAL_SET {
                    -- Operands are always consumed (PC alignment) even with no
                    -- writer registered, the OP_MUSIC_MUTE shape.
                    -- NOT named `player`: that is the module `vm.player`,
                    -- which this same function calls, and the local shadowed
                    -- it (`Undefined identifier 'player'` at the link of the
                    -- first project to compile this arm).
                    var playr: u8 = f8()
                    var pslot: u8 = f8()
                    var plib: u8 = f8()
                    if has_pal_write == 1 {
                        g_pal_write(playr, pslot, plib)
                    }
                    return ST_CONT
                }
            }
            case OP_BKG_TILE {
                if VM_OP_BKG_TILE {
                    var bdst: u8 = f8()
                    var bsrc: u8 = f8()
                    if has_bkg_tile == 1 {
                        g_bkg_tile(cur_scene, bdst, bsrc)
                    }
                    return ST_CONT
                }
            }
            case OP_BKG_TILE_E {
                if VM_OP_BKG_TILE_E {
                    -- The computed twin: the reference engine's `tileIndex` is a
                    -- ScriptValue and a digit readout always computes it.
                    -- Out-of-bank values are the writer's problem (it owns
                    -- the bank's size), so nothing is clamped here.
                    var edst: u8 = f8()
                    var esrc: i16 = vpop()
                    if has_bkg_tile == 1 {
                        g_bkg_tile(cur_scene, edst, esrc)
                    }
                    return ST_CONT
                }
            }
            case OP_SHMUP_SCROLL {
                if VM_OP_SHMUP_SCROLL {
                    var pace: u8 = f8()
                    var dir: u8 = f8()
                    player.set_shmup_pace(pace)   -- 0 = pause the auto-scroll
                    if dir < 2 {                  -- dir 2 = keep the current direction
                        player.set_shmup_dir(dir)
                    } else if dir == 3 {          -- dir 3 = endless vertical starfield loop
                        player.set_shmup_loop(1)
                    }
                    return ST_CONT
                }
            }
            case OP_SCROLL_BG {
                if VM_OP_SCROLL_BG {
                    var vxb: u8 = f8()            -- signed bytes: 1/4-px per frame
                    var vyb: u8 = f8()
                    var vx: i16 = vxb
                    if vx > 127 { vx = vx - 256 }
                    var vy: i16 = vyb
                    if vy > 127 { vy = vy - 256 }
                    if vx == 0 {
                        if vy == 0 {
                            player.scroll_bg_off()   -- (0,0) stops + releases the camera
                        } else {
                            player.scroll_bg(vx, vy)
                        }
                    } else {
                        player.scroll_bg(vx, vy)
                    }
                    return ST_CONT
                }
            }
            case OP_CAM_MOVE_TO {
                if VM_OP_CAM_MOVE_TO {
                    var x: u8 = f8()
                    var y: u8 = f8()
                    var step: u8 = f8()
                    if vm_waiting[c] == 0 {
                        vm_waiting[c] = 1
                        player.cam_hold()       -- snapshot the current view as the pan start
                    }
                    var arrived: bool = player.cam_pan_step(x, y, step)
                    if not arrived {
                        pcr -= 4           -- op + 3 operands: pan again next frame
                        return ST_YIELD
                    }
                    vm_waiting[c] = 0
                    return ST_CONT
                }
            }
            case OP_TIMER_SET {
                if VM_OP_TIMER_SET {
                    var id: u8 = f8()
                    var period: u16 = f16()
                    var entry: u16 = f16()
                    if id < NTIMERS {
                        tmr_active[id] = 1
                        tmr_period[id] = period
                        tmr_count[id] = period
                        tmr_entry[id] = entry
                    }
                    return ST_CONT
                }
            }
            case OP_TIMER_STOP {
                if VM_OP_TIMER_STOP {
                    var id: u8 = f8()
                    if id < NTIMERS {
                        tmr_active[id] = 0
                    }
                    return ST_CONT
                }
            }
            case OP_INPUT_ATTACH {
                if VM_OP_INPUT_ATTACH {
                    var raw: u8 = f8()
                    var btn: u8 = raw & 0x7F
                    var over: u8 = raw >> 7     -- bit 7 = CONSUME the button
                    var entry: u16 = f16()
                    -- the slot ALREADY bound to btn wins over a free one (a
                    -- re-attach REPLACES): taking the first slot that was
                    -- free-or-bound let a free slot below the bound one win,
                    -- leaving two live slots on one button, so every press
                    -- spawned the script twice
                    var slot: u8 = 255
                    var i: u8 = 0
                    while i < NIN {
                        if in_active[i] == 1 and in_btn[i] == btn {
                            slot = i
                        }
                        i += 1
                    }
                    if slot == 255 {
                        i = 0
                        while i < NIN {
                            if slot == 255 and in_active[i] == 0 {
                                slot = i
                            }
                            i += 1
                        }
                    }
                    if slot != 255 {
                        in_active[slot] = 1
                        in_btn[slot] = btn
                        in_entry[slot] = entry
                        in_over[slot] = over
                        in_prev[slot] = btn_held(btn)   -- mask a button already held (the
                                                        -- triggering press); a fresh press fires
                        publish_consume()
                    }
                    return ST_CONT
                }
            }
            case OP_INPUT_DETACH {
                if VM_OP_INPUT_DETACH {
                    var btn: u8 = f8() & 0x7F
                    var i: u8 = 0
                    while i < NIN {
                        if in_active[i] == 1 {
                            if in_btn[i] == btn {
                                in_active[i] = 0
                                in_over[i] = 0
                            }
                        }
                        i += 1
                    }
                    publish_consume()
                    return ST_CONT
                }
            }
            case OP_SAVE {
                if VM_OP_SAVE {
                    if has_save_pack == 1 {
                        g_save_persist()
                    }
                    return ST_CONT
                }
            }
            case OP_LOAD {
                if VM_OP_LOAD {
                    if has_save_pack == 1 {
                        g_save_restore()
                    }
                    return ST_CONT
                }
            }
            -- The two arms are guarded by their OWN VM_OP_* flags, not by
            -- VM_SAVE_SLOTS: that is the dispatch-pruning contract every arm
            -- keeps (`isa_tests` pins it), and it costs nothing here because
            -- VM_SAVE_SLOTS is the OR of these two and the state - so whenever
            -- either arm survives, the globals it reads exist.
            --
            -- CLEAR the latched slot's SIGNATURE, not its bytes - the reference VM's
            -- `data_clear` writes a zero over the signature and stops, so the
            -- slot reads as empty and its payload is simply never trusted
            -- again. Both arms guard `has_save_slots` rather than
            -- `has_save_pack`: a shell may register the save pack without the
            -- slot seam (every one that exists today does).
            case OP_DATA_CLEAR {
                if VM_OP_DATA_CLEAR {
                    if has_save_slots == 1 {
                        g_save_clear()
                    }
                    return ST_CONT
                }
            }
            -- PEEK one heap cell out of the latched slot WITHOUT loading it.
            -- The operands are fetched whether or not the pack is wired -
            -- the instruction stream has to advance either way.
            case OP_DATA_PEEK {
                if VM_OP_DATA_PEEK {
                    var psrc: u8 = f8()
                    var pdst: u8 = f8()
                    if has_save_slots == 1 {
                        g_save_peek(psrc, pdst)
                    }
                    return ST_CONT
                }
            }
            case OP_SFX {
                if VM_OP_SFX {
                    var id: u8 = f8()
                    if has_snd == 1 {
                        g_sfx(id)
                    }
                    return ST_CONT
                }
            }
            case OP_TONE {
                if VM_OP_TONE {
                    var freq: u16 = f16()
                    var frames: u8 = f8()
                    if has_snd == 1 {
                        g_tone(freq, frames)
                    }
                    return ST_CONT
                }
            }
            case OP_SND_STOP {
                if VM_OP_SND_STOP {
                    if has_snd == 1 {
                        g_snd_stop()
                    }
                    return ST_CONT
                }
            }
            case OP_MUSIC_PLAY {
                if VM_OP_MUSIC_PLAY {
                    var entry: u16 = f16()
                    if exempt_ctx != 255 {
                        kill(exempt_ctx)             -- replace any current song
                    }
                    exempt_ctx = spawn(entry)        -- the song thread loops tones forever
                    return ST_CONT
                }
            }
            case OP_MUSIC_STOP {
                if VM_OP_MUSIC_STOP {
                    if exempt_ctx != 255 {
                        kill(exempt_ctx)
                        exempt_ctx = 255
                    }
                    if has_music_drv == 1 {
                        g_music_drv_stop()          -- stop a driven multi-channel song
                    }
                    if has_mvoice == 1 {
                        g_mstop()                   -- silence the MUSIC channel (own voice)
                    } else if has_snd == 1 {
                        g_snd_stop()                -- fallback: music shared the beep channel
                    }
                    return ST_CONT
                }
            }
            case OP_MUSIC_TONE {
                if VM_OP_MUSIC_TONE {
                    var freq: u16 = f16()
                    var frames: u8 = f8()
                    if has_mvoice == 1 {
                        g_mtone(freq, frames)       -- the music voice (own channel)
                    } else if has_snd == 1 {
                        g_tone(freq, frames)        -- fallback: play on the beep channel
                    }
                    return ST_CONT
                }
            }
            case OP_MUSIC_SONG {
                if VM_OP_MUSIC_SONG {
                    var song: u8 = f8()
                    if has_music_drv == 1 {
                        g_music_song(song)          -- start the driven multi-channel song
                    }
                    return ST_CONT
                }
            }
            case OP_MUSIC_PAUSE {
                if VM_OP_MUSIC_PAUSE {
                    if has_music_ctl == 1 {
                        g_music_pause()             -- silence the driven song, keep its position
                    }
                    return ST_CONT
                }
            }
            case OP_MUSIC_RESUME {
                if VM_OP_MUSIC_RESUME {
                    if has_music_ctl == 1 {
                        g_music_resume()            -- resume the paused song
                    }
                    return ST_CONT
                }
            }
            case OP_MUSIC_MUTE {
                if VM_OP_MUSIC_MUTE {
                    var mask: u8 = f8()             -- always consume the operand (PC alignment)
                    if has_music_ctl == 1 {
                        g_music_mute(mask)          -- persistent per-channel MUSIC mute mask
                    }
                    return ST_CONT
                }
            }
            case OP_PROJ_LAUNCH {
                if VM_OP_PROJ_LAUNCH {
                    var x: u16 = f16()
                    var y: u16 = f16()
                    var vx8: u8 = f8()
                    var vy8: u8 = f8()
                    var tile: u8 = f8()
                    var life: u8 = f8()
                    if has_proj == 1 {
                        var xi: i16 = x
                        var yi: i16 = y
                        var vx: i16 = vx8       -- u8 operand carries an i8 velocity
                        if vx > 127 {
                            vx = vx - 256
                        }
                        var vy: i16 = vy8
                        if vy > 127 {
                            vy = vy - 256
                        }
                        var lifew: u16 = life
                        g_proj_launch(xi, yi, vx, vy, tile, lifew, MASK_DEFAULT)
                    }
                    return ST_CONT
                }
            }
            case OP_PROJ_LAUNCH_E {
                if VM_OP_PROJ_LAUNCH_E {
                    var tile: u8 = f8()
                    var life: u8 = f8()
                    var vy: i16 = vpop()        -- pushed x,y,vx,vy: vy is on top
                    var vx: i16 = vpop()
                    var y: i16 = vpop()
                    var x: i16 = vpop()
                    if has_proj == 1 {
                        var lifew: u16 = life
                        g_proj_launch(x, y, vx, vy, tile, lifew, MASK_DEFAULT)
                    }
                    return ST_CONT
                }
            }
            case OP_PROJ_LAUNCH_M {
                if VM_OP_PROJ_LAUNCH_M {
                    var x: u16 = f16()
                    var y: u16 = f16()
                    var vx8: u8 = f8()
                    var vy8: u8 = f8()
                    var tile: u8 = f8()
                    var life: u8 = f8()
                    var mask: u8 = f8()
                    if has_proj == 1 {
                        var xi: i16 = x
                        var yi: i16 = y
                        var vx: i16 = vx8       -- u8 operand carries an i8 velocity
                        if vx > 127 {
                            vx = vx - 256
                        }
                        var vy: i16 = vy8
                        if vy > 127 {
                            vy = vy - 256
                        }
                        var lifew: u16 = life
                        g_proj_launch(xi, yi, vx, vy, tile, lifew, mask)
                    }
                    return ST_CONT
                }
            }
            case OP_PROJ_LAUNCH_EM {
                if VM_OP_PROJ_LAUNCH_EM {
                    var tile: u8 = f8()
                    var life: u8 = f8()
                    var mask: u8 = f8()
                    var vy: i16 = vpop()        -- pushed x,y,vx,vy: vy is on top
                    var vx: i16 = vpop()
                    var y: i16 = vpop()
                    var x: i16 = vpop()
                    if has_proj == 1 {
                        var lifew: u16 = life
                        g_proj_launch(x, y, vx, vy, tile, lifew, mask)
                    }
                    return ST_CONT
                }
            }
            case OP_PROJ_LAUNCH_A {
                if VM_OP_PROJ_LAUNCH_A {
                    var tile: u8 = f8()
                    var life: u8 = f8()
                    var mask: u8 = f8()
                    var speed: i16 = vpop()   -- pushed x,y,angle,speed
                    var angi: i16 = vpop()
                    var y: i16 = vpop()
                    var x: i16 = vpop()
                    if has_proj_angle == 1 {
                        var ang: u8 = angi & 255
                        var lifew: u16 = life
                        g_proj_angle(x, y, ang, speed, tile, lifew, mask)
                    }
                    return ST_CONT
                }
            }
            case OP_PROJ_ANIM {
                if VM_OP_PROJ_ANIM {
                    var frames: u8 = f8()
                    var period: u8 = f8()
                    var stride: u8 = f8()
                    if has_proj_anim == 1 {
                        g_proj_anim(frames, period, stride)
                    }
                    return ST_CONT
                }
            }
            case OP_A_SET_GROUP {
                if VM_OP_A_SET_GROUP {
                    var i: u8 = resolve_actor(f8())
                    var g: u8 = f8()
                    actor.set_group(i, g)       -- faction (F3.5): projectile mask filtering
                    return ST_CONT
                }
            }
            case OP_A_SET_HP {
                if VM_OP_A_SET_HP {
                    var i: u8 = resolve_actor(f8())
                    var hp: u16 = f16()
                    actor.set_hp(i, hp)         -- per-actor HP (multi-HP foes)
                    return ST_CONT
                }
            }
            case OP_A_DAMAGE {
                if VM_OP_A_DAMAGE {
                    var i: u8 = resolve_actor(f8())
                    var amt: u16 = f16()
                    actor.damage(i, amt)        -- subtract, clamped at 0
                    return ST_CONT
                }
            }
            case OP_A_SET_DIR {
                if VM_OP_A_SET_DIR {
                    var i: u8 = resolve_actor(f8())
                    var d: u8 = f8()
                    actor.set_dir(i, d & 3)     -- facing 0 dn / 1 up / 2 lt / 3 rt
                    return ST_CONT
                }
            }
            case OP_A_SET_COLLISION {
                if VM_OP_A_SET_COLLISION {
                    var i: u8 = resolve_actor(f8())
                    -- the operand is already 0/1 from the lowering, and the
                    -- test reads it as != 0, so no normalising here (this arm
                    -- is RESIDENT image on GB/SMS - vm.core cannot bank).
                    actor.set_collision(i, f8())
                    return ST_CONT
                }
            }
            case OP_A_SET_FRAME {
                if VM_OP_A_SET_FRAME {
                    var i: u8 = resolve_actor(f8())
                    actor.set_frame(i, f8())    -- vm.canim draws it next tick
                    return ST_CONT
                }
            }
            case OP_A_SET_FRAME_E {
                if VM_OP_A_SET_FRAME_E {
                    var i: u8 = resolve_actor(f8())
                    -- the clamp lives in vm.actor (which banks; core cannot)
                    actor.set_frame16(i, vpop())
                    return ST_CONT
                }
            }
            case OP_A_SET_ANIM_SPEED {
                if VM_OP_A_SET_ANIM_SPEED {
                    var i: u8 = resolve_actor(f8())
                    actor.set_anim_speed(i, f8())
                    return ST_CONT
                }
            }
            case OP_PLAYER_BOUNCE {
                if VM_OP_PLAYER_BOUNCE {
                    player.bounce(f8())
                    return ST_CONT
                }
            }
            case OP_PLAYER_KNOCKBACK {
                if VM_OP_PLAYER_KNOCKBACK {
                    player.knockback()
                    return ST_CONT
                }
            }
            case OP_A_SET_ANIM_STATE {
                if VM_OP_A_SET_ANIM_STATE {
                    var i: u8 = resolve_actor(f8())
                    actor.set_anim_state(i, f8())   -- vm.canim draws it next tick
                    return ST_CONT
                }
            }
            case OP_A_CLEAR_ANIM_STATE {
                if VM_OP_A_CLEAR_ANIM_STATE {
                    actor.clear_anim_state(resolve_actor(f8()))
                    return ST_CONT
                }
            }
            case OP_THREAD_STOP {
                if VM_OP_THREAD_STOP {
                    -- The handle cell is LIVENESS, so find the live context
                    -- bound to it. None is a no-op (a finished handle). The
                    -- executing thread ends through the central ST_END path,
                    -- which runs the same cleanup kill() does.
                    var hs: u8 = f8()
                    if stop_handle(hs, c) == 1 {
                        vm_active[c] = 0
                        return ST_END
                    }
                    return ST_CONT
                }
            }
            case OP_A_SET_BOX {
                if VM_OP_A_SET_BOX {
                    var bi: u8 = resolve_actor(f8())
                    var bw: u8 = f8()
                    var bh: u8 = f8()
                    var bx: u8 = f8()
                    actor.set_box(bi, bw, bh, bx, f8())
                    return ST_CONT
                }
            }
            case OP_A_GET_DIR {
                if VM_OP_A_GET_DIR {
                    var gi: u8 = resolve_actor(f8())
                    get_dir_into(gi, f8())
                    return ST_CONT
                }
            }
            case OP_PROJ_GROUP {
                if VM_OP_PROJ_GROUP {
                    var pg: u8 = f8()
                    if has_proj_group == 1 {
                        g_proj_group(pg)
                    }
                    return ST_CONT
                }
            }
            case OP_PLAYER_VISIBLE {
                if VM_OP_PLAYER_VISIBLE {
                    -- operand is VISIBLE; the pack's flag is HIDDEN
                    var on: u8 = f8()
                    if has_pvis == 1 {
                        g_pvis(1 - on)
                    }
                    return ST_CONT
                }
            }
            case OP_A_VISIBLE {
                if VM_OP_A_VISIBLE {
                    -- The same DRAW flag on a pool actor. Deliberately a
                    -- second arm rather than a widened OP_PLAYER_VISIBLE: with
                    -- dispatch pruning an unused arm compiles to nothing,
                    -- while a shared op's extra operand is paid by every
                    -- project that uses the op at all (measured: merging them
                    -- cost the reference-engine sample conversion 31 B of bank 0 for a feature it does
                    -- not use). No seam - vm.core already imports vm.actor.
                    -- `vis`, not `on`: the PLAYER_VISIBLE arm above already
                    -- names a local `on` in this same switch.
                    var i: u8 = resolve_actor(f8())
                    var vis: u8 = f8()
                    actor.set_visible(i, vis)
                    return ST_CONT
                }
            }
            case OP_TEXT_SPEED {
                if VM_OP_TEXT_SPEED {
                    -- the reference engine's text_draw_speed, global exactly as theirs
                    -- is: it persists across boxes and scenes until set
                    -- again. The mask is COMPUTED ((1 << (idx-1)) - 1, their
                    -- ui_time_masks row) rather than read from a const
                    -- table, so no table sits resident for every program.
                    tw_idx = f8() & 7
                    tw_ff_ok = f8()
                    tw_mask = 0
                    if tw_idx > 1 {
                        var k: u8 = tw_idx - 1
                        var m: u8 = 1
                        while k > 0 {
                            m = m << 1
                            k -= 1
                        }
                        tw_mask = m - 1
                    }
                    return ST_CONT
                }
            }
            case OP_TEXT_BLIP {
                if VM_OP_TEXT_BLIP {
                    blip_freq = f16()
                    blip_len = f8()
                    return ST_CONT
                }
            }
            case OP_A_START_UPDATE {
                if VM_OP_A_START_UPDATE {
                    var su: u8 = resolve_actor(f8())
                    if has_start_update == 1 {
                        g_start_update(su)
                    }
                    return ST_CONT
                }
            }
            case OP_A_STOP_UPDATE {
                if VM_OP_A_STOP_UPDATE {
                    -- The thread handle lives in vm.entity, which vm.core does
                    -- NOT import (a game with no attached slot scripts must
                    -- link none of it), so this goes through a seam. A
                    -- guard that has finished patrolling, an NPC frozen for a
                    -- cutscene: the reference engine's EVENT_ACTOR_STOP_UPDATE.
                    var i: u8 = resolve_actor(f8())
                    if has_stop_update == 1 {
                        g_stop_update(i)
                    }
                    return ST_CONT
                }
            }
            case OP_A_PUSH {
                if VM_OP_A_PUSH {
                    -- Shove an actor away from the player: whole tiles along the
                    -- PLAYER's facing, stopping before the first solid cell, then
                    -- handed to the native auto-move so the block SLIDES. GB
                    -- Studio's push is waitable; this one is not, because a push
                    -- lives in an On Interact script that holds the UI latch --
                    -- blocking there would freeze the game for the slide. The
                    -- visible result is the same.
                    -- The walk itself lives in vm.ACTOR, not here: vm.core is
                    -- resident image on GB/SMS and cannot bank, and the tile
                    -- walk is ~600 B of it. In vm.actor the same code banks
                    -- with the rest of the pack (measured: 608 B -> 34 B of
                    -- bank 0 on the reference-engine conversion).
                    var i: u8 = resolve_actor(f8())
                    actor.push(i, f8())
                    return ST_CONT
                }
            }
            case OP_A_EMOTE {
                if VM_OP_A_EMOTE {
                    -- WAITABLE, like the reference engine's (its vm_actor_emote sets
                    -- `waitable` and rewinds until the 60 frames are up), so a
                    -- script can emote and THEN speak. vm_waiting[c] is the
                    -- once-only latch -- without it the arm would re-start the
                    -- emote every frame and never finish.
                    -- PLAYER_ACTOR passes through UNRESOLVED (resolve_actor
                    -- clamps an out-of-pool id to 0, which would hang the
                    -- bubble over whoever is in slot 0); vm.emote reads the
                    -- player's own position for it.
                    var raw: u8 = f8()
                    var i: u8 = raw
                    if raw != PLAYER_ACTOR {
                        i = resolve_actor(raw)
                    }
                    var id: u8 = f8()
                    if has_emote == 1 {
                        if vm_waiting[c] == 0 {
                            vm_waiting[c] = 1
                            g_emote_show(i, id)
                        }
                        if g_emote_active() == 1 {
                            pcr -= 3        -- rewind opcode + 2 operands
                            return ST_YIELD
                        }
                        vm_waiting[c] = 0
                    }
                    return ST_CONT
                }
            }
            case OP_HUD_SHOW {
                if VM_OP_HUD_SHOW {
                    var on: u8 = f8()
                    if on != 0 {
                        hud_visible = 1
                        if VM_HUD_RESHOW {
                            hud_band()
                        }
                    } else {
                        hud_visible = 0
                        if VM_HUD_RESHOW {
                            if box_open == 0 {
                                if menu_open == 0 {
                                    text.to_bkg()   -- hide the band (GB window)
                                }
                            }
                        }
                    }
                    return ST_CONT
                }
            }
            case OP_SET_PLAYER_HIT {
                if VM_OP_SET_PLAYER_HIT {
                    var entry: u16 = f16()
                    player_hit_entry = entry    -- run when a shot masking the player hits it
                    has_player_hit = 1
                    return ST_CONT
                }
            }
            case OP_MUSIC_ROUTINE {
                if VM_OP_MUSIC_ROUTINE {
                    -- `& 3` is the reference VM's own mask (vm_music_routine), so an
                    -- out-of-range slot wraps there and wraps here.
                    var slot: u8 = f8() & 3
                    var rt: u16 = f16()
                    music_rt_entry[slot] = rt
                    music_rt_on |= 1 << slot
                    -- "no instance yet", EXPLICITLY. BSS leaves the shadow at
                    -- context 0 / generation 0, and the busy gate would then
                    -- be asking `alive_gen(0, 0)` on the first fire - which
                    -- answers correctly today only because `spawn` increments
                    -- the generation BEFORE use, so no live context can be at
                    -- 0. That is a true fact about another function, not a
                    -- contract this one should lean on.
                    music_rt_ctx[slot] = 255
                    return ST_CONT
                }
            }
            default {
                vm_active[c] = 0        -- unknown opcode: stop the runaway thread
                return ST_END
            }
        }
        -- Reached only when a case body was PRUNED: every arm above is wrapped in
        -- `if VM_OP_<NAME>`, and the build sets those flags from the opcodes this
        -- program's bytecode actually contains (mosaik8_build._vm_dispatch_defines),
        -- so an opcode the blob cannot hold compiles to an EMPTY case. Falling out
        -- of the switch here must therefore behave exactly like `default` above --
        -- stop the thread rather than run on with a desynced pc. (With no defines
        -- every arm is kept and this is unreachable, as it was before.)
        vm_active[c] = 0
        return ST_END
    }

    -- Tear down any open UI + the per-scene timers/input attachments. Called when
    -- a scene change is serviced (a CHANGE_SCENE op OR a `load` restore, both of
    -- which raise a pending exception): the old room's dialogue box / menu, its timers, and
    -- its button attachments must NOT leak into the new room. Without this a scene
    -- change raised WHILE a box/menu is open (a timer/other thread firing it) left
    -- the box overlaid + input-blocking in the new room with a stale id, and the
    -- old room's timers/attachments kept spawning threads there (a `load` from a
    -- pause menu is the sharpest case -- the whole pre-load UI/timer state was
    -- carried onto the freshly restored heap). Threads are torn down by the game's
    -- own load_room (entity.reset); a held cutscene lock is released by the aborting
    -- thread's ST_END path. Mirrors the boot() reset minus the thread pool.
    local function reset_scene_ui() {
        box_open = 0
        menu_open = 0
        -- The two one-shot UI latches go with the room that armed them (spec
        -- Â§5.3 ids 30/31: "a scene load clears an unconsumed latch"). A script
        -- that armed one and then changed scene before its MENU / UI_TEXT ran
        -- used to leave it standing, and the NEXT room's first menu was
        -- B-cancellable, or its first text box closed ITSELF after n frames and
        -- ignored the pad -- a dialogue that simply vanished. `box_hold_live`
        -- is the OPEN box's countdown and dies with the box it belonged to.
        if VM_ST_MENU_CANCEL {
            menu_cancel = 0         -- a latch armed for a menu the room change killed
        }
        if VM_ST_BOX_HOLD {
            box_hold = 0            -- ... and one armed for a box that never opened
            box_hold_live = 0
        }
        if platform == "sms" or platform == "gamegear" {
            ui_stage = 0        -- the room is going away: abandon staged UI work
            ui_close = 0        -- (load_room repaints and re-places everything)
            ui_col = 0
        }
        if VM_OP_TEXT_SPEED {
            tw_run = 0          -- a scene change mid-reveal (a timer's box):
        }                       -- the flag must not gate the NEXT box's dismiss
        ui_owner = 255
        ui_redraw = 0
        text.to_bkg()               -- hide the GB window overlay; no-op elsewhere
        if VM_HUD_RESHOW {
            hud_band()              -- the HUD band survives the room change
        }
        if box_cut == 1 {
            text.win_sprite_cut(0)   -- sprites back over the scene
            if platform == "sms" or platform == "gamegear" {
                ui_sprite_cut(255)   -- the band is the scene again
            }
        }
        for i in 0..NTIMERS {
            tmr_active[i] = 0
            tmr_ctx[i] = 255        -- the old room's instances are being killed;
        }                           -- a fresh room must not inherit a busy gate
        for i in 0..NIN {
            in_active[i] = 0
            in_over[i] = 0
            in_ctx[i] = 255
        }
        publish_consume()           -- ... and give the new room's player its
        --                             buttons back (an override does not leak)
        has_player_hit = 0          -- the new scene's On Init re-registers it (F3.5)
        -- ...and the music routines with it: the reference VM calls music_init_events(FALSE)
        -- on every CHANGE_SCENE, which clears the scripts AND their handles.
        if VM_OP_MUSIC_ROUTINE {
            music_rt_on = 0
        }
        if VM_ST_SCENE_UPDATE_PAUSED {
            scene_paused = 0            -- core.c clears pause_state_update per scene
        }
    }

    -- Run one thread up to QUANT instructions or until it yields/ends.
    --
    -- This is where the slice registers are loaded and stored (see their note):
    -- `pcr`/`spr` are the thread's live pc/stack depth for as long as the slice
    -- runs, and the arrays are re-synced before EVERY return -- the yield path,
    -- the QUANT-exhausted path and the thread-death path alike.
    bank(0) local function run_context(c: u8) {
        var n: u8 = 0
        pcr = vm_pc[c]
        spr = vm_sp[c]
        sbase = c * VM_STACK          -- u8: c < 8, so at most 56
        slice_live = 1
        var saved_bank: u8 = 0
        if has_code_window == 1 {
            if code_banked == 1 {
                saved_bank = g_code_enter()     -- map the blob's bank for the slice
            }
        }
        while n < QUANT {
            var st: u8 = step(c)
            if st != ST_END {
                if vm_active[c] == 0 {
                    -- the op KILLED ITS OWN THREAD through kill() (which ran
                    -- the §11 cleanup already): the slice ends here. Nothing
                    -- can have re-used the context (alloc_ctx skips it while
                    -- the slice is live), so the write-back is only hygiene.
                    vm_pc[c] = pcr
                    vm_sp[c] = spr
                    slice_live = 0
                    if code_banked == 1 { g_code_leave(saved_bank) }
                    return
                }
            }
            if st == ST_END {
                -- CENTRAL thread-death cleanup. EVERY in-step death path (STOP,
                -- RET with no caller, CHANGE_SCENE, the unknown-op bail) funnels
                -- through here, so a dying thread can never strand a cutscene
                -- LOCK (a `lock ... stop` used to freeze the game forever -- the
                -- scheduler then ran nobody) or leave exempt_ctx pointing at a
                -- context spawn() will reuse (the next MUSIC_PLAY/STOP would
                -- kill that unrelated thread). Under a lock only the owner runs,
                -- so the owner check is exact. kill() mirrors this for the
                -- external teardown path.
                if vm_lockcount > 0 {
                    if c == vm_lockowner {
                        vm_lockcount = 0
                        vm_lockowner = 0
                    }
                }
                if c == exempt_ctx {
                    exempt_ctx = 255
                }
                if c == ui_owner {          -- a thread that dies owning the box/menu
                    box_open = 0            -- releases the UI latch, so it never
                    menu_open = 0          -- sticks busy (and the Lynx present hook
                    ui_owner = 255         -- stops compositing a dead thread's menu)
                }
                if vm_handle[c] < VM_HEAP {  -- Â§11.4, the join mechanism: the
                    heap[vm_handle[c]] = 0   -- watched cell reads 0 = done
                }
                vm_handle[c] = 255
                vm_hnext[c] = 255       -- a pending HANDLE_NEXT dies with it
                event_release(c)        -- a timer/input slot waiting on this
                                        -- instance may fire again (busy gate)
                vm_pc[c] = pcr          -- the thread is dead, but a re-used context
                vm_sp[c] = spr          -- must not inherit a stale pc/depth
                slice_live = 0
                if code_banked == 1 { g_code_leave(saved_bank) }
                return
            }
            if st != ST_CONT {
                vm_pc[c] = pcr          -- yielded (IDLE / a waitable re-entry):
                vm_sp[c] = spr          -- resume here next frame
                slice_live = 0
                if code_banked == 1 { g_code_leave(saved_bank) }
                return
            }
            n += 1
        }
        vm_pc[c] = pcr                  -- QUANT exhausted: resume mid-script
        vm_sp[c] = spr
        slice_live = 0
        if code_banked == 1 { g_code_leave(saved_bank) }
    }

    -- Round-robin the pool. Under a lock, only the locking thread runs -- every
    -- other thread (and so every native MOVE_TO in flight) freezes.
    bank(0) local function run_scripts() {
        for c in 0..VM_CTXS {
            if vm_active[c] == 1 {
                if vm_lockcount > 0 {
                    if c == vm_lockowner {
                        run_context(c)
                    } else if c == exempt_ctx {
                        run_context(c)      -- the script-driven song keeps advancing
                                            -- under a cutscene lock, matching the
                                            -- multi-channel driver (g_music_update,
                                            -- which run() ticks outside the lock gate)
                                            -- -- so cutscene music never hangs on its
                                            -- last tone
                    }
                } else {
                    run_context(c)
                }
            }
        }
    }

    -- Tick every active timer; fire its script thread on period rollover.
    bank(0) local function tick_timers() {
        for i in 0..NTIMERS {
            if tmr_active[i] == 1 {
                if tmr_count[i] > 0 {
                    tmr_count[i] -= 1
                }
                if tmr_count[i] == 0 {
                    tmr_count[i] = tmr_period[i]
                    -- the busy gate: a tick while the last instance still runs
                    -- fires nothing (reference-engine timers_update's SCRIPT_TERMINATED
                    -- check). A full pool (spawn = 255) stays free and retries.
                    if tmr_ctx[i] == 255 {
                        tmr_ctx[i] = spawn(tmr_entry[i])
                    }
                }
            }
        }
    }

    -- Map a portable BTN_* id to input.held (so the bytecode stays console-neutral).
    bank(0) local function btn_held(id: u8) -> u8 {
        if id == BTN_A {
            if input.held(INPUT_A) { return 1 }
        } else if id == BTN_B {
            if input.held(INPUT_B) { return 1 }
        } else if id == BTN_START {
            if input.held(INPUT_START) { return 1 }
        } else if id == BTN_SELECT {
            if input.held(INPUT_SELECT) { return 1 }
        } else if id == BTN_UP {
            if input.held(INPUT_UP) { return 1 }
        } else if id == BTN_DOWN {
            if input.held(INPUT_DOWN) { return 1 }
        } else if id == BTN_LEFT {
            if input.held(INPUT_LEFT) { return 1 }
        } else if id == BTN_RIGHT {
            if input.held(INPUT_RIGHT) { return 1 }
        }
        return 0
    }

    -- Fire each attached script on its button's rising edge (like a timer, but
    -- input-triggered). Called each UNLOCKED frame (a cutscene freezes gameplay).
    bank(0) local function tick_input_attach() {
        for i in 0..NIN {
            if in_active[i] == 1 {
                var h: u8 = btn_held(in_btn[i])
                if h == 1 {
                    if in_prev[i] == 0 {
                        -- the busy gate (reference-engine events_update): a press while
                        -- the last spawned instance still runs is IGNORED - a
                        -- shoot script's cooldown `wait` really is a fire-rate
                        -- limit, not something a second press slips past.
                        if in_ctx[i] == 255 {
                            in_ctx[i] = spawn(in_entry[i])
                        }
                    }
                }
                in_prev[i] = h
            }
        }
    }

    -- SMS/GG: THE SNAP AND THE SPRITES MUST MOVE IN THE SAME DISPLAY FRAME.
    -- Their box is plotted into the scene's own name table, so text.to_window
    -- SNAPS the hardware scroll down to a tile on open and to_bkg restores it
    -- on close - and the plots around those calls span SEVERAL display frames
    -- inside ONE game frame (the border plus a page of glyphs on open; the
    -- close repaint re-seeds the whole streamed ring). The pass that
    -- re-places sprites runs at the END of the game frame, so every sprite
    -- stood 0..7 px off the ground for the entire draw (measured on the
    -- the SMS/GG sample conversion's tall NPC: 9 display frames at open, 2 at close), and
    -- the per-vblank SAT flush can catch the shadow between one metasprite's
    -- column writes - the reported "the NPC splits in half". So every site
    -- that moves the scroll calls this in the SAME display frame: publish the
    -- freeze (vm.player's draw camera keys on it), then re-place the player,
    -- the actor pool and the emote bubble against the scroll as it now is.
    -- The later per-frame publish and render passes then find nothing to do.
    -- Defined AND called only on the two consoles whose box lives in the
    -- scene map; everything else folds this away entirely.
    if platform == "sms" or platform == "gamegear" {
    -- ONE GAME FRAME MUST BE ONE DISPLAY FRAME (the reference VM's process_VM invariant:
    -- every iteration ends in wait_vbl_done, and ui_update draws the box a
    -- slice per frame rather than all of it inside one script step). Ours drew
    -- it all inside OP_UI_TEXT, so a single game frame ran LONG - measured on
    -- the SMS/GG sample conversion with a per-display-frame RAM probe: border 3, glyph page
    -- 6, and the box-close room repaint TWENTY-FOUR display frames, ~35 in one
    -- game frame for a page flip. Nothing moved, no input was read and the song
    -- had to be hand-pumped mid-op (the `music_pump()` at the close site) for
    -- the whole ~580 ms.
    --
    -- So the work is STAGED: each stage does one slice and yields, and the frame
    -- loop presents in between. `ui_stage` walks the OPEN (border, then text);
    -- `ui_close` walks the CLOSE (clear, repaint, restore). Both are SMS/GG-only
    -- - the GB family draws its box on the window layer and never repaints the
    -- scene, so it keeps the single-step path and stays byte-identical.
    const UI_RING_COLS: u8 = 32       -- the hardware tilemap ring the streamers own
    -- COLUMNS PER SLICE. The whole refill is ~24 display frames; slicing it
    -- costs a little more in total (per-slice call + gather setup) and the
    -- camera is FROZEN for the length of the walk, so this trades smoothness
    -- against how long the game is held. Measured on that NPC's box:
    -- 2 cols/frame = 16 slices = 43 display frames of teardown; 4 = 8 slices
    -- and about 30, which is the pre-slicing cost with the frames still short.
    const UI_COLS_PER_FRAME: u8 = 4
    var ui_stage: u8            -- 0 = idle, 1 = border owed, 2 = text owed
    var ui_close: u8            -- 0 = idle, 1 = clear owed, 2 = repaint, 3 = restore
    var ui_col: u8              -- the repaint's column cursor while ui_close == 2

    -- ARM OR LIFT THE BOX'S SPRITE CUT, with the two render gates dropped.
    --
    -- `sprite.cut_y` has no hardware behind it on these consoles - there is no
    -- raster sprite disable - so it is a FILTER inside `sprite.move`, and it
    -- changes nothing until something re-places a sprite. Both passes that
    -- would are gated on their own inputs being unchanged - vm.actor on the
    -- CAMERA (`rq_ok`) and then again per slot on the POSITION (`a_lpok`),
    -- vm.player on the position (`pmok`) - and the camera is FROZEN for
    -- exactly as long as the box is up. So a still NPC
    -- kept its OAM position and drew over the text, and the cut applied only
    -- to whatever happened to move - which is why the feature read as working
    -- in a scene with a walking actor in it and did nothing in the town room.
    --
    -- The cut is an input to those passes that neither of them can see, so the
    -- pairing lives here, at the one place it changes. Both directions: on the
    -- LIFT the latches are just as stale, and there the gate is not merely
    -- late - a close whose scroll was already tile aligned re-places nothing
    -- at all, and the pool would stay parked for the rest of the scene.
    local function ui_sprite_cut(y: u8) {
        sprite.cut_y(y)
        actor.render_dirty()
        player.draw_dirty()
    }

    local function ui_snap_sprites(on: u8) {
        if has_ui_freeze == 1 {
            g_ui_freeze(on)
        }
        if has_player == 1 {
            g_pdraw()
        }
        actor.render(lock_flag())
        if has_emote == 1 {
            g_emote_update()
        }
        if has_proj == 1 {
            -- A shot in flight is placed against the same camera as everything
            -- else, so it has to be re-placed with them or it keeps the
            -- pre-snap position for the frames the box is opening.
            g_proj_render()
        }
    }
    }

    -- Sample input + service the textbox (A-edge dismiss).
    if platform == "sms" or platform == "gamegear" {
    -- ONE SLICE of a staged box teardown (see ui_stage): the clear, the
    -- room repaint and the scroll restore become a frame each, instead of
    -- the ~26 display frames they used to cost in the single frame the
    -- dismiss landed in.
    local function ui_close_step() {
        -- One slice of a staged CLOSE per frame (see ui_stage). Input is
        -- still blocked here (in_block is released by the last stage), so
        -- skipping the sampling below costs nothing.
        if ui_close != 0 {
            if ui_close == 1 {
                ui_close = 2
                -- THE CLEAR IS THE FALLBACK, NOT THE FIRST STEP. Stage 2
                -- rewrites every cell of every ring column, the box's own
                -- rows included (engine.scroll's `put` writes all s_rows, and
                -- the painted arm runs a whole scenes.paint), so clearing
                -- first only fills the band with the box's PAPER and leaves
                -- the room to grow back into it from the left - which is the
                -- reported "the box does not disappear, the background
                -- overdraws it left to right". Measured on vm-uiscroll GG:
                -- 46 display frames from the dismiss to the room, the whole
                -- of it a paper-coloured band retreating a column at a time.
                --
                -- It is still right when NEITHER seam is registered - then
                -- nothing else would ever remove the box - and that arm keeps
                -- its own frame. With a seam we fall THROUGH into stage 2 in
                -- this same call, so the close also starts one frame sooner.
                if has_redraw_rows == 0 and has_redraw_cols == 0 and has_redraw == 0 {
                    if text.window_active() == 0 {
                        text.clear_area(0, box_row(), SCREEN_COLS, box_h)
                    }
                    return
                }
            }
            if ui_close == 2 {
                -- THE BAND FIRST, when the shell registered one: the box wrote
                -- `box_h` rows and nothing else, so repainting those rows is
                -- the whole repair and it fits in ONE slice. Measured on
                -- vm-uiscroll GG, that is the difference between a teardown
                -- you watch and one you do not.
                if has_redraw_rows == 1 {
                    g_redraw_rows(box_row(), box_h)
                    ui_close = 3
                    return
                }
                if has_redraw_cols == 1 {
                    -- UI_COLS_PER_FRAME columns per frame until the ring is
                    -- whole again. The whole refill is ~24 display frames;
                    -- a slice this size is about one, which is the point.
                    g_redraw_cols(ui_col, UI_COLS_PER_FRAME)
                    ui_col += UI_COLS_PER_FRAME
                    if ui_col < UI_RING_COLS {
                        return          -- more columns owed; same stage
                    }
                    ui_col = 0
                } else if has_redraw == 1 {
                    g_redraw()
                    music_pump()    -- unsliced: still one long frame
                }
                ui_close = 3
                return
            }
            text.to_bkg()
            if VM_HUD_RESHOW {
                hud_band()
            }
            if box_cut == 1 {
                text.win_sprite_cut(0)   -- sprites back over the scene
                if platform == "sms" or platform == "gamegear" {
                    ui_sprite_cut(255)   -- the band is the scene again
                }
            }
            ui_snap_sprites(0)   -- scroll restored: re-place in the SAME frame
            ui_owner = 255       -- only now may another box open
            ui_close = 0
            return
        }
    }
    }

    bank(0) local function read_input() {
        if platform == "sms" or platform == "gamegear" {
            if ui_close != 0 {
                ui_close_step()   -- one slice of the staged teardown
                return            -- input stays blocked; nothing owed here
            }
        }
        var a: u8 = 0
        if input.held(INPUT_A) {
            a = 1
        }
        a_edge = 0
        if a == 1 {
            if prev_a == 0 {
                a_edge = 1
            }
        }
        prev_a = a
        if box_open == 1 {
            if VM_OP_TEXT_SPEED {
                -- Mid-REVEAL, the A press belongs to the typewriter (it fast-
                -- forwards, in tw_step) - without this gate the same press
                -- dismissed a box whose text had not finished appearing.
                if tw_run == 1 {
                    return
                }
            }
            -- A TIMED box closes itself and ignores the pad, exactly as GB
            -- Studio's does: its `closeWhen: "text"` / non-modal boxes wait on
            -- .UI_WAIT_WINDOW|.UI_WAIT_TEXT with NO button flag and then run
            -- wait_frames, so no press can dismiss one early. Reaching the end
            -- of the hold takes the A-dismiss path below verbatim rather than
            -- copying it (the close is a dozen lines of window, sprite-cut and
            -- repaint work, and two copies would drift).
            if VM_ST_BOX_HOLD {
                if box_hold_live > 0 {
                    box_hold_live -= 1
                    if box_hold_live > 0 {
                        return
                    }
                    a_edge = 1
                }
            }
            if a_edge == 1 {
                box_open = 0
                if platform == "sms" or platform == "gamegear" {
                } else {
                    ui_owner = 255  -- release the UI latch (a waiting thread may open)
                }
                -- If the box was on the WINDOW overlay (GB family), the scene map was
                -- never touched: just hide the window (below). Otherwise the box plots
                -- into the bkg tilemap / framebuffer, so clear it + repaint the room
                -- behind it (a room bigger than the screen).
                if platform == "sms" or platform == "gamegear" {
                    -- STAGED (see ui_stage): the clear, the room repaint and the
                    -- scroll restore are one display frame each instead of ~26 in
                    -- this one. `ui_owner` stays HELD until the last stage, so the
                    -- script this release just woke cannot open its next box on
                    -- top of a half-repainted room (a page flip is exactly that).
                    ui_close = 1
                    a_edge = 0
                    return
                }
                if text.window_active() == 0 {
                    text.clear_area(0, box_row(), SCREEN_COLS, box_h)
                    if has_redraw == 1 {
                        g_redraw()
                        music_pump()        -- see the menu-close site above
                    }
                }
                text.to_bkg()   -- GB: hide the overlay window; a no-op elsewhere
                if VM_HUD_RESHOW {
                    hud_band()      -- ...and bring the HUD band back
                }
                if box_cut == 1 {
                    text.win_sprite_cut(0)   -- sprites back over the scene
                    if platform == "sms" or platform == "gamegear" {
                        ui_sprite_cut(255)   -- the band is the scene again
                    }
                }
                -- CONSUME the edge: dismissing the box uses up this A press, so the
                -- SAME frame's interact_pressed() must not ALSO fire (else dismissing
                -- the last dialogue page instantly re-triggers the NPC's On Interact,
                -- re-opening it -- the "dialogue won't exit" bug). The script resumes
                -- on box_open == 0, not on a_edge, so clearing the edge is safe.
                a_edge = 0
            }
        }
    }

    -- GBDK loads its font glyphs over BKG TILE DATA (tiles 0..131) on the FIRST text
    -- call (a lazy gbs_text_init), which CLOBBERS the game's tileset (tiles 0..N) and
    -- blanks the background the moment the first dialogue box opens. Call this BEFORE
    -- uploading the tileset (bkg.set_data): it forces that font init NOW, while tiles
    -- 0..138 are still empty, so the throwaway font loads clobber nothing and the font
    -- settles at 139..234 (measured), ABOVE the tileset -- then the tileset upload lands clean and a
    -- later dialogue reuses the resident font. A no-op on NES (no printf) + the cc65
    -- consoles (lynx/pce draw text separately from the tile table, so no clobber).
    if platform == "nes" or platform == "lynx" or platform == "pce" {
        function font_preload() { }
    } else {
        function font_preload() {
            text.print_string(0, 0, " ")
        }
    }

    -- Boot the VM: register the game's fetch + text callbacks, clear the pool,
    -- and start the main thread at `entry`.
    function boot(fetch: function(u16) -> u8, text_cb: function(u8), entry: u16) {
        -- `[build] cgb_double_speed` (VM_CPU_FAST, stated on the Game Boy
        -- Color only): twice the CPU per display frame for the interpreter and
        -- the actor passes. FIRST, so every CPU-clocked rate (the hUGEDriver
        -- timer) is programmed at the speed the game runs at.
        if VM_CPU_FAST {
            system.cpu_fast(1)
        }
        g_fetch = fetch
        g_text = text_cb
        boot_entry = entry          -- EX_RESET re-activates context 0 here
        slice_live = 0
        for i in 0..VM_CTXS {
            vm_active[i] = 0
            vm_waiting[i] = 0
            vm_pc[i] = 0
            vm_scratch[i] = 0
            vm_sp[i] = 0
            vm_csp[i] = 0
            vm_self[i] = 0          -- unbound threads default to actor 0 (in-bounds)
            vm_handle[i] = 255
            vm_hnext[i] = 255
        }
        for i in 0..32 {            -- VM_CTXS * NARGS thread-argument cells
            vm_arg[i] = 0
        }
        -- NOTE: the heap is NOT cleared (spec Â§4) -- it is zero-initialized once
        -- at program start (BSS) and survives a re-boot / RESET exception.
        vm_lockcount = 0
        vm_lockowner = 0
        box_open = 0
        ui_owner = 255
        prev_a = 0
        cur_scene = 0
        pend_code = 0
        hud_visible = 1
        actor.reset()
        has_player = 0
        has_proj = 0
        exempt_ctx = 255
        menu_open = 0
        if VM_ST_MENU_CANCEL {
            menu_cancel = 0         -- the one-shot UI latches start DISARMED: a
        }                           -- re-boot (EX_RESET re-enters through the
        if VM_ST_BOX_HOLD {         -- scene path, not this one) keeps the heap,
            box_hold = 0            -- so this is the program-start copy of the
            box_hold_live = 0       -- clear reset_scene_ui does per room.
        }
        for i in 0..NTIMERS {
            tmr_active[i] = 0
            tmr_ctx[i] = 255        -- 255 = no live instance (BSS zero would
        }                           -- read as "context 0 is busy")
        for i in 0..NIN {
            in_active[i] = 0
            in_ctx[i] = 255
        }
        vm_pc[0] = entry
        vm_active[0] = 1
        -- LYNX: register the open-UI drawer as the PRESENT overlay hook, so a
        -- re-blitting present (moving background / strip rebuild) composes an
        -- open box/menu into every frame (see draw_open_ui). Persistent-tilemap
        -- consoles compose drawn UI with the frame already.
        -- The guard is `platform`, NOT the NEEDS_PRESENT_REDRAW const: a const
        -- test lowers to a C `if ((0 == 1))`, which sdcc folds but which still
        -- REFERENCES draw_open_ui -- and neither sdcc nor tree-shaking (which
        -- runs before conditional folding) can then drop it, leaving 217 B of
        -- unreachable resident image on every GB/SMS/NES build. `platform`
        -- folds in the compiler, so the reference never reaches C at all.
        if platform == "lynx" {
            video.set_overlay(draw_open_ui)
        }
    }

    -- The `atan2(y, x)` RPN token's implementation (vm.trig.atan2), registered
    -- by the generated rooms.mos when a program's expressions actually use it.
    -- A SEAM and not an import: vm.core is resident image on GB/SMS and cannot
    -- bank, so the sine/atan tables and their octant maths would be permanent
    -- bank-0 cost for every game, aiming or not. Unregistered, the token
    -- pushes 0 (spec R5) and its arm is pruned away entirely anyway.
    function set_proj_angle(cb: function(i16, i16, u8, i16, u8, u16, u8)) {
        g_proj_angle = cb
        has_proj_angle = 1
    }

    function set_proj_anim(cb: function(u8, u8, u8)) {
        g_proj_anim = cb
        has_proj_anim = 1
    }

    function set_proj_group(cb: function(u8)) {
        g_proj_group = cb
        has_proj_group = 1
    }

    function set_atan2(cb: function(i16, i16) -> u8) {
        g_atan2 = cb
        has_atan2 = 1
    }

    -- Register the CODE WINDOW (see code_base): the blob's address and the
    -- enter/leave pair that maps its ROM bank for a slice. The generated
    -- scripts.mos provides all three (scripts.code_window() registers them);
    -- a shell that never calls it keeps the g_fetch path, byte-for-byte.
    function set_code_window(base: addr, enter: function() -> u8, leave: function(u8)) {
        code_base = base
        g_code_enter = enter
        g_code_leave = leave
        has_code_window = 1
        code_banked = 1
    }
    -- The RESIDENT form: the inline fetch without the per-slice bank map
    -- (see code_banked). The generated scripts.code_window() picks this
    -- when the build did not bank the blob (`VM_CODE_BANKED`).
    function set_code_window_res(base: addr) {
        code_base = base
        has_code_window = 1
        code_banked = 0
    }

    -- Register the native player handler (vm.player.update). Called after boot.
    function set_player(cb: function()) {
        g_player = cb
        g_pdraw = player.draw       -- the locked-frame draw seam (see g_pdraw)
        has_player = 1
    }

    -- UI FREEZE seam: called every frame with 1 while a text box or menu owns
    -- the screen, 0 otherwise. `vm.player.set_input_block` is the registered
    -- callback, so the player stops WALKING and JUMPING under a dialogue box
    -- (reference-engine parity - its UI takes the controls). Registered through a
    -- SEAM rather than importing vm.player, so the packs stay decoupled and a
    -- game that never opts in links nothing and is byte-identical.
    --
    -- It reports the UI state rather than skipping g_player, so gravity and
    -- the camera keep running: a player who opens a box mid-air still falls.
    function set_ui_freeze(cb: function(u8)) {
        g_ui_freeze = cb
        has_ui_freeze = 1
    }

    -- CONSUMED-BUTTON seam: called with a bitmask (bit b = button b) whenever an
    -- OVERRIDING input attachment changes the set. `vm.player.set_input_consume`
    -- is the registered callback, so a button an overriding script owns is
    -- invisible to the native movement handler - the reference engine's `joy ^= key`, which
    -- is what makes a menu cursor built on the PLAYER step one cell per press
    -- instead of walking on the held d-pad.
    --
    -- Pushed on CHANGE, not per frame, and only wired by the generated
    -- rooms.mos when a script actually overrides - unregistered it links
    -- nothing and every existing project is byte-identical.
    function set_input_consume(cb: function(u8)) {
        g_consume = cb
        has_consume = 1
        g_consume(in_consume)
    }

    -- PLAYER VISIBILITY seam (PLAYER_VISIBLE): `vm.player.set_hidden` is the
    -- registered callback. A_VISIBLE, the same flag on a POOL actor, needs no
    -- seam - vm.core imports vm.actor outright, where the player pack is
    -- optional. The reference engine's ACTOR_FLAG_HIDDEN on actors[0] stops
    -- the DRAW and nothing else, which is what its cutscenes hide the player
    -- with - so this is deliberately NOT the player-less room teardown
    -- (clear_player + hide + canim.set_player(255)), which a script could not
    -- undo. Wired by the generated rooms.mos only when a script uses it.
    function set_player_vis(cb: function(u8)) {
        g_pvis = cb
        has_pvis = 1
    }

    -- TYPEWRITER step renderer seam (TEXT_SPEED): the generated
    -- scripts.render_text_step, wired by the generated rooms.mos only when a
    -- script sets a text speed (the set_save pattern) - unregistered, every
    -- box keeps the whole-draw g_text path and nothing here links.
    function set_text_step(cb: function(u8, u8, u8) -> u8) {
        g_tstep = cb
        has_tstep = 1
    }

    -- Unregister the player handler (a player-less MENU / LOGO scene: no native
    -- movement runs; pair with player.hide() so the sprite leaves the screen).
    function clear_player() {
        has_player = 0
    }

    -- Register the AUTO-FADE hold (LCD frames per darkness step). The
    -- generated rooms.mos passes studio.toml's [scenes] fade, the same number
    -- its own fade-IN ramp uses, so the two halves of a transition cannot
    -- disagree. 0 (unregistered) = the historical hard cut.
    function set_fade(hold: u8) {
        fade_hold = hold
    }

    -- Ramp the OUTGOING room to black, at the ONE pending-exception service
    -- point below and BEFORE g_change -- the reference engine fades the room you are
    -- leaving out and the room you arrive in back in (`autoFadeSpeed`); we only
    -- ever did the second half, so a transition cut to black instantly and only
    -- the arrival was animated.
    --
    -- Kept in lockstep with the generated fade-IN ramp's guard
    -- (mosaik_vm/rooms.py FADE_GUARD): the GB family darkens its BGP/OBP
    -- registers and the SMS/Game Gear scale CRAM, so both fade; the Lynx and
    -- PC Engine are excluded because each held frame is a wait_vblank, which
    -- on the Lynx is a full present, and presents spent here consume the
    -- change-detection redraw budget while a room is being built -- after which
    -- the detector sees an unchanged state and the composited background never
    -- reaches the screen. There is also nothing to darken there.
    --
    -- A screen a scripted FADE op has ALREADY taken to black stays black:
    -- The reference VM's fade_out() returns at once when fade_timer is FADED_OUT_FRAME,
    -- and ramping 1 -> 2 -> 3 again from black is a two-step FLASH (measured
    -- 2026-09-16, `tests/fade_before_change_test.py`: BGP FF F9 FE FF between
    -- the script's fade and the arrival ramp). vm.fx remembers the level it
    -- last wrote; under VM_OP_FADE only, because that is the one way to be
    -- black at a raise, so a non-user keeps this ramp character for character.
    -- The PC Engine ramps too since its VCE fade became real (2026-10-03;
    -- its present is a plain vblank wait, not the Lynx's latching one).
    local function fade_out() {
        if platform == "gameboy" or platform == "gameboy_color" or platform == "megaduck" or platform == "analogue_pocket" or platform == "sms" or platform == "gamegear" or platform == "pce" {
            if VM_OP_FADE {
                if fx.faded_out() == 1 {
                    return
                }
            }
            var fl: u8 = 1
            while fl <= 3 {
                var fw: u8 = 0
                while fw < fade_hold {
                    video.wait_vblank()
                    fw = fw + 1
                }
                fx.set_level(fl)
                fl = fl + 1
            }
        }
    }

    -- Register the scene-load callback CHANGE_SCENE routes through (the game's
    -- one room-load path: paint + reposition + respawn).
    function set_change(cb: function(u8, u16, u16)) {
        g_change = cb
        has_change = 1
    }

    -- Register the "redraw the background" callback (the shell wraps scenes.paint of
    -- the current room). Call it for a room BIGGER than the screen, where a closing
    -- dialogue/menu box would otherwise leave a blank band in the tilemap (GB/SMS/GG).
    function set_redraw(cb: function()) {
        g_redraw = cb
        has_redraw = 1
    }

    function set_redraw_cols(cb: function(u8, u8)) {
        g_redraw_cols = cb
        has_redraw_cols = 1
    }

    -- Register the ROW-BAND redraw (see g_redraw_rows). Takes a screen ROW and a
    -- height, so the close repaints exactly the band the box wrote.
    function set_redraw_rows(cb: function(u8, u8)) {
        g_redraw_rows = cb
        has_redraw_rows = 1
    }

    -- Register the data-driven actor-animation driver (actor.animate). The generated
    -- shell calls this when the world has [animations]; run() then advances actor
    -- clips every frame. Opt-in so engine.anim links only for an animating game.
    function set_anim(cb: function()) {
        g_anim = cb
        has_anim = 1
    }

    -- Register the background tile-animation driver (scenes.anim_tick). The
    -- generated rooms.mos calls this when the world has [[animated_tile]]; run()
    -- then fires it every frame. Opt-in so scenes.anim_tick links (and its frame
    -- arrays) only for a game with animated bkg tiles.
    function set_bkg_anim(cb: function()) {
        g_bkg_anim = cb
        has_bkg_anim = 1
    }

    -- Register the background tile-REPLACEMENT writer (scenes.replace_tile). The
    -- generated rooms.mos calls this when the world has a [[replace_tile]] bank;
    -- the BKG_TILE / BKG_TILE_E ops then reach it. Opt-in so the bank's tile data
    -- links only for a game that writes one.
    function set_bkg_tile(cb: function(u8, u8, u8)) {
        g_bkg_tile = cb
        has_bkg_tile = 1
    }

    -- Register the RUNTIME palette writer (the generated
    -- `scenes.set_palette`, which reads the world's [[palette]] library and
    -- goes through graphics.palette so a fade's shadow records the write).
    -- The generated rooms.mos calls this when the world declares
    -- `[world] pal_write`; OP_PAL_SET is a no-op until it does.
    function set_pal_write(cb: function(u8, u8, u8)) {
        g_pal_write = cb
        has_pal_write = 1
    }

    -- Register the generated-HUD refresh callbacks: `update` (a diff redraw, run in
    -- the main loop on tilemap consoles) + `draw` (a full redraw, run in the present
    -- hook on the Lynx). The generated wiring calls this when the project authored an
    -- overlay PANEL. Opt-in so vm.hud links only for a game that has a HUD.
    function set_hud(update: function(), draw: function()) {
        g_hud_update = update
        g_hud_draw = draw
        has_hud = 1
    }

    function set_hud_show(show: function()) {
        g_hud_show = show
        has_hud_show = 1
    }

    -- Re-raise the HUD band (VM_HUD_RESHOW): after a box / menu / room change
    -- hid the window, and on HUD_SHOW 1. Nothing while a box or menu owns it.
    local function hud_band() {
        if has_hud_show == 1 {
            if hud_visible == 1 {
                if box_open == 0 {
                    if menu_open == 0 {
                        g_hud_show()
                    }
                }
            }
        }
    }

    -- Raise an exception from NATIVE code (the RAISE op's counterpart, spec Â§10):
    -- vm.trigger's native DOORS raise code 2 so a door needs no bytecode script,
    -- and vm.sram's restore raises code 3 (LOAD_COMPLETE). The frame loop
    -- services it through the same one path as bytecode RAISE.
    function raise_ex(code: u8, a: u8, b: u16, c: u16) {
        pend_code = code            -- last-writer-wins, like the RAISE op
        pend_a = a
        pend_b = b
        pend_c = c
    }

    -- Back-compat sugar for the common case: request a scene change (code 2).
    function request_change(room: u8, x: u16, y: u16) {
        raise_ex(EX_CHANGE_SCENE, room, x, y)
    }

    -- Register the per-option menu renderer g_menu(string_id, row, selected).
    function set_choice(cb: function(u8, u8, u8)) {
        g_menu = cb
        has_menu = 1
    }

    -- Opt into OP_A_STOP_UPDATE: the actor's long-lived On Update thread is
    -- tracked by vm.entity (en_uthread), which vm.core does not import - a game
    -- with no attached slot scripts must link none of that pool. rooms.mos
    -- wires core.set_stop_update(entity.stop_update) only when the world has On
    -- Update slots, so this is byte-identical unregistered.
    function set_stop_update(cb: function(u8)) {
        g_stop_update = cb
        has_stop_update = 1
    }

    -- OP_A_START_UPDATE's seam into vm.entity (`entity.start_update`), wired
    -- by rooms.mos only when a script starts an update.
    function set_start_update(cb: function(u8)) {
        g_start_update = cb
        has_start_update = 1
    }

    -- Opt into the EMOTE pack (OP_A_EMOTE). rooms.mos wires it only when a
    -- script emotes AND the project has emote art, so a game without bubbles
    -- links none of vm.emote and the op's arm is pruned away anyway.
    -- (one line: the parser takes no multi-line parameter list)
    function set_emote(show: function(u8, u8), active: function() -> u8, update: function()) {
        g_emote_show = show
        g_emote_active = active
        g_emote_update = update
        has_emote = 1
    }

    -- Read a game heap variable -- the $var$ dialogue-interpolation seam. The
    -- generated scripts.render_text calls this to print a live counter value
    -- inline in a text box (the reference engine's "$var$"). idx is a heap cell the compiler
    -- assigns (0..VM_HEAP-1). Only linked when a game interpolates.
    function var_get(idx: u8) -> i16 {
        return heap[idx]
    }

    -- Write a game heap variable + read the current room -- the seams vm.sram uses
    -- to snapshot / restore the game state (the heap IS the state). var_set restores a cell on load; scene() reads the room to persist.
    function var_set(idx: u8, v: i16) {
        heap[idx] = v
    }
    function scene() -> u8 {
        return cur_scene
    }

    -- Opt into the persistent-SAVE pack: a shell imports vm.sram and wires its
    -- persist/restore/has_save here (core.set_save(...)). The SAVE/LOAD ops + the
    -- save_exists() expression then route through these. Unregistered, save/load are
    -- no-ops and save_exists() is 0 -- so a game with no save links no battery code.
    -- The SLOT half of the save seam (W7c). Registered beside set_save by a
    -- generated rooms.mos, inside the same fold, so a project that never
    -- names a slot links none of it. Defined in BOTH arms because an export
    -- list cannot be conditional (the W7a `entity.start_update` rule).
    if VM_SAVE_SLOTS {
        function set_save_slots(slot: function(u8), clear: function(),
                                peek: function(u8, u8)) {
            g_save_slot = slot
            g_save_clear = clear
            g_save_peek = peek
            has_save_slots = 1
        }
    } else {
        function set_save_slots(slot: function(u8), clear: function(),
                                peek: function(u8, u8)) {
        }
    }

    function set_save(persist: function(), restore: function(), has: function() -> u8) {
        g_save_persist = persist
        g_save_restore = restore
        g_save_has = has
        has_save_pack = 1
    }

    -- Opt into the SOUND pack: a shell imports vm.snd and wires its sfx/tone/stop
    -- here (core.set_sound(snd.sfx, snd.tone, snd.stop)). The SFX / TONE / SND_STOP
    -- ops then route through these. Unregistered, they are no-ops -- so a game that
    -- plays no sound links no audio code (byte-identical). vm.snd wraps platform.sound.
    function set_sound(sfx: function(u8), tone: function(u16, u8), stop: function()) {
        g_sfx = sfx
        g_tone = tone
        g_snd_stop = stop
        has_snd = 1
    }

    -- Opt into the 2nd (MUSIC) VOICE: a shell imports vm.snd and wires its
    -- mtone/mstop here (core.set_music_voice(snd.mtone, snd.mstop)). MUSIC_TONE then
    -- plays on the music channel + MUSIC_STOP silences it, so music coexists with SFX.
    -- Unregistered, music falls back to the SFX beep channel (byte-identical, mono).
    function set_music_voice(mtone: function(u16, u8), mstop: function()) {
        g_mtone = mtone
        g_mstop = mstop
        has_mvoice = 1
    }

    -- Opt into the multi-channel MUSIC DRIVER pack (vm.music): a shell wires its
    -- play/update/stop here (+ music.set_song(...) with the game's song data). MUSIC_SONG
    -- then plays a song by index, ticked every frame. Unregistered, MUSIC_SONG is a no-op
    -- and the driver is never linked (tight-target gating).
    function set_music_driver(play: function(u8), update: function(), stop: function()) {
        g_music_song = play
        g_music_update = update
        g_music_drv_stop = stop
        has_music_drv = 1
        if VM_MUSIC_ISR {
            -- 6.6 stage 2: arm the WATCHDOG interrupt beside the main loop's
            -- own tick. It fires the driver only when the loop has not
            -- serviced it for several display frames - a blocking room load,
            -- a streamer refill, a box repaint - which is the gap the stage-1
            -- pumps could not close. Normal play never reaches it, so nothing
            -- runs at an arbitrary raster position. The driver's own play()
            -- raises system.music_hold around its init, so the interrupt can
            -- never see half-initialized state.
            system.music_isr(update)
        }
    }

    -- OPT-IN music TRANSPORT: register pause / resume / per-channel mute (music.pause /
    -- music.resume / music.mute). Unwired -> the MUSIC_PAUSE/RESUME/MUTE ops are no-ops.
    function set_music_ctl(pause: function(), resume: function(), mute: function(u8)) {
        g_music_pause = pause
        g_music_resume = resume
        g_music_mute = mute
        has_music_ctl = 1
    }

    -- Opt into the FRAMED-box pack: a shell imports engine.box and wires its
    -- draw_box here (core.set_box(box.draw_box)); UI_TEXT/MENU then draw a +--+
    -- frame through g_box_draw. Unregistered, the box stays plain and engine.box
    -- is never linked (tight-target gating). A custom font is separate: the shell
    -- calls graphics.text.set_font(FONT_TILES) at boot (a no-op on Lynx/PCE/NES).
    function set_box(draw: function(u8, u8, u8, u8)) {
        g_box_draw = draw
        box_framed = 1
    }

    -- Opt into the projectile pack: a shell imports vm.projectile and wires its
    -- launch/update/render here. Unregistered, PROJ_LAUNCH is a no-op and the
    -- pool is never linked (tight-target gating).
    function set_projectiles(launch: function(i16, i16, i16, i16, u8, u16, u8), update: function(), render: function()) {
        g_proj_launch = launch
        g_proj_update = update
        g_proj_render = render
        has_proj = 1
    }

    -- Register the overlay CURTAIN drawer (vm.fx.overlay). Named set_CURTAIN,
    -- not set_overlay: video.set_overlay is the Lynx PRESENT hook and the two
    -- are unrelated. rooms.mos wires it
    -- only when a script raises one, so an unregistered game links no window
    -- code and the two ops fall through.
    function set_curtain(cb: function(u8, u8, u8) -> u8) {
        g_overlay = cb
        has_overlay = 1
    }

    -- Run the registered player-hit script (F3.5): vm.projectile calls this (through
    -- projectile.set_player_hit, wired by rooms.mos) when a shot masking the player
    -- strikes the player box. A no-op until a scene registers one via set_player_hit.
    function fire_player_hit() {
        if has_player_hit == 1 {
            spawn(player_hit_entry)
        }
    }

    -- W7h - REGISTER THE MUSIC-ROUTINE QUEUE READER. The generated glue calls
    -- this with the hUGE pack's `routine_next` when the project's driver is
    -- hUGEDriver; with any other driver (or none) nothing registers and the
    -- drain below never runs, which is what makes the feature hUGE-only
    -- without a single platform test in this module.
    function set_music_routines(f: function() -> u16) {
        if VM_OP_MUSIC_ROUTINE {
            g_mrt = f
            has_mrt = 1
        }
    }

    -- Drain the driver's routine queue and spawn what it names. The reference VM's
    -- `music_events_update`, step for step:
    --
    --   * the queue item is the effect's PARAMETER BYTE. `d & 3` picks the
    --     slot (hUGEDriver hands the whole byte over, and the reference masks
    --     it here), `d >> 4` is the argument, delivered as arg(0);
    --   * BUSY-GATED: a slot spawns only once the previous instance has
    --     ended, exactly as TIMER_SET is gated and for the same reason - a
    --     song that fires a routine every row would otherwise exhaust the
    --     8-context pool in a second;
    --   * AN UNATTACHED SLOT ABORTS THE WHOLE DRAIN. The reference VM writes `return`
    --     there, not `continue`, so the item is consumed and everything
    --     behind it waits for the next frame. Copied DELIBERATELY: it is
    --     observable (a song firing an unattached routine every row starves
    --     the attached ones) and parity with the reference is what this stage
    --     is for. Not an oversight on either side of the port.
    local function music_events_update() {
        var n: u16 = g_mrt()
        while n != 0xFFFF {
            var d: u8 = n & 255
            var slot: u8 = d & 3
            if (music_rt_on & (1 << slot)) == 0 {
                return              -- the reference VM's `return`, see above
            }
            if alive_gen(music_rt_ctx[slot], music_rt_gen[slot]) == 0 {
                var sc: u8 = spawn(music_rt_entry[slot])
                if sc != 255 {
                    set_arg(sc, 0, d >> 4)
                    music_rt_ctx[slot] = sc
                    music_rt_gen[slot] = gen_of(sc)
                }
            }
            n = g_mrt()
        }
    }

    -- Spawn a new thread at bytecode offset `entry`, returning its context index
    -- (255 = the pool is full). vm.trigger/timers launch a script and ignore the
    -- handle; vm.entity keeps an actor's long-lived On Update thread handle so it
    -- can kill() it on scene change. (The THREAD opcode is the in-bytecode form.)
    hot function spawn(entry: u16) -> u8 {
        var s: u8 = alloc_ctx()
        if s != 255 {
            vm_gen[s] += 1          -- new occupant: stale handles stop matching
            vm_pc[s] = entry
            vm_active[s] = 1
            vm_waiting[s] = 0
            vm_scratch[s] = 0
            vm_sp[s] = 0
            vm_csp[s] = 0           -- RESET the call depth too (spec Â§8.3): a
                                    -- thread killed mid-`call` (a door change
                                    -- inside a sub, or vm.entity teardown)
                                    -- leaves vm_csp > 0, and the next script
                                    -- reusing this context would RET into the
                                    -- dead script's return address.
            vm_self[s] = 0          -- a fresh thread defaults to actor 0 until set_self
            vm_handle[s] = 255      -- no join handle until HANDLE/HANDLE_NEXT binds one
            vm_hnext[s] = 255
            var si: u16 = s
            for j in 0..NARGS {     -- args are zeroed; THREADN overwrites them
                vm_arg[si * NARGS + j] = 0
            }
        }
        return s
    }

    -- Run every pending thread ONE scheduler pass, outside the frame loop --
    -- the generated load_room calls this after spawning the actors' On Init
    -- threads and BEFORE spawning the scene's own init script. The reference engine runs
    -- an actor's On Init during scene load (activate_actor_impl ->
    -- script_execute), so a hide/set-pos On Init lands while the screen is
    -- still faded out; ours were spawned beside the scene init, whose first
    -- event in a converted cutscene is `lock` -- and under a lock run_scripts
    -- runs ONLY the owner, so all eight of the platformer conversion's opening-cutscene hides sat
    -- frozen for the whole cutscene and its "hidden until the camera settles"
    -- actors were visible from frame one. A short On Init also ENDS here,
    -- freeing its context before the scene init needs one (8 actor inits +
    -- a scene init is 9 threads against the 8-context pool).
    function run_pending() {
        run_scripts()
    }

    -- Bind thread `ctx` to actor `actor` -- the SELF operand in that thread's
    -- script then resolves to it (vm.entity calls this after spawning an actor's
    -- On Init / Update / Interact slot script). `actor` is clamped to the pool
    -- so resolve_actor never needs a bounds guard.
    function set_self(ctx: u8, actor: u8) {
        if ctx < VM_CTXS {
            if actor < VM_ACTORS {
                vm_self[ctx] = actor
            }
        }
    }

    -- Seed a spawned thread's ARGUMENT `i` -- the native counterpart of THREADN,
    -- for a script the ENGINE starts rather than bytecode. The reference engine's actor
    -- script is one entry point dispatched on parameter 0 (its compiler folds
    -- the per-collision-group On Hit tabs into the actor's `script` behind
    -- `if (ARG0 == n)`; see `core/actor.c` vs `core/projectiles.c`, which run
    -- the SAME pointer with different arguments), so vm.entity needs to say
    -- WHAT hit the actor. Args are zeroed by spawn(), which is why the
    -- player-CONTACT case needs no call at all - the reference engine passes 0 for it too.
    function set_arg(ctx: u8, i: u8, v: i16) {
        if ctx < VM_CTXS {
            if i < NARGS {
                var ci: u16 = ctx
                vm_arg[ci * NARGS + i] = v
            }
        }
    }

    -- Terminate a thread by its context handle (vm.entity tears down a room's
    -- actor On Update threads on scene change). Out-of-range / already-free is a
    -- no-op.
    function kill(ctx: u8) {
        if ctx < VM_CTXS {
            vm_active[ctx] = 0
            if ctx == exempt_ctx {       -- the song thread was torn down -> no music
                exempt_ctx = 255
            }
            -- If this thread held the cutscene lock (killed mid-cutscene by a
            -- scene change), release it so the pool doesn't stay frozen forever.
            if vm_lockcount > 0 {
                if ctx == vm_lockowner {
                    vm_lockcount = 0
                    vm_lockowner = 0
                }
            }
            if ctx == ui_owner {        -- killed while owning a box/menu: release
                box_open = 0            -- the UI latch so it never sticks busy
                menu_open = 0
                ui_owner = 255
            }
            if vm_handle[ctx] < VM_HEAP {   -- Â§11.4: the join cell reads 0 = done
                heap[vm_handle[ctx]] = 0
            }
            vm_handle[ctx] = 255
            vm_hnext[ctx] = 255         -- a pending HANDLE_NEXT dies with it
            event_release(ctx)          -- mirror the central ST_END release
        }
    }

    -- The spawn generation of context `ctx`, captured right after spawn() so a
    -- later kill_gen can prove the handle still names the same thread.
    function gen_of(ctx: u8) -> u8 {
        if ctx < VM_CTXS {
            return vm_gen[ctx]
        }
        return 0
    }

    -- 1 while context `ctx` still runs the thread the caller spawned (`gen` =
    -- the gen_of() captured at spawn time), 0 once it ended or the pool gave
    -- the context to someone else. vm.entity's start_update asks it, since a
    -- stale handle cannot say whether its On Update is still running.
    function alive_gen(ctx: u8, gen: u8) -> u8 {
        if ctx < VM_CTXS {
            if vm_active[ctx] == 1 {
                if vm_gen[ctx] == gen {
                    return 1
                }
            }
        }
        return 0
    }

    -- kill(), but only if the context still holds the thread the caller
    -- spawned (`gen` = the gen_of() captured at spawn time). A thread that
    -- ended on its own leaves its holder's handle STALE, and the pool reuses
    -- the context for whoever spawns next - a plain kill() by that handle
    -- would murder the unrelated newcomer. vm.entity's offscreen parking kills
    -- through this; the no-op cases (already dead, recycled) are exactly what
    -- it wants.
    function kill_gen(ctx: u8, gen: u8) {
        if ctx < VM_CTXS {
            if vm_gen[ctx] == gen {
                kill(ctx)
            }
        }
    }

    -- True (1) when this frame's A press should INTERACT (an A rising edge with no
    -- textbox / menu open -- read_input already consumed the edge to DISMISS an
    -- open box, so an interact never double-fires with a box dismissal). vm.entity
    -- polls this to run an actor's On Interact script.
    -- bank(0): vm.entity.update polls this EVERY frame (measured at exactly
    -- 1.0 calls/game frame by emu/gb_profile.py `calls`), so it is hot despite
    -- being 21 bytes -- banked, its trampoline cost ~5% of the idle frame.
    -- Is a script holding the cutscene lock? `vm.actor`'s off-window RETIRE
    -- reads this, because the reference's own `actors_update` does:
    --     if (!VM_ISLOCKED()) { ... deactivate_actor_impl(actor); }
    --     else { SET_FLAG(actor->flags, ACTOR_FLAG_DISABLED); }
    -- A locked script gets the DRAW flag and keeps its place in every list, so
    -- an actor a LOCKED script is moving cannot be retired out from under it
    -- (the ice-puzzle freeze). Passed as an argument rather than published
    -- through a setter: `vm.actor` cannot import `vm.core` (the dependency runs
    -- the other way) and a per-frame cross-bank setter call is ~1k cycles,
    -- where an argument to a call already being made is free.
    bank(0) local function lock_flag() -> u8 {
        if vm_lockcount > 0 {
            return 1
        }
        return 0
    }

    bank(0) function interact_pressed() -> u8 {
        if a_edge == 1 {
            if box_open == 0 {
                if menu_open == 0 {
                    return 1
                }
            }
        }
        return 0
    }

    -- Draw the OPEN dialogue box / menu (frame + text + options) at its current
    -- state. The one Lynx UI drawer, called from TWO places:
    --   * run()'s post-present SETTLE block (ui_redraw counts down from an
    --     open / dismiss / cursor move) -- seeds the UI onto both flip pages
    --     of a STATIC scene, which the present-skip then holds.
    --   * the video.set_overlay PRESENT hook (registered in boot, Lynx only):
    --     whenever the present RE-BLITS the frame (a moving background --
    --     scroll_bg, a pan, the shmup auto-scroll -- or the strip ring's
    --     amortized rebuild after a room paint), the freshly-composed page
    --     would scan out WITHOUT the post-present drawing (the UI strobed /
    --     vanished: vm-showcase's title menu over a scroll_bg). The hook runs
    --     INSIDE gbs_present, after the blits and before the flip, so the UI
    --     is part of every composed frame.
    -- The UNframed box also clears its region first, so a shorter line does
    -- not leave the TAIL of a previous longer one (a framed box clears via
    -- g_box_draw); full row width -- render_text prints from col 2 to the
    -- screen edge, one column past the frame interior (the "A MERCHANT WAITS"
    -- edge "T" overflow).
    -- LYNX ONLY, and the fork is what makes that true in the ROM: both call
    -- sites fold away elsewhere, but a definition left standing is resident
    -- image no back end will strip (see the boot() note).
    if platform == "lynx" {
    hot local function draw_open_ui() {
        if box_open == 1 {
            if box_framed == 1 {
                g_box_draw(box_col, box_row(), box_w, box_h)
            } else {
                text.clear_area(0, box_row(), SCREEN_COLS, box_h)
            }
            g_text(box_id)
        }
        if menu_open == 1 {
            if box_framed == 1 {
                g_box_draw(box_col, menu_row - 1, box_w, menu_count + 2)
            }
            if has_menu == 1 {
                for mi in 0..menu_count {
                    var mid: u8 = g_fetch(menu_ids + mi)
                    var msel: u8 = 0
                    if mi == menu.cursor {
                        msel = 1
                    }
                    g_menu(mid, menu_row + mi, msel)
                }
            }
        }
        -- The overlay HUD is composited into EVERY present here too (a persistent
        -- band, not gated on box/menu), so a moving background / scroll does not
        -- strobe it away on the double-buffered Lynx.
        if has_hud == 1 {
            if hud_visible == 1 {           -- HUD_SHOW 0 hides the panel
                g_hud_draw()
            }
        }
    }
    }

    -- The frame loop: input -> run scripts -> native player handler (unless a
    -- cutscene lock owns the frame) -> render actors -> present. Native movement
    -- (player + actor MOVE_TO) happens inside those steps; scripts orchestrate.
    bank(0) function run() {
        loop {
            -- THE FRAME LOCK samples the display clock at the TOP of the frame
            -- (see the lock arm below `video.wait_vblank()`). Folded away
            -- entirely - declaration included - when `[build] frame_lock` is
            -- absent or 1.
            if VM_FRAME_LOCK_ON {
                lk_t0 = system.frames()
            }
            -- The VM-frame clock ticks FIRST, so every thread scheduled this
            -- frame reads the same game_time(). Folded away entirely unless
            -- the blob reads ST_GAME_TIME (VM_ST_GAME_TIME).
            if VM_ST_GAME_TIME {
                vm_time += 1
            }
            if platform == "sms" or platform == "gamegear" {
                -- ATOMIC SPRITE COMMIT (the reference engine's toggle/activate_shadow_OAM,
                -- with the byte GBDK's z80 port gives us). Their shadow OAM is
                -- copied to the hardware sprite table EVERY VBlank, and a
                -- metasprite is written to that shadow one COLUMN at a time -
                -- so a VBlank inside the fan loop copies half the columns at the
                -- new position and half at the old, and the actor is drawn split
                -- by a vertical seam (reported from play: a big animated actor
                -- in the parallax room and an NPC in a walk-in room, both with no
                -- dialogue box in sight). Hold the copy across the whole frame
                -- and release it at the present, so exactly one COMPLETE table
                -- is copied per frame.
                sprite.vbl_hold(1)
            }
            read_input()
            if vm_lockcount == 0 {
                -- Timers + input attachments both freeze under a cutscene lock.
                -- If timers kept ticking, a short-period timer during a long
                -- cutscene would spawn threads that sit frozen and EXHAUST the
                -- 8-context pool -- after which later THREAD/trigger spawns
                -- silently fail (alloc_ctx returns 255).
                tick_timers()
                tick_input_attach()     -- input scripts fire only during gameplay
                -- ...and so do the hUGE music routines (W7h). The reference VM drains them
                -- in the same `if (!VM_ISLOCKED())` block, right after the
                -- timers, so a cutscene silences them exactly as it silences
                -- a timer. Folded away whole unless the blob attaches one.
                if VM_OP_MUSIC_ROUTINE {
                    if has_mrt == 1 {
                        music_events_update()
                    }
                }
            }
            run_scripts()
            -- frame step 4 (spec Â§8.1/Â§10): service a pending exception before
            -- the player renders, so a new room is loaded + the player
            -- repositioned this same frame.
            if pend_code != 0 {
                var code: u8 = pend_code
                pend_code = 0
                if code == EX_RESET {
                    -- kill EVERY thread (the Â§11 path releases lock/UI/handles),
                    -- reset the scene UI, keep the heap, restart context 0.
                    for i in 0..VM_CTXS {
                        kill(i)
                    }
                    reset_scene_ui()
                    spawn(boot_entry)
                } else if code == EX_CHANGE_SCENE or code == EX_LOAD_COMPLETE {
                    -- A scene change TERMINATES the old room's threads (GB
                    -- Studio's model: every running script stops at a scene
                    -- switch; only the tracked music thread plays on). They
                    -- used to survive, and a surviving thread is bound to a
                    -- room that no longer exists: the reference-engine sample's
                    -- path->town doorway script (a waitable walk-to, then
                    -- this raise) left copies alive INSIDE the town, where
                    -- each finished its walk against the new room's actors
                    -- and re-raised the change -- the town visibly "reset"
                    -- moments after arriving, again and again. The Â§11
                    -- death path releases a held lock / UI latch / join
                    -- handle per thread, so this is a loop over kill(), not
                    -- new cleanup.
                    for i in 0..VM_CTXS {
                        if i != exempt_ctx {
                            kill(i)
                        }
                    }
                    cur_scene = pend_a  -- track the room for the ST_SCENE read
                    if fade_hold > 0 {
                        -- AUTO-FADE: ramp the room being LEFT out to black.
                        -- load_room re-asserts level 3, paints underneath it
                        -- and ramps back in, so the screen is black across the
                        -- whole load and nothing of the build is visible.
                        fade_out()
                    } else {
                        fx.set_level(0) -- reveal the destination room (a fade_in
                                        -- in its on-init script animates it)
                    }
                    reset_scene_ui()    -- close a lingering box/menu + drop the old
                                        -- room's timers/input (see reset_scene_ui)
                    if has_change == 1 {
                        g_change(pend_a, pend_b, pend_c)
                    }
                }
                -- unknown codes: cleared and ignored (spec Â§13.11 -- forward compat)
            }
            -- WHETHER A UI OWNS THE SCREEN IS A FACT, NOT AN UNLOCKED-FRAME
            -- DECISION, so it is published EVERY frame - outside the lock gate
            -- below, and after run_scripts (which is what opens the box) but
            -- before player.draw().
            --
            -- It used to sit inside `vm_lockcount == 0`, which reads as "the UI
            -- only takes the controls when the player has them" - and that is
            -- exactly backwards for the case that matters, because THE LOCK IS
            -- A PROPERTY OF THE SCRIPT KIND: an On Interact, a trigger script
            -- and a scene init all lock, so essentially every dialogue box in a
            -- conversion is opened by a LOCKED script and the freeze was never
            -- published at all while it was up.
            --
            -- On the SMS and the Game Gear that is not cosmetic. Their box is
            -- plotted into the scene's own name table, so `text.to_window`
            -- SNAPS the hardware scroll down to a tile (a tile-built border
            -- cannot land at a sub-tile offset) and every plot adds that same
            -- snapped scroll. `follow_and_render`'s `in_block` arm is what
            -- holds the view there - and with the freeze unpublished it never
            -- ran, so `player.draw()` (which vm.core calls on every LOCKED
            -- frame, so a locked walk still animates) re-published the camera
            -- and rewrote the scroll register with the UNSNAPPED value. The box
            -- stayed on the tile grid while the screen moved under it: the whole
            -- box slid left by `camx & 7` px, which pushes its left border off
            -- the window and opens a gap of the same width on the right - and
            -- the width depends on where the camera stopped, so it changes every
            -- time you walk up to the same sign (reported from play 2026-08-25;
            -- measured 1..8 px cycling with the spawn pixel on both consoles).
            -- The GB family never saw it: its box lives on the WINDOW layer,
            -- which is screen space already and needs no snap.
            if has_ui_freeze == 1 {
                -- tell the player pack whether the UI owns the controls
                -- this frame (a box or menu is up). Physics still runs.
                var uib: u8 = 0
                if box_open == 1 {
                    uib = 1
                }
                if menu_open == 1 {
                    uib = 1
                }
                if platform == "sms" or platform == "gamegear" {
                    -- ...AND ACROSS THE STAGED TEARDOWN. `box_open` drops to 0
                    -- the moment A is pressed, but the repaint that follows runs
                    -- for another dozen frames (ui_close_step) and it walks the
                    -- ring by COLUMN. Unfrozen, the camera resumes on the very
                    -- first of those frames and the streamer advances `s_base`
                    -- UNDER the walk, so the slices are taken against a moving
                    -- base: some ring columns are written twice and others never,
                    -- and the ones never written keep the box's own cells - the
                    -- reported vertical stripes of box paper left standing in the
                    -- scene after a sign-post box closed. The freeze is what pins
                    -- `s_base` for the length of the walk.
                    if ui_close != 0 {
                        uib = 1
                    }
                }
                g_ui_freeze(uib)
            }
            -- the reference engine's `pause_state_update` (state 35) skips state_update
            -- ONLY; the player still draws (actors_render), so a paused frame
            -- takes the locked frame's draw.
            if vm_lockcount == 0 {
                if has_player == 1 {
                    if VM_ST_SCENE_UPDATE_PAUSED {
                        if scene_paused == 0 {
                            g_player()
                        } else {
                            g_pdraw()
                        }
                    } else {
                        g_player()
                    }
                }
            }
            -- SETTLE THE CAMERA BEFORE ANYTHING IS PLACED AGAINST IT. Re-assert
            -- a scripted camera + shake + generic background scroll EVERY frame
            -- -- even under a cutscene lock (g_player frozen) AND in a
            -- player-less MENU / LOGO scene (has_player == 0), so a scripted
            -- pan / shake / scroll_bg renders regardless of the scene type.
            -- cam_apply is a no-op when nothing is active (cam_lock / scr_on /
            -- shake all 0), so an ordinary room pays one call and is unchanged.
            --
            -- It must run HERE - after g_player (whose camera.follow it reads
            -- back for the narrow shake's put_scroll, and whose wide arm defers
            -- to it) and BEFORE actor.render. It used to sit just above
            -- present, which is one step too late: in a NORMAL room the camera
            -- is moved by g_player above, so sprites and background agree, but
            -- under a cutscene LOCK g_player is frozen and cam_apply is the
            -- only camera code that runs - so every actor was placed against
            -- the PREVIOUS frame's camera while the background scroll was
            -- already this frame's. Measured on the platformer conversion's
            -- opening cutscene: the placement residual equalled
            -- the camera's own step on 374 of 374 stepping frames, GB and GBC
            -- alike - a 2 px shear on every sprite for the length of the pan,
            -- with the PINNED silhouette exact (it has no camera term, which
            -- is what made it the control).
            player.cam_apply()
            if vm_lockcount > 0 {
                -- THE PLAYER KEEPS DRAWING UNDER THE LOCK - the reference engine renders
                -- its player (actors[0]) in actors_render and follows it in
                -- camera_update, both OUTSIDE its !VM_ISLOCKED() gate; only
                -- the input/physics state_update freezes. Without this, a
                -- locked PLAYER_MOVE_TO walked the position variable while
                -- the sprite stood still (the sample's path-to-town doorway:
                -- "waits, then teleports"). After cam_apply on purpose - the
                -- camera settles before anything is placed against it - and
                -- only under the lock, because the unlocked frame's handler
                -- already drew. player.draw() stands down in a playerless or
                -- shmup room (see its note).
                if has_player == 1 {
                    g_pdraw()
                }
            }
            actor.step_all()            -- native actor auto-move (runs under a lock too)
            actor.render(lock_flag())
            if has_emote == 1 {
                g_emote_update()        -- the emote bubble follows its actor;
            }                           -- under a cutscene lock too, like the actors it sits on
            if has_anim == 1 {
                g_anim()                -- data-driven actor animation (actor.animate)
            }
            if has_bkg_anim == 1 {
                g_bkg_anim()            -- background tile animation (scenes.anim_tick);
            }                           -- runs under a lock too, like music (water keeps rippling)
            if has_proj == 1 {
                -- A SHOT MOVES AND TESTS *AFTER* THE ACTORS HAVE MOVED, and
                -- after the camera has settled - the reference engine's own frame order
                -- (`core.c`: camera_update -> actors_update -> actors_render ->
                -- projectiles_update -> projectiles_render). This call used to
                -- sit up beside `g_player()`, three steps earlier, purely
                -- because both are gated on the cutscene lock - and that cost
                -- two frames' worth of staleness in one op: the hit test read
                -- every target's position from BEFORE `actor.step_all()`, and
                -- the off-window despawn read `player.cam_x()` from before
                -- `cam_apply()`, which is the "camera settles before anything
                -- is placed against it" invariant one call short. Both shrink
                -- the effective hit window against a MOVING target by that
                -- frame's motion (the shooter conversion's falling hazard drops ~2 px per VM
                -- frame). Update still precedes render within the frame, which
                -- is what `p_quiet` and the dynamic-OAM re-base depend on.
                --
                -- ...AND THE LOCK GATE ITSELF IS A DIVERGENCE. In the reference VM, `projectiles_update()` sits OUTSIDE the
                -- `!VM_ISLOCKED()` block - only input, the player state
                -- machine, timers and music EVENTS freeze - so a shot in
                -- flight when a cutscene starts keeps flying and keeps
                -- colliding there, where ours stops dead in the air. Ours is
                -- also inconsistent with its own neighbours: actor.step_all,
                -- the emote, the background animation and the music driver
                -- all run under the lock, three lines above and below this
                -- one. `[build] proj_under_lock` takes the reference VM's side. Default
                -- OFF, and the else arm is the original statement verbatim,
                -- so a project that does not opt in is byte-identical.
                if VM_PROJ_UNDER_LOCK {
                    g_proj_update()     -- reference-VM parity: flight ignores the lock
                } else {
                    if vm_lockcount == 0 {
                        g_proj_update() -- native flight; frozen under a cutscene lock
                    }
                }
                g_proj_render()
            }
            if VM_MUSIC_ISR {
                -- 6.6 stage 2: THE MAIN LOOP STILL OWNS THE TICK, at exactly
                -- this point in the frame - the interrupt added beside it is a
                -- WATCHDOG that only fires the driver when this arm has not run
                -- for several display frames (a blocking room load). Handing
                -- the tick to the interrupt outright was measured wrong: a
                -- ~2k-cycle handler at an arbitrary point in the frame displaces
                -- the parallax band chain and the box sprite cut. The pacing
                -- (elapsed display frames, the same cap) moves into the prelude
                -- so the two callers share ONE owner and cannot double-tick.
                if has_music_drv == 1 {
                    system.music_tick()
                }
            } else if has_music_drv == 1 {
                -- TEMPO IS NOT THE FRAME RATE. The driver advances one tracker
                -- tick per call and a song is composed against ~60 Hz, but a VM
                -- frame is not a display frame (2-3 LCD frames on a DMG, and
                -- 3.2 in the reference-engine conversion's busiest room) - so ticking
                -- once per VM frame played every song at whatever rate the game
                -- loop happened to run: measured 49.8 Hz in the light vm-music
                -- sample and ~18.7 Hz in a converted shooter room, a third of tempo.
                --
                -- hUGEDriver already had this fixed the other way, with a 64 Hz
                -- TIMER interrupt (its per-frame seam call is deliberately
                -- empty). vm.music is mosaik rather than C and a song change
                -- arrives from bytecode, so an ISR here would race the main
                -- loop; catching up against a free-running display-frame
                -- counter gets the same average tempo with no re-entrancy.
                --
                -- The CAP matters: after a room load or a long blocking op the
                -- delta can be huge, and replaying it would fast-forward the
                -- song. Dropping the excess loses time rather than scrambling
                -- the music, which is what a real driver does when it misses.
                var fnow: u8 = system.frames()
                var fd: u8 = fnow - m_last_frame
                m_last_frame = fnow
                if fd > MUSIC_CATCHUP_MAX {
                    fd = MUSIC_CATCHUP_MAX
                }
                if fd == 0 {
                    fd = 1                  -- never stall: a frame faster than
                }                           -- the counter still owes one tick
                while fd > 0 {
                    g_music_update()        -- advance the driven song (plays under a lock too)
                    fd = fd - 1
                }
            }
            if has_hud == 1 {
                if hud_visible == 1 {       -- HUD_SHOW 0 hides the panel
                    if NEEDS_PRESENT_REDRAW == 0 {
                        g_hud_update()      -- tilemap: diff-redraw the HUD var fields here
                    }                       -- Lynx: the present hook (draw_open_ui) redraws it
                }
            }
            -- (cam_apply moved UP, above actor.render -- see the note there.)
            if platform == "sms" or platform == "gamegear" {
                sprite.vbl_hold(0)      -- the frame's sprite writes are complete:
            }                           -- let the VBlank below copy them as a unit
            video.wait_vblank()
            -- THE FRAME LOCK: hold the game frame to a FIXED number of display
            -- frames (`[build] frame_lock`), so a VM frame is a KNOWN multiple
            -- of an LCD frame instead of whatever this room's load happens to
            -- cost.
            --
            -- Why a converted game wants this: a reference-engine duration is authored
            -- in ITS display frames, and the importer converts it by one
            -- constant (`VM_FRAMES_PER_LCD`). That constant can only be right
            -- if the ratio is CONSTANT, and measured 2026-08-30 it is not -
            -- the reference-engine sample conversion's 17 rooms span 1.00 to 2.14 LCD frames per game
            -- frame and the platformer conversion's six span 1.17 to 3.53, so with a single
            -- scale some room is always wrong. Worse, it is wrong in the
            -- direction that PUNISHES optimisation: at scale 2, a room the
            -- 60 fps work takes from 2.00 to 1.00 starts running its whole
            -- game at DOUBLE the reference speed. Locking makes the ratio a
            -- number the conversion can be scaled against, and makes the
            -- rate the same in every room of the game.
            --
            -- It is a FLOOR, not a ceiling: a frame whose work already
            -- overran the lock does not wait, exactly as the reference engine's own
            -- `wait_vbl_done` does not. The subtraction is u8 and WRAPS, the
            -- same idiom the music catch-up above relies on.
            if VM_FRAME_LOCK_ON {
                var lkd: u8 = system.frames() - lk_t0
                while lkd < VM_FRAME_LOCK {
                    video.wait_vblank()
                    lkd = system.frames() - lk_t0
                }
            }
            -- Re-draw an open text box / menu AFTER present -- ONLY on a DOUBLE-
            -- BUFFERED console (the Lynx, NEEDS_PRESENT_REDRAW). UI_TEXT is
            -- NON-freezing (the world keeps updating), so the Lynx present
            -- recomposites the frame and WIPES a once-drawn box/menu; re-drawing it
            -- here, on the freshly-displayed page, keeps it visible. Every other
            -- console keeps a persistent tilemap/name-table, where the run_scripts
            -- draw stays put -- and re-plotting a framed box (a clear_area + ~130
            -- tile writes) here, during active display, TEARS = flicker (see the
            -- NEEDS_PRESENT_REDRAW note above). So this whole block is Lynx-only.
            -- Redraw only while a box/menu is SETTLING onto both flip buffers
            -- (ui_redraw counts down from a change), NOT every frame -- once static
            -- the present-skip holds it, and re-plotting a framed box each frame
            -- tears its border = a per-cell shimmer (see the ui_redraw note above).
            -- (A RE-BLITTING present -- a moving background, the strip ring's
            -- amortized rebuild -- redraws the UI itself through the
            -- video.set_overlay hook registered in boot; see draw_open_ui.)
            -- `platform`, not the const -- see the set_overlay note in boot():
            -- a const test keeps the draw_open_ui reference alive in C.
            if platform == "lynx" {
              if ui_redraw > 0 {
                ui_redraw -= 1
                draw_open_ui()
              }
            }
        }
    }

    -- box_id (the open dialogue box's string id) is exported so a shell's frame
    -- drawer can vary the box STYLE per sentence (unframed / framed / 9-slice); it
    -- is stable across the Lynx redraw frames (set only when a NEW box opens), so a
    -- `box_id % N` style pick does not shimmer. Sample: projects/vm-boxtest.
    export set_pal_write
    export boot, run, set_code_window, set_player, set_ui_freeze, set_input_consume, set_player_vis, set_atan2, set_proj_angle, set_proj_anim, set_proj_group, clear_player, set_change, set_fade, set_choice, spawn, run_pending, set_self, set_arg, kill, gen_of, kill_gen, interact_pressed, request_change, raise_ex, set_projectiles, fire_player_hit, set_curtain, set_box, set_box_metrics, set_view, set_box_min, set_text_lines, set_text_step, set_box_cut, box_row, box_top, box_left, font_preload, set_redraw, set_redraw_cols, set_redraw_rows, set_anim, set_bkg_anim, set_bkg_tile, set_hud, set_hud_show, box_id, var_get, var_set, scene, set_save, set_save_slots, set_sound, set_music_voice, set_music_driver, set_music_ctl, music_pump, set_stop_update, set_start_update, alive_gen, set_emote, set_code_window_res, set_music_routines
}
