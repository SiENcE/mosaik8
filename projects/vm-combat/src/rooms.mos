-- GENERATED by MosaiK8 Studio (mosaik_vm) -- the WORLD wiring: room load,
-- doors/triggers/entity slots, and the scene-type player dispatch. Only the
-- scene types + packs this world USES are emitted/imported, so an unused
-- handler is never referenced (and [build] shake_exports drops it). Player
-- tuning comes from studio.toml [player] (edit in the studio, not here).

module "rooms" {
    import "scenes"
    import "vm.core"
    import "vm.player"
    import "vm.actor"
    import "vm.entity"
    import "vm.projectile"
    import "graphics.text"
    import "scripts"

    -- player tuning (studio.toml [player])
    const WALK: u8 = 1
    const RUN: u8 = 1
    const JUMP: u8 = 4
    const GRAV: u8 = 1
    const MAXFALL: u8 = 4
    const PW: u8 = 8
    const PH: u8 = 8
    const PTILE: u8 = 0
    const SH_SPEED: u8 = 1
    const SH_PACE: u8 = 2

    -- the boot scene ([world] start_scene, resolved to its index)
    const START: u8 = 0

    var room: u8

    -- Is world pixel (x,y) solid in the current room?
    -- OUTSIDE the scene is SOLID (reference-engine parity - see the
    -- cell_at note; the unbounded read was phantom collision).
    bank(0) function solid_at(x: u16, y: u16) -> bool {
        var cx: u16 = x / 8
        var cy: u16 = y / 8
        if cx >= scenes.MAP_W or cy >= scenes.MAP_H {
            return true
        }
        var idx: u16 = cy * scenes.MAP_W + cx
        return scenes.collision_at(room, idx) == scenes.COLLIDE_SOLID
    }

    function tick_shmup() {
        player.update_shmup()
        entity.update()
    }

    if platform == "sms" or platform == "gamegear" or platform == "nes" {
        const OAM_SLOTS: u8 = 64
    } else {
        const OAM_SLOTS: u8 = 40
    }

    -- Load room `rm`, place the player at (px,py), wire the room's
    -- doors/triggers/actors, and pick the handler for its scene TYPE.
    function load_room(rm: u8, px: u16, py: u16) {
        room = rm
        scenes.paint(rm)
        if platform == "gameboy" or platform == "gameboy_color" or platform == "megaduck" or platform == "analogue_pocket" or platform == "sms" or platform == "gamegear" or platform == "nes" or platform == "pce" {
            var cw: u16 = scenes.MAP_W
            if cw < SCREEN_COLS {
                var cw8: u8 = cw
                text.clear_area(cw8, 0, SCREEN_COLS - cw8, SCREEN_ROWS)
            }
            var ch: u16 = scenes.MAP_H
            if ch < SCREEN_ROWS {
                var ch8: u8 = ch
                text.clear_area(0, ch8, SCREEN_COLS, SCREEN_ROWS - ch8)
            }
        }
        player.scroll_bg_off()
        entity.reset()
        actor.reset()
        var slot: u8 = 0
        for i in 0..scenes.OBJ_COUNT {
            if scenes.obj_scene_at(i) == rm {
                if scenes.obj_kind_at(i) != scenes.KIND_PLAYER {
                    actor.activate(slot, 1, scenes.obj_x_at(i), scenes.obj_y_at(i))
                    entity.add(slot, scenes.obj_init(i), scenes.obj_update(i), scenes.NO_SCRIPT)
                    entity.bind_hit(slot, scenes.obj_hit(i))
                    actor.set_box(slot, 8, 8, 0, 0)
                    slot += 1
                }
            }
        }
        var mw: u16 = scenes.MAP_W
        var mh: u16 = scenes.MAP_H
        mw = mw * 8
        mh = mh * 8
        -- auto-scroll: a map taller than the screen scrolls UP
        -- (classic vertical shmup), else it scrolls RIGHT.
        var sdir: u8 = 0
        var smax: u16 = 0
        if mh > SCREEN_HEIGHT {
            sdir = 1
            smax = mh - SCREEN_HEIGHT
        } else if mw > SCREEN_WIDTH {
            smax = mw - SCREEN_WIDTH
        }
        player.setup_shmup(PTILE, px, py, PW, PH, SH_SPEED, sdir, SH_PACE, smax, solid_at)
        core.set_player(tick_shmup)
        core.run_pending()
        var si: u16 = scenes.scene_init(rm)
        if si != scenes.NO_SCRIPT {
            core.spawn(si)
        }
    }

    if platform == "sms" or platform == "gamegear" {
        -- A dialogue box or menu here is plotted INTO the scene
        -- tilemap (these consoles have no window overlay to put it
        -- on), so closing it leaves the box's cells blank -- vm.core
        -- clears what it drew and cannot know what the scene had
        -- there. core.set_redraw calls this on every close.
        function redraw() {
            scenes.paint(room)
        }
        -- The column-SLICED redraw: vm.core repaints the scene a
        -- few ring columns per frame on a box close, so no single
        -- game frame carries the whole ~24-display-frame refill.
        function redraw_cols(from: u8, n: u8) {
            if from == 0 {
                scenes.paint(room)
            }
        }
        -- The ROW-BAND redraw: the box damaged `h` screen rows,
        -- so this repaints exactly those and the close is one
        -- slice instead of eight.
        function redraw_rows(row: u8, h: u8) {
            scenes.paint(room)
        }
    }

    -- Boot into `start_room`: wire the animation clips (when the world
    -- has any), register load_room as the scene-change callback, find
    -- the player start in the object table, and load the room.
    function start(start_room: u8) {
        scripts.code_window()     -- the interpreter's inline fetch (V-5)
        core.set_text_lines(scripts.text_lines)
        core.font_preload()
        if platform == "sms" or platform == "gamegear" {
            core.set_redraw(redraw)
            core.set_redraw_cols(redraw_cols)
            core.set_redraw_rows(redraw_rows)
        }
        core.set_projectiles(projectile.launch, projectile.update, projectile.render)
        projectile.set_top(OAM_SLOTS)
        projectile.set_hit(entity.on_projectile_hit)
        core.set_change(load_room)
        var pxs: u16 = 80
        var pys: u16 = 72
        for i in 0..scenes.OBJ_COUNT {
            if scenes.obj_scene_at(i) == start_room {
                if scenes.obj_kind_at(i) == scenes.KIND_PLAYER {
                    pxs = scenes.obj_x_at(i)
                    pys = scenes.obj_y_at(i)
                }
            }
        }
        load_room(start_room, pxs, pys)
    }

    export START, start, load_room, solid_at
}
