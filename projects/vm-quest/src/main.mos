-- vm-quest -- the VM8 MIGRATION-PROOF shell (Stage 4). A small top-down RPG
-- slice reproducing the CORE of the composed studio-demo, entirely on the fixed VM
-- engine: the player is native (vm.player), the elder NPC's dialogue is a
-- per-instance On Interact slot (vm.entity), and the flag-GATED vault door is a
-- SCRIPTABLE trigger (vm.trigger) whose On Enter script checks a heap flag and
-- either CHANGE_SCENEs or shows a "locked" box. All game logic is DATA (the
-- scripts module); this shell only wires the engine + loads rooms. It is the
-- vm-entity shell (actors + slots) PLUS vm.trigger registration.

module "main" {
    import "platform.video"
    import "graphics.sprite"
    import "graphics.bkg"
    import "scenes"
    import "scripts"
    import "vm.core"
    import "vm.player"
    import "vm.actor"
    import "vm.entity"
    import "vm.trigger"

    -- sprite tile 0 = player (filled), tile 1 = elder (ring)
    const SPRITES: array[u8, 32] = [
        0x00, 0x00, 0x7E, 0x7E, 0x7E, 0x7E, 0x7E, 0x7E,
        0x7E, 0x7E, 0x7E, 0x7E, 0x7E, 0x7E, 0x00, 0x00,
        0x3C, 0x3C, 0x42, 0x7E, 0x81, 0xFF, 0x81, 0xFF,
        0x81, 0xFF, 0x42, 0x7E, 0x3C, 0x3C, 0x00, 0x00
    ]

    var cur_room: u8 = 0

    function solid_at(x: u16, y: u16) -> bool {
        var cx: u16 = x / 8
        var cy: u16 = y / 8
        var idx: u16 = cy * scenes.MAP_W + cx
        return scenes.collision_at(cur_room, idx) == scenes.COLLIDE_SOLID
    }

    -- The ONE room-load path: paint, tear down the old room's entities, run scene
    -- On Init, spawn + register this room's actors AND its scriptable triggers.
    function load_room(room: u8) {
        cur_room = room
        scenes.paint(room)
        entity.reset()
        -- clear the previous room's actors so none linger after a scene change
        actor.reset()
        var si: u16 = scenes.scene_init(room)
        if si != scenes.NO_SCRIPT {
            core.spawn(si)
        }

        -- non-player actors -> pool slots (in flatten order) + their slot scripts.
        -- vm-quest's actors only use On Interact (the elder's dialogue), so the
        -- transpiler emits only scenes.obj_interact; we pass NO_SCRIPT for the
        -- Init/Update slots. (A game whose actors also use On Init/Update wires
        -- scenes.obj_init/obj_update here too, exactly like projects/vm-entity.)
        var slot: u8 = 0
        for i in 0..scenes.OBJ_COUNT {
            if scenes.OBJ_SCENE[i] == room {
                if scenes.OBJ_KIND[i] != scenes.KIND_PLAYER {
                    actor.activate(slot, 1, scenes.OBJ_X[i], scenes.OBJ_Y[i])
                    entity.add(slot, scenes.NO_SCRIPT, scenes.NO_SCRIPT, scenes.obj_interact(i))
                    slot += 1
                }
            }
        }

        -- scriptable triggers (the gate): register this room's TRIG_* rects, tile
        -- cells -> world pixels, each spawning its On Enter script on entry.
        trigger.clear()
        for i in 0..scenes.TRIG_COUNT {
            if scenes.TRIG_FROM[i] == room {
                trigger.add(scenes.TRIG_TX[i] * 8, scenes.TRIG_TY[i] * 8, scenes.TRIG_TW[i] * 8, scenes.TRIG_TH[i] * 8, scenes.trigger_enter(i))
            }
        }
    }

    -- CHANGE_SCENE (raised by the gate script) lands here via set_change.
    function change(room: u8, x: u16, y: u16) {
        player.set_pos(x, y)
        load_room(room)
    }

    -- Per-frame: native player move, the entity On Interact poll, then the trigger
    -- rising-edge check (the gate).
    function tick() {
        player.update()
        entity.update()
        trigger.update(player.pos_x(), player.pos_y(), 8, 8)
    }

    function main() {
        -- Force the GBDK font init BEFORE the tileset upload (else the first
        -- dialogue box clobbers the tileset + blanks the background).
        core.font_preload()
        bkg.set_data(0, scenes.TILE_COUNT, scenes.TILESET)
        sprite.set_data(0, 2, SPRITES)

        core.boot(scripts.fetch, scripts.render_text, scripts.ENTRY_main)
        core.set_change(change)

        var pxs: u16 = 48
        var pys: u16 = 56
        for i in 0..scenes.OBJ_COUNT {
            if scenes.OBJ_SCENE[i] == 0 {
                if scenes.OBJ_KIND[i] == scenes.KIND_PLAYER {
                    pxs = scenes.OBJ_X[i]
                    pys = scenes.OBJ_Y[i]
                }
            }
        }
        player.setup(0, pxs, pys, 8, 8, 1, solid_at)
        load_room(0)
        core.set_player(tick)

        video.enable_lcd()
        video.show_background()
        video.show_sprites()
        core.run()
    }

    export main
}
