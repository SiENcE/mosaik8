    -- Collision cell at flat index `idx` of `scene` -- O(1).
    function collision_at(scene: u8, idx: u16) -> u8 {
        return assets.range_byte(COLLISION, MAP_OFF[scene], idx)
    }

    const OBJ_COUNT: u8 = 2
    const OBJ_SCENE: array[u8, 2] = [
        1, 1
    ]
    const OBJ_KIND: array[u8, 2] = [
        0, 1
    ]
    const OBJ_X: array[u8, 2] = [
        80, 32
    ]
    const OBJ_Y: array[u8, 2] = [
        72, 32
    ]
    function obj_scene_at(i: u8) -> u8 {
        return OBJ_SCENE[i]
    }
    function obj_kind_at(i: u8) -> u8 {
        return OBJ_KIND[i]
    }
    function obj_x_at(i: u8) -> u8 {
        return OBJ_X[i]
    }
    function obj_y_at(i: u8) -> u8 {
        return OBJ_Y[i]
    }

    const DOOR_COUNT: u8 = 3
    const DOOR_FROM: array[u8, 3] = [
        1, 2, 3
    ]
    const DOOR_TX: array[u8, 3] = [
        19, 31, 9
    ]
    const DOOR_TY: array[u8, 3] = [
        9, 15, 1
    ]
    const DOOR_TO: array[u8, 3] = [
        2, 3, 1
    ]
    const DOOR_EX: array[u8, 3] = [
        12, 76, 80
    ]
    const DOOR_EY: array[u8, 3] = [
        96, 232, 72
    ]
    function door_from_at(i: u8) -> u8 {
        return DOOR_FROM[i]
    }
    function door_tx_at(i: u8) -> u8 {
        return DOOR_TX[i]
    }
    function door_ty_at(i: u8) -> u8 {
        return DOOR_TY[i]
    }
    function door_to_at(i: u8) -> u8 {
        return DOOR_TO[i]
    }
    function door_ex_at(i: u8) -> u8 {
        return DOOR_EX[i]
    }
    function door_ey_at(i: u8) -> u8 {
        return DOOR_EY[i]
    }

    -- VM8 entity script slots: a selector maps an entity to its
    -- event script entry (scripts.ENTRY_*), NO_SCRIPT = unbound.
    const NO_SCRIPT: u16 = 0xFFFF
    function obj_update(i: u16) -> u16 {
        if i == 1 {
            return scripts.ENTRY_wander
        }
        return NO_SCRIPT
    }

    function obj_interact(i: u16) -> u16 {
        if i == 1 {
            return scripts.ENTRY_npc_talk
        }
        return NO_SCRIPT
    }

    function scene_init(scene: u8) -> u16 {
        if scene == 0 {
            return scripts.ENTRY_title
        }
        if scene == 3 {
            return scripts.ENTRY_sky_init
        }
        return NO_SCRIPT
    }

    const TRIG_COUNT: u8 = 1
    const TRIG_FROM: array[u8, 1] = [
        1
    ]
    const TRIG_TX: array[u8, 1] = [
        16
    ]
    const TRIG_TY: array[u8, 1] = [
        8
    ]
    const TRIG_TW: array[u8, 1] = [
        2
    ]
    const TRIG_TH: array[u8, 1] = [
        3
    ]
    function trig_from_at(i: u8) -> u8 {
        return TRIG_FROM[i]
    }
    function trig_tx_at(i: u8) -> u8 {
        return TRIG_TX[i]
    }
    function trig_ty_at(i: u8) -> u8 {
        return TRIG_TY[i]
    }
    function trig_tw_at(i: u8) -> u8 {
        return TRIG_TW[i]
    }
    function trig_th_at(i: u8) -> u8 {
        return TRIG_TH[i]
    }
    function trigger_enter(i: u16) -> u16 {
        if i == 0 {
            return scripts.ENTRY_ding
        }
        return NO_SCRIPT
    }

    -- No animated tiles: anim_tick() is a no-op, so the game
    -- loop can still call scenes.anim_tick() unconditionally.
    function anim_tick() {
    }

    export TILE_COUNT, MAP_W, MAP_H, SCENE_COUNT, SCENE_W, SCENE_H, SCTYPE_TOPDOWN, SCTYPE_PLATFORM, SCTYPE_ADVENTURE, SCTYPE_SHMUP, SCTYPE_LOGO, SCTYPE_MENU, SCTYPE_POINTNCLICK, SCENE_TYPE, scene_type_at, TILESET, map_tile, paint, KIND_PLAYER, KIND_NPC, MAPS, MAP_OFF, COLLIDE_NONE, COLLIDE_SOLID, COLLIDE_PLATFORM, collision_at, COLLISION, OBJ_COUNT, OBJ_SCENE, OBJ_KIND, OBJ_X, OBJ_Y, DOOR_COUNT, DOOR_FROM, DOOR_TX, DOOR_TY, DOOR_TO, DOOR_EX, DOOR_EY, obj_scene_at, obj_kind_at, obj_x_at, obj_y_at, door_from_at, door_tx_at, door_ty_at, door_to_at, door_ex_at, door_ey_at, NO_SCRIPT, obj_update, obj_interact, scene_init, TRIG_COUNT, TRIG_FROM, TRIG_TX, TRIG_TY, TRIG_TW, TRIG_TH, trigger_enter, trig_from_at, trig_tx_at, trig_ty_at, trig_tw_at, trig_th_at, warm, anim_tick
}
