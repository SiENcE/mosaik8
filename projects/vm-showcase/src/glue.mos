-- GENERATED by MosaiK8 Studio (mosaik_vm) -- the VM8 subsystem WIRING.
-- The fixed shell calls glue.setup() once; this wires SOUND (always) + the MUSIC
-- driver when the project has songs. Regenerated from project content, so adding a
-- song auto-wires music. Edit the project (tracker / Build > Options), not this file.
-- NOTE: music is turned OFF on lynx (Build > Options > Music) -- no driver +
-- (with [build] shake_exports) no song DATA is wired there, freeing code/
-- data on those consoles (the tight Lynx MAIN). Other consoles still play.
-- NOTE: no music driver on nes, so setup() forks and wires only sound there
-- (with [build] shake_exports the driver + song data cost them nothing).

module "glue" {
    import "vm.core"
    import "vm.snd"
    import "vm.music"
    import "songs"

    if platform == "gameboy" or platform == "gameboy_color" or platform == "analogue_pocket" or platform == "megaduck" or platform == "sms" or platform == "gamegear" or platform == "pce" {
        function setup() {
            core.set_sound(snd.sfx, snd.tone, snd.stop)
            core.set_music_voice(snd.mtone, snd.mstop)
            core.set_music_driver(music.play, music.update, music.stop)
            music.set_song(songs.channels, songs.chkind, songs.cell, songs.frames, songs.rows)
            music.set_voicing(songs.flags)
            core.set_music_ctl(music.pause, music.resume, music.mute)
        }
    } else {
        function setup() {
            core.set_sound(snd.sfx, snd.tone, snd.stop)
            core.set_music_voice(snd.mtone, snd.mstop)
        }
    }

    export setup
}
