    }

    -- Draw string `id` into the bottom text box. The row is
    -- SCREEN_ROWS-relative so the box sits at the BOTTOM of EVERY
    -- console (byte-identical on the 18-row GB/GG; on the 12-row
    -- Lynx a hardcoded row 15 fell OFF the short screen).
    function render_text(id: u8) {
        switch id {
            case 0 {
                text.print_string(core.box_left(), core.box_top(), "NEW GAME")
            }
            case 1 {
                text.print_string(core.box_left(), core.box_top(), "CONTINUE")
            }
            case 2 {
                var c: u8 = 0
                var v: u16 = 0
                c = core.box_left()
                text.print_string(c, core.box_top(), "BOOTS ")
