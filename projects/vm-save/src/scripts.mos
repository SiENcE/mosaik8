            }
        }
    }

    -- Draw menu option `id` at `row` with a cursor when selected.
    function render_choice(id: u8, row: u8, sel: u8) {
        if sel == 1 {
            text.print_string(1, row, ">")
        } else {
            text.print_string(1, row, " ")
        }
        switch id {
            case 0 {
                text.print_string(3, row, "NEW GAME")
            }
            case 1 {
                text.print_string(3, row, "CONTINUE")
            }
            case 2 {
                text.print_string(3, row, "BOOTS $boots$")
            }
            case 3 {
                text.print_string(3, row, "RESUME")
            }
            case 4 {
                text.print_string(3, row, "SAVE")
            }
            case 5 {
                text.print_string(3, row, "SAVED")
            }
