    const CODE: array[u8, 113] = [
        4, 8, 7, 6, 1, 1, 0, 32, 255, 11, 21, 0, 49, 0, 8, 2,
        0, 1, 1, 26, 0, 49, 0, 8, 1, 0, 8, 2, 0, 1, 0, 0,
