-- Game-slice world helpers (module "world"): the pure, stateless engine bits
-- shared by the game loop -- tile collision, the camera clamp, and a proximity
-- test. They take everything as parameters (no game state), so they live apart
-- from the stateful main module. Reads the tilemaps from the generated
-- "scenes" module (Layer-3 world.toml).

module "world" {
    import "scenes"

    const MAPW: u8 = 32      -- tilemap width (tiles)
    const TILE: u8 = 8       -- tile size (px)

    -- "Which tiles collide" is CONFIGURED in the world (world.toml [collision]
    -- solid -- editable in the studio), and the scene transpiler exports it as
    -- scenes.SOLID_TILES / scenes.is_solid(t). We READ that here instead of
    -- hardcoding, so adding a solid tile id is a data edit, no code change.
    -- (Hardcoding is still allowed: a local `function is_solid(t)` over a private
    -- const array works exactly the same -- just drop the [collision] solid set.)

    -- The room id selects the tilemap: 0=room0, 1=room1, 2=room2, 3=worldmap
    -- (matches the scene ids in world.toml). The maps are Layer-3 data now, so
    -- the generated `scenes` module owns the per-room picker.
    function tile_at(room: u8, px: u8, py: u8) -> u8 {
        var idx: u16 = (py / TILE) * MAPW + (px / TILE)
        return scenes.map_tile(room, idx)
    }

    -- Is the 16x16 box at (bx,by) overlapping a solid tile? Checks the four
    -- corners (inset 1 px) against the room's tilemap via the world's configured
    -- solid-tile set (scenes.is_solid).
    function box_solid(room: u8, bx: u8, by: u8) -> bool {
        if scenes.is_solid(tile_at(room, bx + 1, by + 1)) {
            return true
        }
        if scenes.is_solid(tile_at(room, bx + 14, by + 1)) {
            return true
        }
        if scenes.is_solid(tile_at(room, bx + 1, by + 14)) {
            return true
        }
        if scenes.is_solid(tile_at(room, bx + 14, by + 14)) {
            return true
        }
        return false
    }

    -- Camera on one axis: centre on the player, clamp to [0, maxcam].
    function cam_for(center: u8, half: u8, maxcam: u8) -> u8 {
        if center < half {
            return 0
        }
        var c: u8 = center - half
        if c > maxcam {
            return maxcam
        }
        return c
    }

    -- Manhattan-ish proximity (both axes within d) -- chest pickup / talk range.
    function within(ax: u8, ay: u8, bx: u8, by: u8, d: u8) -> bool {
        var dx: u8 = 0
        if ax > bx {
            dx = ax - bx
        } else {
            dx = bx - ax
        }
        var dy: u8 = 0
        if ay > by {
            dy = ay - by
        } else {
            dy = by - ay
        }
        return dx < d and dy < d
    }

    export tile_at, box_solid, cam_for, within
}
