    -- Load `scene`'s hardware palette set (background +
    -- sprite). Call it on room load, before painting.
    function load_palettes(scene: u8) {
        var off: u16 = scene
        off = off * PAL_STRIDE
        if platform == "sms" {
            -- Stage both banks (16 entries a layer = the
            -- 4 folded slots; bank 1 is the sprites') and
            -- load them in ONE native call. The entries are
            -- already native, so this is a plain copy.
            var i: u8 = 0
