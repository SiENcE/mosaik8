        -- RESIDENT and paint()/warm() call it instead of
        -- each carrying a copy.
        function ts_upload(scene: u8) {
            ts_slots(scene, TILE_COUNT)
            bkg.set_data_pal(0, TILE_COUNT, TILESET, TS_PAL_BUF)
        }
    } else {
    }

    -- Scratch attribute row paint_attrs fills, one row at a time.
    var ATTR_ROW: array[u8, 20]

    -- Upload `scene`'s background attribute map (the per-cell
    -- palette slots). Call it right after paint(); a graceful
    -- no-op on a console without per-tile palette hardware,
    -- which is why the caller needs no `if platform` fork.
    function paint_attrs(scene: u8) {
        if platform == "sms" or platform == "gamegear" {
        } else {
            var w: u8 = MAP_W
            var h: u8 = MAP_H
            var aw: u8 = 20
            var y: u8 = 0
            var base: u16 = 0
            if w < aw { aw = w }
            while y < h {
                for x in 0..aw {
                    ATTR_ROW[x] = tile_pal(scene, map_tile(scene, base + x))
                }
                bkg.set_attrs(0, y, aw, 1, ATTR_ROW)
                base = base + w
                y = y + 1
            }
        }
    }

    const OBJ_COUNT: u8 = 5
    const OBJ_SCENE: array[u8, 5] = [
        0, 0, 0, 1, 1
    ]
    const OBJ_KIND: array[u8, 5] = [
