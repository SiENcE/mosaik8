                    CRAM_BUF[i + 16] = cram(SPR_PAL[off + i])
                    i += 1
                }
                palette.load_native(0, 2, CRAM_BUF)
            } else {
                palette.load_bkg_set(0, PAL_SLOTS, BKG_PAL, off)
                palette.load_sprite_set(0, PAL_SLOTS, SPR_PAL, off)
            }
        }
    }

