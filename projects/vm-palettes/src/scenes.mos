    ]
    }

    const TILE_PAL_OFF: array[u8, 2] = [
        0, 9
    ]

    -- The background palette slot tile `t` renders with in
    -- `scene` -- the one lookup every colour path shares.
    function tile_pal(scene: u8, t: u8) -> u8 {
        return TILE_PAL[TILE_PAL_OFF[scene] + t]
    }

