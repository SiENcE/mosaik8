    ]
    const OBJ_Y: array[u8, 5] = [
        64, 40, 104, 64, 104
    ]
    function obj_scene_at(i: u8) -> u8 {
        return OBJ_SCENE[i]
    }
    function obj_kind_at(i: u8) -> u8 {
        return OBJ_KIND[i]
    }
    function obj_x_at(i: u8) -> u8 {
        return OBJ_X[i]
    }
    function obj_y_at(i: u8) -> u8 {
        return OBJ_Y[i]
    }

    const DOOR_COUNT: u8 = 2
    const DOOR_FROM: array[u8, 2] = [
        0, 1
    ]
    const DOOR_TX: array[u8, 2] = [
        19, 0
    ]
    const DOOR_TY: array[u8, 2] = [
        9, 9
    ]
    const DOOR_TO: array[u8, 2] = [
        1, 0
    ]
    const DOOR_EX: array[u8, 2] = [
        16, 136
    ]
    const DOOR_EY: array[u8, 2] = [
        72, 72
    ]
    function door_from_at(i: u8) -> u8 {
