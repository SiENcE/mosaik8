-- vm-rpg -- the VM8 COMPOSITION shell (Stage 4 flagship): studio-demo's core loop
-- built by composing EVERY kit into one game. The player is native (vm.player); a
-- placed actor is dispatched by KIND on room load -- an ENEMY joins the vm.combat
-- pool, any other NPC (the elder) gets its vm.entity On Interact slot; a scriptable
-- trigger (vm.trigger) is the flag-gated door; the HUD is engine.hud hearts. The
-- shell reads the B-edge + player facing for the sword and reloads on death. Every
-- kit runs together, orchestrated by DATA (world.toml + the event scripts).

module "main" {
    import "platform.video"
    import "platform.input"
    import "graphics.sprite"
    import "graphics.bkg"
    import "scenes"
    import "scripts"
    import "vm.core"
    import "vm.player"
    import "vm.actor"
    import "vm.entity"
    import "vm.trigger"
    import "vm.combat"
    import "engine.hud"

    -- sprite tile 0 = player, 1 = enemy, 2 = heart, 3 = elder
    const SPRITES: array[u8, 64] = [
        0x00, 0x00, 0x7E, 0x7E, 0x7E, 0x7E, 0x7E, 0x7E,
        0x7E, 0x7E, 0x7E, 0x7E, 0x7E, 0x7E, 0x00, 0x00,
        0x00, 0x00, 0x66, 0x66, 0xFF, 0xFF, 0xFF, 0xFF,
        0xFF, 0xFF, 0x7E, 0x7E, 0x3C, 0x3C, 0x18, 0x18,
        0x00, 0x00, 0x6C, 0x6C, 0xFE, 0xFE, 0xFE, 0xFE,
        0x7C, 0x7C, 0x38, 0x38, 0x10, 0x10, 0x00, 0x00,
        0x3C, 0x3C, 0x42, 0x7E, 0x81, 0xFF, 0x81, 0xFF,
        0x81, 0xFF, 0x42, 0x7E, 0x3C, 0x3C, 0x00, 0x00
    ]

    const HUD_BASE = 9
    const PMAX_HP = 6

    var cur_room: u8 = 0
    var prev_b: u8 = 0
    var pstart_x: u16 = 48
    var pstart_y: u16 = 56

    function solid_at(x: u16, y: u16) -> bool {
        var cx: u16 = x / 8
        var cy: u16 = y / 8
        var idx: u16 = cy * scenes.MAP_W + cx
        return scenes.collision_at(cur_room, idx) == scenes.COLLIDE_SOLID
    }

    -- Room load: paint, then DISPATCH each placed actor by KIND -- an enemy joins
    -- the combat pool, any other NPC gets its On Interact slot -- and register this
    -- room's scriptable triggers (the gate). ONE actor pool, shared by both kits.
    function load_room(room: u8) {
        cur_room = room
        scenes.paint(room)
        entity.reset()
        -- clear the previous room's actors so none linger after a scene change
        actor.reset()
        combat.reset()

        var si: u16 = scenes.scene_init(room)
        if si != scenes.NO_SCRIPT {
            core.spawn(si)
        }

        var slot: u8 = 0
        for i in 0..scenes.OBJ_COUNT {
            if scenes.OBJ_SCENE[i] == room {
                if scenes.OBJ_KIND[i] != scenes.KIND_PLAYER {
                    if scenes.OBJ_KIND[i] == scenes.KIND_ENEMY {
                        actor.activate(slot, 1, scenes.OBJ_X[i], scenes.OBJ_Y[i])
                        combat.add(slot, 2)
                    } else {
                        actor.activate(slot, 3, scenes.OBJ_X[i], scenes.OBJ_Y[i])
                        entity.add(slot, scenes.NO_SCRIPT, scenes.NO_SCRIPT, scenes.obj_interact(i))
                    }
                    slot += 1
                }
            }
        }

        trigger.clear()
        for i in 0..scenes.TRIG_COUNT {
            if scenes.TRIG_FROM[i] == room {
                trigger.add(scenes.TRIG_TX[i] * 8, scenes.TRIG_TY[i] * 8, scenes.TRIG_TW[i] * 8, scenes.TRIG_TH[i] * 8, scenes.trigger_enter(i))
            }
        }
    }

    -- Player death (0 hearts): refill, respawn in the field, reload.
    function reset_game() {
        player.set_pos(pstart_x, pstart_y)
        combat.set_player_hp(PMAX_HP, PMAX_HP)
        load_room(0)
    }

    -- CHANGE_SCENE (the gate) lands here.
    function change(room: u8, x: u16, y: u16) {
        player.set_pos(x, y)
        load_room(room)
    }

    -- Per frame: player move, the interact poll, the trigger check, the combat tick
    -- (B-edge attack + player facing), then the HUD.
    function tick() {
        player.update()
        entity.update()
        trigger.update(player.pos_x(), player.pos_y(), 8, 8)
        var b: u8 = 0
        if input.held(INPUT_B) {
            b = 1
        }
        var atk: u8 = 0
        if b == 1 {
            if prev_b == 0 {
                atk = 1
            }
        }
        prev_b = b
        combat.update(atk, player.face())
        hud.hearts(HUD_BASE, combat.player_hp(), PMAX_HP, 4, 4, 9, SCREEN_HEIGHT)
    }

    function main() {
        -- Force the GBDK font init BEFORE the tileset upload (else the first
        -- dialogue box clobbers the tileset + blanks the background).
        core.font_preload()
        bkg.set_data(0, scenes.TILE_COUNT, scenes.TILESET)
        sprite.set_data(0, 4, SPRITES)
        for i in 0..PMAX_HP {
            sprite.set_tile(HUD_BASE + i, 2)
        }

        core.boot(scripts.fetch, scripts.render_text, scripts.ENTRY_main)
        core.set_change(change)
        combat.set_player_hp(PMAX_HP, PMAX_HP)
        combat.set_player_death(reset_game)

        for i in 0..scenes.OBJ_COUNT {
            if scenes.OBJ_SCENE[i] == 0 {
                if scenes.OBJ_KIND[i] == scenes.KIND_PLAYER {
                    pstart_x = scenes.OBJ_X[i]
                    pstart_y = scenes.OBJ_Y[i]
                }
            }
        }
        player.setup(0, pstart_x, pstart_y, 8, 8, 1, solid_at)
        load_room(0)
        core.set_player(tick)

        video.enable_lcd()
        video.show_background()
        video.show_sprites()
        core.run()
    }

    export main
}
