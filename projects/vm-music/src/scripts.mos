    import "platform.assets"
    import "vm.core"

    const CODE: array[u8, 48] = [
        66, 2, 33, 0, 66, 3, 36, 0, 66, 1, 36, 0, 66, 0, 38, 0,
        66, 4, 41, 0, 66, 5, 43, 0, 66, 6, 45, 0, 86, 0, 48, 0,
        0, 86, 0, 0, 84, 0, 80, 0, 0, 87, 0, 88, 0, 89, 4, 0
    ]

    const ENTRY_main: u16 = 0
    const ENTRY_play_song: u16 = 33
    const ENTRY_stop_song: u16 = 36
    const ENTRY_sfx: u16 = 38
    const ENTRY_pause_song: u16 = 41
    const ENTRY_resume_song: u16 = 43
    const ENTRY_mute_bass: u16 = 45

    -- Read one bytecode byte (the interpreter's fetch callback).
    -- Via the assets.code_byte SEAM: a plain CODE[off] on every
    -- directly-mapped console, and the Lynx cart PAGE-CACHE read
    -- when the blob is big enough to stream.
    function fetch(off: u16) -> u8 {
        return assets.code_byte(CODE, off)
    }

    -- The CODE WINDOW (vm.core.set_code_window, review V-5): lets the
    -- interpreter read the blob INLINE at its address inside a slice,
    -- mapping its ROM bank once per slice where it is banked. Pinned
    -- home (bank(0)) - a banked enter/leave would be undone by its own
    -- trampoline. Not on the Lynx, whose blob may be cart-streamed and
    -- has no fixed address: there fetch stays the page-cache read.
    -- Call scripts.code_window() once after core.boot (the generated
    -- rooms.start does); a shell that does not is unchanged.
    bank(0) local function code_enter() -> u8 {
        if platform == "lynx" {
            return 0
        } else {
            return assets.bank_enter(CODE)
        }
    }
    bank(0) local function code_leave(saved: u8) {
        if platform == "lynx" {
        } else {
            assets.bank_leave(saved)
        }
    }
    bank(0) function code_window() {
        if platform == "lynx" {
        } else {
            -- VM_CODE_BANKED is stated by the build ([build] bank_bytecode):
            -- a RESIDENT blob skips the per-slice enter/leave pair.
            if VM_CODE_BANKED {
                core.set_code_window(assets.address(CODE), code_enter, code_leave)
            } else {
                core.set_code_window_res(assets.address(CODE))
            }
        }
    }

    -- Lines per string: vm.core sizes the dialogue box from this
