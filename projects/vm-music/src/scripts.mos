    }

    -- Draw string `id` into the bottom text box. The row is
    -- SCREEN_ROWS-relative so the box sits at the BOTTOM of EVERY
    -- console (byte-identical on the 18-row GB/GG; on the 12-row
    -- Lynx a hardcoded row 15 fell OFF the short screen).
    function render_text(id: u8) {
        switch id {
            case 0 {
                text.print_string(core.box_left(), core.box_top(), "MUSIC DRIVER")
                text.print_string(core.box_left(), core.box_top() + 1, "START play  SEL/B stop")
                text.print_string(core.box_left(), core.box_top() + 2, "UP pause  DOWN resume")
                text.print_string(core.box_left(), core.box_top() + 3, "LEFT mute bass  A sfx")
