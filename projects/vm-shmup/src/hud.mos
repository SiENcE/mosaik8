-- GENERATED by MosaiK8 Studio (mosaik_vm) -- the overlay HUD (the HUD editor).
-- show(id) plots a panel onto the GB window band (labels + tiles + gauges +
-- number fields); update() refreshes a dynamic field only when its heap cell
-- changed (no redraw script needed) + runs an attached On Change script.
-- Regenerated from scripts/hud.toml.

module "hud" {
    import "vm.core"
    import "graphics.text"
    import "graphics.sprite"

    var active: u8 = 255        -- the shown panel index (255 = none)

    -- The HUD band's own glyph tiles, uploaded from the console font at
    -- run time. sms/gamegear/pce has a persistent tilemap and NO window layer,
    -- so a plotted band is a MAP cell: over a room bigger than the screen it
    -- would slide away with the level. Re-plotting it in screen space cannot
    -- fix that (a cell has no sub-tile position, so the band would sawtooth by
    -- up to 7 px), and neither can a raster split (the SMS VDP latches its
    -- vertical scroll once per frame). So the text is drawn with SPRITES,
    -- which live in screen space. Uploaded by show(), positioned per redraw.
    -- Every other console keeps the plotted text path, unchanged.
    -- The base tile is counted DOWN from the top of each console's sprite
    -- tile table, so the game's own sheet (which uploads from 0) is never
    -- touched. SMS/GG sprite patterns are a separate 192-slot VDP area (the
    -- emote's four sit at its top); the PCE's is the cc65 backend's 40-entry
    -- RAM table, so a big sheet there crowds the glyphs out rather than
    -- overwriting art (the engine drops an out-of-range tile upload).
    if platform == "sms" or platform == "gamegear" {
        const HUD_GLYPH_BASE: u8 = 186
    } else if platform == "pce" {
        const HUD_GLYPH_BASE: u8 = 38
    }
    -- The CHARACTERS the band draws, as codes: show() uploads each one's
    -- glyph from the console font the toolchain links (sprite.font_glyph),
    -- so no font's pixels are carried here.
    if platform == "sms" or platform == "gamegear" or platform == "pce" {
        const HUD_CHARS: array[u8, 2] = [
            72,   -- 'H'
            80   -- 'P'
        ]
    }
    var last_p0_e2: i16 = -1
    var last_p0_e2_m: i16 = -1

    if platform == "lynx" or platform == "pce" or platform == "sms" or platform == "gamegear" {
        local function draw_p0_e2() {
            var v: u8 = core.var_get(0)   -- php (gauge)
            var mv: u16 = core.var_get(1)   -- phpmax (max)
            if mv == 0 { mv = 1 }
            var vv: u16 = v
            var fill: u8 = vv * 6 / mv
            for gi in 0..6 {
                if gi < fill {
                    sprite.set_tile(34 + gi, 3)
                    sprite.move(34 + gi, 32 + gi * 8, (SCREEN_ROWS - 1 + 0) * 8)
                } else {
                    sprite.move(34 + gi, 0, SCREEN_HEIGHT)
                }
            }
            last_p0_e2 = core.var_get(0)
            last_p0_e2_m = core.var_get(1)
        }
    } else {
        local function draw_p0_e2() {
            var v: u8 = core.var_get(0)   -- php (gauge)
            var mv: u16 = core.var_get(1)   -- phpmax (max)
            if mv == 0 { mv = 1 }
            var vv: u16 = v
            var fill: u8 = vv * 6 / mv
            for gi in 0..6 {
                var gt: u8 = 101
                if gi < fill { gt = 100 }
                text.plot_tile(4 + gi, SCREEN_ROWS - 1 + 0, gt)
            }
            last_p0_e2 = core.var_get(0)
            last_p0_e2_m = core.var_get(1)
        }
    }
    local function draw0() {   -- hp-hud
        if platform == "sms" or platform == "gamegear" or platform == "pce" {
            sprite.set_tile(32, HUD_GLYPH_BASE + 0)
            sprite.move(32, 8, (SCREEN_ROWS - 1 + 0) * 8)   -- 'H'
            sprite.set_tile(33, HUD_GLYPH_BASE + 1)
            sprite.move(33, 16, (SCREEN_ROWS - 1 + 0) * 8)   -- 'P'
        } else {
            text.print_string(1, SCREEN_ROWS - 1 + 0, "HP")
        }
        draw_p0_e2()
    }
    local function show0() {
        text.to_window(SCREEN_ROWS - 1, 1)
        draw0()
        text.win_reveal()
    }
    local function update0() {
        if core.var_get(0) != last_p0_e2 or core.var_get(1) != last_p0_e2_m {
            draw_p0_e2()
        }
    }

    function show(id: u8) {
        active = id
        sprite.move(39, 0, SCREEN_HEIGHT)
        sprite.move(38, 0, SCREEN_HEIGHT)
        sprite.move(37, 0, SCREEN_HEIGHT)
        sprite.move(36, 0, SCREEN_HEIGHT)
        sprite.move(35, 0, SCREEN_HEIGHT)
        sprite.move(34, 0, SCREEN_HEIGHT)
        if platform == "sms" or platform == "gamegear" or platform == "pce" {
            for gi in 0..2 {
                sprite.font_glyph(HUD_GLYPH_BASE + gi, HUD_CHARS[gi])
            }
            sprite.move(33, 0, SCREEN_HEIGHT)
            sprite.move(32, 0, SCREEN_HEIGHT)
        }
        if id == 0 {
            show0()
        }
    }

    function update() {
        if active == 0 {
            update0()
        }
    }

    function draw() {
        if active == 0 {
            draw0()
        }
    }

    function hide() {
        text.to_bkg()
        sprite.move(39, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(38, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(37, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(36, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(35, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(34, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        if platform == "sms" or platform == "gamegear" or platform == "pce" {
            sprite.move(33, 0, SCREEN_HEIGHT)   -- park the band's text
            sprite.move(32, 0, SCREEN_HEIGHT)   -- park the band's text
        }
        active = 255
    }

    export show, update, draw, hide
}
