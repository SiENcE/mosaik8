    ]

    const MAP_OFF: array[u16, 11] = [
        0, 360, 1080, 2360, 2720, 3080, 3440, 3800, 4952, 6232, 6592
    ]

    -- E7: the CURRENT room's geometry, copied out of the per-room
    -- tables, so no resident function reads them and code banking
    -- keeps them out of bank 0. G_S is the scene the offset and
    -- chunk belong to; the BSS zeros are scene 0's (offset 0).
    var G_S: u8
    var G_W: u8
    var G_H: u8
    var G_OFF: u16
    var G_TSO: u16
    var G_TSC: u8

    function geom_set(scene: u8) {
        G_W = SCENE_W[scene]
        G_H = SCENE_H[scene]
        G_OFF = MAP_OFF[scene]
        G_TSO = TS_OFF[scene]
        G_TSC = TS_TC[scene]
        G_S = scene
    }

    -- Another scene's map offset (and chunk), for a reader asked
    -- about a scene the cache does not hold. Banked, like geom_set.
    function map_off_of(scene: u8) -> u16 {
        return MAP_OFF[scene]
    }

    -- Tile at flat index `idx` of `scene` -- O(1) window read
    -- through the range seam (streams on the Lynx / banks on
    -- the GB family; a resident index elsewhere) (item 33).
    function map_tile(scene: u8, idx: u16) -> u8 {
        var off: u16 = G_OFF
        if G_S != scene {
            off = map_off_of(scene)
        }
        return assets.range_byte(MAPS, off, idx)
    }

    -- Paint `scene`'s map -- ONE loop over the descriptor, the
    -- room's window streamed from the cart (item 33).
    function paint(scene: u8) {
        geom_set(scene)
        if platform == "sms" or platform == "gamegear" {
            if ts_keep == 0 {
                ts_upload(scene)
            }
        } else {
            var tsc: u8 = G_TSC
            if tsc == 0 {
                bkg.set_data(0, TILE_COUNT, TILESET)
            } else {
                var tso: u16 = G_TSO
                var tsn: u16 = tsc
                tsn = tsn * 16
                assets.range_base(TILESETS, 2096)
                assets.use_range(TILESETS, tso, tsn)
                bkg.set_data(0, tsc, assets.ptr_range(TILESETS, tso, tsn))
            }
        }
        var off: u16 = G_OFF
        var w: u8 = G_W
        var h: u8 = G_H
        var n: u16 = w * h
        assets.range_base(MAPS, 1280)
        assets.range_base(COLLISION, 1280)
        assets.use_range(COLLISION, off, n)
        bkg.set_tiles(0, 0, w, h, assets.ptr_range(MAPS, off, n))
    }

    -- Wide-room counterpart of paint(): upload the scene's
    -- tileset and warm its map/collision windows, but do NOT
    -- upload the map (engine.scroll streams it by column).
    function warm(scene: u8) {
        geom_set(scene)
        if platform == "sms" or platform == "gamegear" {
            ts_upload(scene)
        } else {
            var tsc: u8 = G_TSC
            if tsc == 0 {
                bkg.set_data(0, TILE_COUNT, TILESET)
            } else {
                var tso: u16 = G_TSO
                var tsn: u16 = tsc
                tsn = tsn * 16
                assets.range_base(TILESETS, 2096)
                assets.use_range(TILESETS, tso, tsn)
                bkg.set_data(0, tsc, assets.ptr_range(TILESETS, tso, tsn))
            }
        }
        var off: u16 = G_OFF
        var w: u8 = G_W
        var h: u8 = G_H
        var n: u16 = w * h
        assets.range_base(MAPS, 1280)
        assets.range_base(COLLISION, 1280)
        assets.use_range(COLLISION, off, n)
        assets.use_range(MAPS, off, n)
    }

