    -- Collision cell at flat index `idx` of `scene` -- O(1).
    function collision_at(scene: u8, idx: u16) -> u8 {
        var off: u16 = G_OFF
        if G_S != scene {
            off = map_off_of(scene)
        }
        return assets.range_byte(COLLISION, off, idx)
    }

