    const TILE_PAL_OFF: array[u16, 11] = [
        0, 26, 144, 275, 383, 450, 520, 578, 686, 801, 880
    ]

    -- The background palette slot tile `t` renders with in
    -- `scene` -- the one lookup every colour path shares.
    function tile_pal(scene: u8, t: u8) -> u8 {
        return TILE_PAL[TILE_PAL_OFF[scene] + t]
    }

    if platform == "sms" or platform == "gamegear" {
        -- The current scene's per-tile palette slots,
        -- copied out for the slot-rendered tile upload.
        var TS_PAL_BUF: array[u8, 131]

        function ts_slots(scene: u8, n: u8) {
            var t: u8 = 0
            while t < n {
                TS_PAL_BUF[t] = tile_pal(scene, t)
                t += 1
            }
        }

        -- The slot-rendered tileset upload, in ONE place:
        -- it reads the residency seam, so it is pinned
        -- RESIDENT and paint()/warm() call it instead of
        -- each carrying a copy.
        function ts_upload(scene: u8) {
            var tsc: u8 = G_TSC
            if tsc == 0 {
                ts_slots(scene, TILE_COUNT)
                bkg.set_data_pal(0, TILE_COUNT, TILESET, TS_PAL_BUF)
            } else {
                var tso: u16 = G_TSO
                var tsn: u16 = tsc
                tsn = tsn * 16
                assets.range_base(TILESETS, 2096)
                assets.use_range(TILESETS, tso, tsn)
                ts_slots(scene, tsc)
                bkg.set_data_pal(0, tsc, assets.ptr_range(TILESETS, tso, tsn), TS_PAL_BUF)
            }
        }
    } else {
    }

    -- Scratch attribute row paint_attrs fills, one row at a time.
    var ATTR_ROW: array[u8, 32]

    -- Upload `scene`'s background attribute map (the per-cell
    -- palette slots). Call it right after paint(); a graceful
    -- no-op on a console without per-tile palette hardware,
    -- which is why the caller needs no `if platform` fork.
    function paint_attrs(scene: u8) {
        if platform == "sms" or platform == "gamegear" {
        } else {
            var w: u8 = SCENE_W[scene]
            var h: u8 = SCENE_H[scene]
            var aw: u8 = 32
            var y: u8 = 0
            var base: u16 = 0
            if w < aw { aw = w }
            while y < h {
                for x in 0..aw {
                    ATTR_ROW[x] = tile_pal(scene, map_tile(scene, base + x))
                }
                bkg.set_attrs(0, y, aw, 1, ATTR_ROW)
                base = base + w
                y = y + 1
            }
        }
    }

