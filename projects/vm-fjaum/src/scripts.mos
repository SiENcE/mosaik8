        const STR_OFF: array[u16, 225] = [
            0, 19, 24, 36, 45, 53, 61, 70, 79, 88, 98, 107, 115, 124, 131, 139,
            148, 156, 164, 173, 182, 191, 199, 206, 214, 226, 234, 243, 252, 263, 269, 290,
            296, 302, 307, 311, 315, 319, 329, 335, 345, 352, 358, 365, 371, 373, 377, 381,
            385, 413, 443, 478, 484, 496, 508, 532, 558, 588, 603, 619, 636, 663, 680, 699,
            726, 751, 782, 815, 833, 852, 873, 903, 930, 953, 958, 963, 968, 973, 978, 983,
            989, 995, 1006, 1011, 1021, 1030, 1039, 1049, 1059, 1068, 1077, 1086, 1104, 1126, 1150, 1187,
            1211, 1225, 1243, 1258, 1274, 1296, 1323, 1345, 1361, 1369, 1375, 1393, 1410, 1442, 1460, 1478,
            1496, 1514, 1532, 1562, 1577, 1593, 1631, 1653, 1684, 1693, 1702, 1748, 1790, 1834, 1877, 1908,
            1954, 1996, 2044, 2084, 2125, 2172, 2220, 2251, 2270, 2311, 2357, 2363, 2369, 2373, 2381, 2386,
            2392, 2421, 2461, 2494, 2499, 2506, 2513, 2519, 2526, 2532, 2538, 2543, 2548, 2553, 2560, 2565,
            2586, 2627, 2633, 2638, 2643, 2659, 2679, 2695, 2736, 2744, 2789, 2826, 2855, 2859, 2862, 2886,
            2911, 2918, 2947, 2970, 2974, 2978, 2982, 2986, 2991, 3005, 3028, 3033, 3038, 3043, 3049, 3055,
            3060, 3065, 3071, 3076, 3083, 3117, 3132, 3143, 3158, 3168, 3210, 3214, 3226, 3238, 3250, 3262,
            3264, 3268, 3272, 3276, 3282, 3306, 3337, 3361, 3399, 3429, 3478, 3514, 3555, 3589, 3633, 3681,
            3729
        ]
        var _line: array[u8, 21]   -- scratch: one text line (<=20 cols + null)
        var _ret: u16 = 0          -- E12: where a list item returns to (0 = none)

        -- Draw string `id` (up to 3 lines split on 0x0A) at the bottom box,
        -- SCREEN_ROWS-relative (see the switch form for the row rationale).
        function render_text(id: u8) {
            var off: u16 = STR_OFF[id]
            var lineno: u8 = 0
            var done: u8 = 0
            _ret = 0
            while done == 0 {
                var col: u8 = core.box_left()
                var n: u8 = 0
                var ch: u8 = assets.code_byte(STRINGS, off)
                while ch != 0 and ch != 10 {
                    if ch == 1 {
                        _line[n] = 0
                        text.print_string(col, core.box_top() + lineno, _line)
                        col += n
                        off += 1
                        var vi: u8 = assets.code_byte(STRINGS, off)
                        var vv: u16 = core.var_get(vi)
                        text.print_number(col, core.box_top() + lineno, vv)
                        col += 1
                        if vv > 9 { col += 1 }
                        if vv > 99 { col += 1 }
                        if vv > 999 { col += 1 }
                        if vv > 9999 { col += 1 }
                        n = 0
                    } else if ch == 2 {
                        -- a $list[var]$ token: print item heap[var] of the list here
                        off += 1
                        var lb: u8 = assets.code_byte(STRINGS, off)
                        off += 1
                        var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                        if lb + lk < 225 {
                            _ret = off
                            off = STR_OFF[lb + lk] - 1
                        }
                    } else {
                        if n < 20 {
                            _line[n] = ch
                            n += 1
                        }
                    }
                    off += 1
                    ch = assets.code_byte(STRINGS, off)
                    if _ret != 0 {
                        if ch == 0 or ch == 10 {
                            off = _ret + 1
                            _ret = 0
                            ch = assets.code_byte(STRINGS, off)
                        }
                    }
                }
                _line[n] = 0
                text.print_string(col, core.box_top() + lineno, _line)
                if ch == 0 {
                    done = 1
                } else {
                    off += 1
                }
                lineno += 1
                if lineno >= 3 { done = 1 }
            }
        }

        var _ch: array[u8, 2]      -- scratch: one char + null

        -- Typewriter step: plot printable chars [from, upto), return the
        -- count plotted. Registered as core.set_text_step by rooms.mos.
        function render_text_step(id: u8, from: u8, upto: u8) -> u8 {
            var off: u16 = STR_OFF[id]
            var lineno: u8 = 0
            var col: u8 = core.box_left()
            var n: u8 = 0        -- chars on THIS line (the 20-col clamp)
            var idx: u8 = 0
            var drawn: u8 = 0
            _ret = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            while ch != 0 {
                if idx >= upto {
                    return drawn    -- past the window: nothing left to plot
                }
                if ch == 10 {
                    lineno += 1
                    col = core.box_left()
                    n = 0
                    if lineno >= 3 {
                        return drawn
                    }
                } else if ch == 1 {
                    -- a $var$ token: the digits appear as ONE step
                    off += 1
                    var vi: u8 = assets.code_byte(STRINGS, off)
                    var vv: u16 = core.var_get(vi)
                    if idx >= from {
                        text.print_number(col, core.box_top() + lineno, vv)
                        drawn += 1
                    }
                    col += 1
                    if vv > 9 { col += 1 }
                    if vv > 99 { col += 1 }
                    if vv > 999 { col += 1 }
                    if vv > 9999 { col += 1 }
                    idx += 1
                } else if ch == 2 {
                    -- a $list[var]$ token: print item heap[var] of the list here
                    off += 1
                    var lb: u8 = assets.code_byte(STRINGS, off)
                    off += 1
                    var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                    if lb + lk < 225 {
                        _ret = off
                        off = STR_OFF[lb + lk] - 1
                    }
                } else {
                    if idx >= from {
                        if n < 20 {     -- render_text's _line clamp
                            _ch[0] = ch
                            _ch[1] = 0
                            text.print_string(col, core.box_top() + lineno, _ch)
                        }
                        drawn += 1
                    }
                    col += 1
                    n += 1
                    idx += 1
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
                if _ret != 0 {
                    if ch == 0 or ch == 10 {
                        off = _ret + 1
                        _ret = 0
                        ch = assets.code_byte(STRINGS, off)
                    }
                }
            }
            return drawn
        }

        -- Draw menu option `id` at `row` with a cursor when selected.
        function render_choice(id: u8, row: u8, sel: u8) {
            if sel == 1 {
                text.print_string(1, row, ">")
            } else {
                text.print_string(1, row, " ")
            }
            var off: u16 = STR_OFF[id]
            var n: u8 = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            if ch == 2 {
                -- the option IS a list item: read item heap[var]
                off += 1
                var lb: u8 = assets.code_byte(STRINGS, off)
                off += 1
                var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                ch = 0
                if lb + lk < 225 {
                    off = STR_OFF[lb + lk]
                    ch = assets.code_byte(STRINGS, off)
                }
            }
            while ch != 0 and ch != 10 {
                if n < 20 {
                    _line[n] = ch
                    n += 1
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
            }
            _line[n] = 0
            text.print_string(3, row, _line)
        }

    }

    -- Data tables (scripts/tables.toml): a 6-byte header per table
    -- (cells u16, rows u16, row stride u8, cell width u8), then the
    -- cells row-major. vm.core's TBL_GET reads it byte by byte through
