            134, 9, 140, 9, 144, 9, 152, 9, 157, 9, 163, 9, 192, 9, 232, 9,
            15, 10, 20, 10, 27, 10, 34, 10, 40, 10, 47, 10, 53, 10, 59, 10,
            64, 10, 69, 10, 102, 10, 107, 10, 114, 10, 119, 10, 140, 10, 181, 10,
            187, 10, 192, 10, 197, 10, 213, 10, 233, 10, 249, 10, 34, 11, 42, 11,
            87, 11, 124, 11, 153, 11, 157, 11, 160, 11, 184, 11, 209, 11, 216, 11,
            245, 11, 12, 12, 16, 12, 20, 12, 24, 12, 28, 12, 33, 12, 47, 12,
            70, 12, 75, 12, 80, 12, 85, 12, 91, 12, 97, 12, 102, 12, 107, 12,
            113, 12, 118, 12, 125, 12, 159, 12, 174, 12, 185, 12, 200, 12, 210, 12,
            252, 12, 0, 13, 12, 13, 24, 13, 36, 13, 48, 13, 50, 13, 54, 13,
