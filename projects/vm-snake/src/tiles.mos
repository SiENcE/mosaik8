    -- All sixteen pens as PORTABLE 5-5-5 RGB words: palette.load_bkg16
    -- rounds each to the target's real depth. A no-op on a 2bpp console.
    const BKG_PALETTE16: array[u16, 16] = [
        2148, 5352, 23051, 31675, 12008, 24494, 4419, 32764,
        25805, 32441, 6695, 11525, 0, 0, 0, 0
