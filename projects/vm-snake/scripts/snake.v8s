; VM8 SNAKE - the whole game is bytecode; the host only draws heap cells.
;
; The board follows the .board convention: heap cells 0..19 are one 10-bit row
; mask each (bit 0 = the left column), and a set bit is a snake segment OR the
; food. The convention's "falling piece" overlay (22 PX, 23 PY, 24 MASK) is the
; snake's HEAD, a one-cell piece, so a .board view draws it brighter.
;
;   0..19 rows    20 FOOD X   21 FOOD Y   22 HEAD X   23 HEAD Y
;   24 HEAD MASK (1 while a snake is on the board)    25 NEXT (255 = none)
;   26 SCORE (food eaten; shown x10)   27 LENGTH   28 LEVEL
;   29 NOTE (0 none / 1 title / 2 game over - drawn IN the well by the host)
;   30 DIR  31 WANT (button ids: 4 up / 5 down / 6 left / 7 right)
;   32 HEAD INDEX  33 TAIL INDEX (into the ring)   34 NX  35 NY
;   36 NEW POS  37 TAIL POS   38 ROW ARG  39 ROW VALUE   40 RING ARG
;   41 RING VALUE   42 COUNTDOWN   43 BEST (survives a restart)
;   44 BOARD HEIGHT (host-seeded, see below)   64..127 the body RING
;
; A position is y * 16 + x. The body is a 64-entry RING of positions (cells
; 64..127): the head is pushed at HEAD INDEX, the tail popped at TAIL INDEX.
; VM8 has no computed heap addressing (spec R1), so the ring and the rows are
; reached through SWITCH tables (qread / qwrite / readrow / writerow), the
; VM8 idiom for an indexed table (the .board rows use it too). The ring caps
; the snake at 64 segments; past that it still eats and scores, it just stops
; getting longer.
;
; BOARD HEIGHT (cell 44) is the one number the HOST decides: 10 columns always,
; but only as many rows as the console can show with a wall above and below
; (20 on SMS / PC Engine, 16 on the Game Boy and Game Gear, 10 on the Lynx). A
; host that seeds nothing (the reference playground, the studio's simulator)
; gets the full 20-row .board.
;
; Threads: `main` owns EVERY game-state write. The four direction attachments
; only store the wanted heading in cell 31, and `main` checks it against a
; reversal when it takes a step. With one writer there is no critical section
; to protect, so the program is correct at the spec-minimum QUANT 16: a step
; that needs more instructions than one slice simply finishes on the next VM
; frame. Controls: the d-pad steers; A or START starts and restarts.

.board

main:
    RPN VAR 44 PUSH 0 EQ
    IF m_seeded
    SET_CONST 44, 20              ; no host seeded a height: the full .board
m_seeded:
    SET_CONST 25, 255             ; a snake has no NEXT preview
    SET_CONST 24, 0               ; and no head until a game starts
    SET_CONST 29, 1               ; the title note
    CALL w_press

new_game:
    SFX 4
    CALL clear
    SET_CONST 29, 0
    RPN GET_STATE 10              ; reseed from the frame the press landed on,
    SET_STATE 9                   ; so every game lays its food differently
    SET_CONST 26, 0
    SET_CONST 27, 3
    SET_CONST 28, 0
    SET_CONST 30, 7               ; heading right
    SET_CONST 31, 7
    SET_CONST 32, 2               ; ring: tail at 0, head at 2
    SET_CONST 33, 0
    SET_CONST 22, 4               ; the head, at (4, height / 2)
    RPN VAR 44 PUSH 2 DIV
    SET_VAR 23
    RPN VAR 23 PUSH 16 MUL PUSH 2 ADD
    SET_VAR 64
    RPN VAR 23 PUSH 16 MUL PUSH 3 ADD
    SET_VAR 65
    RPN VAR 23 PUSH 16 MUL PUSH 4 ADD
    SET_VAR 66
    RPN VAR 23
    SET_VAR 38
    SET_CONST 39, 28              ; columns 2, 3 and 4
    CALL writerow
    SET_CONST 24, 1               ; draw the head
    CALL place_food
    INPUT_ATTACH 4, h_up
    INPUT_ATTACH 5, h_down
    INPUT_ATTACH 6, h_left
    INPUT_ATTACH 7, h_right
    CALL setspeed

; THE STEP. A countdown of VM frames, then one move. The countdown is what the
; level shortens; the move itself is ~75 instructions, which at QUANT 16 spreads
; over five VM frames and so sets the floor of the snake's speed.
loop:
    IDLE
    RPN VAR 42 PUSH 1 SUB
    SET_VAR 42
    RPN VAR 42 PUSH 0 LE
    IF loop
    CALL setspeed
    RPN VAR 31 VAR 30 PUSH 1 B_XOR NE
    IF st_move                    ; the wanted heading reverses: ignore it
    RPN VAR 31
    SET_VAR 30
st_move:
    RPN VAR 22 VAR 30 PUSH 7 EQ ADD VAR 30 PUSH 6 EQ SUB
    SET_VAR 34
    RPN VAR 23 VAR 30 PUSH 5 EQ ADD VAR 30 PUSH 4 EQ SUB
    SET_VAR 35
    RPN VAR 34 PUSH 0 GE VAR 34 PUSH 9 LE AND VAR 35 PUSH 0 GE AND VAR 35 VAR 44 LT AND
    IF die                        ; off the board: the wall
    RPN VAR 35 PUSH 16 MUL VAR 34 ADD
    SET_VAR 36
    RPN VAR 33
    SET_VAR 40
    CALL qread
    RPN VAR 41
    SET_VAR 37                    ; where the tail is, before anything moves
    RPN VAR 35
    SET_VAR 38
    CALL readrow                  ; the head's new row
    RPN VAR 34 VAR 20 EQ VAR 35 VAR 21 EQ AND
    IF st_plain

; Eating: the food's bit is already set, so the head only joins the ring.
    SFX 0
    RPN VAR 26 PUSH 1 ADD
    SET_VAR 26
    RPN VAR 26 PUSH 5 DIV PUSH 4 MIN
    SET_VAR 28                    ; a level every five, up to the fifth
    CALL push_head
    RPN VAR 27 PUSH 64 LT
    IF st_full
    RPN VAR 27 PUSH 1 ADD
    SET_VAR 27                    ; grow: the tail stays where it is
    CALL place_food
    JUMP loop
st_full:
    CALL pop_tail                 ; the ring is full: move, do not grow
    CALL place_food
    JUMP loop

; A plain move. The cell the tail is about to leave is free this step, which is
; the one self-collision that is not a crash.
st_plain:
    RPN VAR 39 PUSH 1 VAR 34 SHL B_AND PUSH 0 EQ VAR 36 VAR 37 EQ OR
    IF die                        ; ran into itself
    CALL push_head
    RPN VAR 39 PUSH 1 VAR 34 SHL B_OR
    SET_VAR 39
    CALL writerow                 ; row arg is still the head's row
    RPN VAR 36 VAR 37 NE
    IF st_chase
    CALL pop_tail
    JUMP loop
st_chase:
    RPN VAR 33 PUSH 1 ADD PUSH 63 B_AND
    SET_VAR 33                    ; the head took the tail's cell: keep its bit
    JUMP loop

die:
    SFX 1
    RPN VAR 43 VAR 26 MAX
    SET_VAR 43
    SET_CONST 29, 2               ; the game-over note
    CALL w_press
    JUMP new_game

; COUNTDOWN = 5 - LEVEL VM frames between moves (LEVEL is 0..4). The move
; itself adds its own ~5 VM frames at QUANT 16, so level 1 is ~10 VM frames a
; cell and level 5 ~6.
setspeed:
    RPN PUSH 5 VAR 28 SUB PUSH 1 MAX
    SET_VAR 42
    RET

; Push the new head (cell 36) onto the ring and move the head overlay there.
push_head:
    RPN VAR 32 PUSH 1 ADD PUSH 63 B_AND
    SET_VAR 32
    RPN VAR 32
    SET_VAR 40
    RPN VAR 36
    SET_VAR 41
    CALL qwrite
    RPN VAR 34
    SET_VAR 22
    RPN VAR 35
    SET_VAR 23
    RET

; Pop the tail (its position is cell 37, read at the start of the step) and
; clear its bit.
pop_tail:
    RPN VAR 33 PUSH 1 ADD PUSH 63 B_AND
    SET_VAR 33
    RPN VAR 37 PUSH 4 SHR
    SET_VAR 38
    CALL readrow
    RPN VAR 39 PUSH 1 VAR 37 PUSH 15 B_AND SHL B_NOT B_AND
    SET_VAR 39
    CALL writerow
    RET

; Food at a random cell; if a segment is there, walk forward to the next free
; one. The snake is at most 64 of the board's cells, so the walk always ends.
; 240 divides evenly by every height a host seeds, so the row is uniform.
place_food:
    RPN RAND 10
    SET_VAR 20
    RPN RAND 240 VAR 44 MOD
    SET_VAR 21
pf_try:
    RPN VAR 21
    SET_VAR 38
    CALL readrow
    RPN VAR 39 PUSH 1 VAR 20 SHL B_AND PUSH 0 NE
    IF pf_ok                      ; that bit is clear: the cell is free
    RPN VAR 20 PUSH 1 ADD
    SET_VAR 20
    RPN VAR 20 PUSH 9 GT
    IF pf_try
    SET_CONST 20, 0
    RPN VAR 21 PUSH 1 ADD VAR 44 MOD
    SET_VAR 21
    JUMP pf_try
pf_ok:
    RPN VAR 39 PUSH 1 VAR 20 SHL B_OR
    SET_VAR 39
    CALL writerow
    RET

; Wait for a FRESH press of A or START: the release first, or a button still
; held from the last game would start the next one at once.
w_press:
    IDLE
    RPN GET_STATE 16 GET_STATE 18 OR
    IF w_down
    JUMP w_press
w_down:
    IDLE
    RPN GET_STATE 16 GET_STATE 18 OR
    IF w_down
    RET

; The direction attachments: store the wish, nothing else (see the header).
h_up:
    SET_CONST 31, 4
    STOP

h_down:
    SET_CONST 31, 5
    STOP

h_left:
    SET_CONST 31, 6
    STOP

h_right:
    SET_CONST 31, 7
    STOP

clear:
    SET_CONST 0, 0
    SET_CONST 1, 0
    SET_CONST 2, 0
    SET_CONST 3, 0
    SET_CONST 4, 0
    SET_CONST 5, 0
    SET_CONST 6, 0
    SET_CONST 7, 0
    SET_CONST 8, 0
    SET_CONST 9, 0
    SET_CONST 10, 0
    SET_CONST 11, 0
    SET_CONST 12, 0
    SET_CONST 13, 0
    SET_CONST 14, 0
    SET_CONST 15, 0
    SET_CONST 16, 0
    SET_CONST 17, 0
    SET_CONST 18, 0
    SET_CONST 19, 0
    RET

readrow:
    RPN VAR 38
    SWITCH 20, 0, rr0, 1, rr1, 2, rr2, 3, rr3, 4, rr4, 5, rr5, 6, rr6, 7, rr7, 8, rr8, 9, rr9, 10, rr10, 11, rr11, 12, rr12, 13, rr13, 14, rr14, 15, rr15, 16, rr16, 17, rr17, 18, rr18, 19, rr19
    RET

