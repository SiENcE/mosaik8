-- GENERATED by MosaiK8 Studio (mosaik_vm) -- the overlay HUD (the HUD editor).
-- show(id) plots a panel onto the GB window band (labels + tiles + gauges +
-- number fields); update() refreshes a dynamic field only when its heap cell
-- changed (no redraw script needed) + runs an attached On Change script.
-- Regenerated from scripts/hud.toml.

module "hud" {
    import "vm.core"
    import "graphics.text"
    import "graphics.sprite"
    import "scripts"

    var active: u8 = 255        -- the shown panel index (255 = none)
    var last_p0_e2: i16 = -1
    var last_p0_e3: i16 = -1
    var last_p0_e3_m: i16 = -1
    var last_p0_e6: i16 = -1

    local function draw_p0_e2() {
        var raw: i16 = core.var_get(0)   -- score
        var v: u8 = raw
        text.print_string(7, SCREEN_ROWS - 2 + 0, "000")
        var nd: u8 = 1
        if v >= 10 { nd = 2 }
        if v >= 100 { nd = 3 }
        var off: u8 = 0
        if nd < 3 { off = 3 - nd }
        text.print_number(7 + off, SCREEN_ROWS - 2 + 0, v)
        last_p0_e2 = raw
    }
    if platform == "lynx" or platform == "pce" {
        local function draw_p0_e3() {
            var v: u8 = core.var_get(1)   -- hp (gauge)
            var mv: u16 = core.var_get(2)   -- hpmax (max)
            if mv == 0 { mv = 1 }
            var vv: u16 = v
            var fill: u8 = vv * 5 / mv
            for gi in 0..5 {
                if gi < fill {
                    sprite.set_tile(35 + gi, 3)
                    sprite.move(35 + gi, 104 + gi * 8, (SCREEN_ROWS - 2 + 0) * 8)
                } else {
                    sprite.move(35 + gi, 0, SCREEN_HEIGHT)
                }
            }
            last_p0_e3 = core.var_get(1)
            last_p0_e3_m = core.var_get(2)
        }
    } else {
        local function draw_p0_e3() {
            var v: u8 = core.var_get(1)   -- hp (gauge)
            var mv: u16 = core.var_get(2)   -- hpmax (max)
            if mv == 0 { mv = 1 }
            var vv: u16 = v
            var fill: u8 = vv * 5 / mv
            for gi in 0..5 {
                var gt: u8 = 101
                if gi < fill { gt = 100 }
                text.plot_tile(13 + gi, SCREEN_ROWS - 2 + 0, gt)
            }
            last_p0_e3 = core.var_get(1)
            last_p0_e3_m = core.var_get(2)
        }
    }
    local function draw_p0_e6() {
        var raw: i16 = core.var_get(3)   -- hits
        var v: u8 = raw
        text.print_string(7, SCREEN_ROWS - 2 + 1, "000")
        var nd: u8 = 1
        if v >= 10 { nd = 2 }
        if v >= 100 { nd = 3 }
        var off: u8 = 0
        if nd < 3 { off = 3 - nd }
        text.print_number(7 + off, SCREEN_ROWS - 2 + 1, v)
        last_p0_e6 = raw
    }
    local function draw0() {   -- main-hud
        text.print_string(1, SCREEN_ROWS - 2 + 0, "SCORE")
        for tj4 in 0..1 {
            for ti4 in 0..1 {
                text.plot_tile(11 + ti4, SCREEN_ROWS - 2 + 0 + tj4, 100 + tj4 * 1 + ti4)
            }
        }
        text.print_string(1, SCREEN_ROWS - 2 + 1, "HITS")
        draw_p0_e2()
        draw_p0_e3()
        draw_p0_e6()
    }
    local function show0() {
        text.to_window(SCREEN_ROWS - 2, 2)
        draw0()
        text.win_reveal()
        sprite.set_tile(34, 2)
        sprite.move(34, 144, (SCREEN_ROWS - 2 + 0) * 8)   -- icon
    }
    local function update0() {
        if core.var_get(0) != last_p0_e2 {
            draw_p0_e2()
        }
        if core.var_get(1) != last_p0_e3 or core.var_get(2) != last_p0_e3_m {
            draw_p0_e3()
            core.spawn(scripts.ENTRY_on_hp)   -- On Change
        }
        if core.var_get(3) != last_p0_e6 {
            draw_p0_e6()
        }
    }

    function show(id: u8) {
        active = id
        sprite.move(39, 0, SCREEN_HEIGHT)
        sprite.move(38, 0, SCREEN_HEIGHT)
        sprite.move(37, 0, SCREEN_HEIGHT)
        sprite.move(36, 0, SCREEN_HEIGHT)
        sprite.move(35, 0, SCREEN_HEIGHT)
        sprite.move(34, 0, SCREEN_HEIGHT)
        if id == 0 {
            show0()
        }
    }

    function update() {
        if active == 0 {
            update0()
        }
    }

    function draw() {
        if active == 0 {
            draw0()
        }
    }

    function hide() {
        text.to_bkg()
        sprite.move(39, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(38, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(37, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(36, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(35, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        sprite.move(34, 0, SCREEN_HEIGHT)   -- park the HUD sprites
        active = 255
    }

    export show, update, draw, hide
}
