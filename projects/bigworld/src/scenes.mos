    -- Collision cell at flat index `idx` of `scene`.
    function collision_at(scene: u8, idx: u16) -> u8 {
        if scene == 0 {
            return ROOM00_COLLISION[idx]
        }
        if scene == 1 {
            return ROOM01_COLLISION[idx]
        }
        if scene == 2 {
            return ROOM02_COLLISION[idx]
        }
