        if scene == 25 {
            assets.use(ROOM25_MAP)
            assets.use(ROOM25_COLLISION)
            bkg.set_tiles(0, 0, MAP_W, MAP_H, assets.ptr(ROOM25_MAP))
        }
        if scene == 26 {
            assets.use(ROOM26_MAP)
            assets.use(ROOM26_COLLISION)
            bkg.set_tiles(0, 0, MAP_W, MAP_H, assets.ptr(ROOM26_MAP))
        }
        if scene == 27 {
            assets.use(ROOM27_MAP)
            assets.use(ROOM27_COLLISION)
            bkg.set_tiles(0, 0, MAP_W, MAP_H, assets.ptr(ROOM27_MAP))
        }
    }

