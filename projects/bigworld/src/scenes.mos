    -- Tile at flat index `idx` of `scene` (picks the map by id).
    function map_tile(scene: u8, idx: u16) -> u8 {
        if scene == 0 {
            return ROOM00_MAP[idx]
        }
        if scene == 1 {
            return ROOM01_MAP[idx]
        }
        if scene == 2 {
            return ROOM02_MAP[idx]
        }
        if scene == 3 {
            return ROOM03_MAP[idx]
        }
        if scene == 4 {
            return ROOM04_MAP[idx]
        }
        if scene == 5 {
            return ROOM05_MAP[idx]
        }
        if scene == 6 {
            return ROOM06_MAP[idx]
        }
        if scene == 7 {
            return ROOM07_MAP[idx]
        }
        if scene == 8 {
            return ROOM08_MAP[idx]
        }
        if scene == 9 {
            return ROOM09_MAP[idx]
        }
        if scene == 10 {
            return ROOM10_MAP[idx]
        }
        if scene == 11 {
            return ROOM11_MAP[idx]
        }
        if scene == 12 {
            return ROOM12_MAP[idx]
        }
        if scene == 13 {
            return ROOM13_MAP[idx]
        }
        if scene == 14 {
            return ROOM14_MAP[idx]
        }
        if scene == 15 {
            return ROOM15_MAP[idx]
        }
        if scene == 16 {
            return ROOM16_MAP[idx]
        }
        if scene == 17 {
            return ROOM17_MAP[idx]
        }
        if scene == 18 {
            return ROOM18_MAP[idx]
        }
        if scene == 19 {
            return ROOM19_MAP[idx]
        }
        if scene == 20 {
            return ROOM20_MAP[idx]
        }
        if scene == 21 {
            return ROOM21_MAP[idx]
        }
        if scene == 22 {
            return ROOM22_MAP[idx]
        }
        if scene == 23 {
            return ROOM23_MAP[idx]
        }
        if scene == 24 {
            return ROOM24_MAP[idx]
        }
        if scene == 25 {
            return ROOM25_MAP[idx]
        }
        if scene == 26 {
            return ROOM26_MAP[idx]
        }
        if scene == 27 {
            return ROOM27_MAP[idx]
        }
        return 0
    }

    -- Paint `scene`'s map to the background (call on room load,
    -- after bkg.set_data(0, TILE_COUNT, TILESET)).
    -- [world] stream: the per-scene map is fetched through the
    -- asset-residency seam (assets.use makes it resident, then
    -- assets.ptr hands its pointer to the setter) so the Lynx can
    -- load it from the cart here, at room load. Byte-identical on
    -- every directly-mapped console (use = no-op, ptr = the const).
    function paint(scene: u8) {
        if scene == 0 {
            assets.use(ROOM00_MAP)
            assets.use(ROOM00_COLLISION)
            bkg.set_tiles(0, 0, MAP_W, MAP_H, assets.ptr(ROOM00_MAP))
        }
        if scene == 1 {
            assets.use(ROOM01_MAP)
            assets.use(ROOM01_COLLISION)
            bkg.set_tiles(0, 0, MAP_W, MAP_H, assets.ptr(ROOM01_MAP))
