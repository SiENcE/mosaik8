        }
        if scene == 11 {
            return ROOM11_COLLISION[idx]
        }
        if scene == 12 {
            return ROOM12_COLLISION[idx]
        }
        if scene == 13 {
            return ROOM13_COLLISION[idx]
        }
        if scene == 14 {
            return ROOM14_COLLISION[idx]
        }
        if scene == 15 {
            return ROOM15_COLLISION[idx]
        }
        if scene == 16 {
