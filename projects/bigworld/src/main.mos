-- bigworld -- a SYNTHETIC many-scene world that overflows the Lynx resident
-- image (the 46,648-byte MAIN area: CODE + RODATA + DATA + BSS share it, no
-- banking, no overlays). It is the runtime fixture for the Lynx asset-streaming
-- plan: with streaming OFF every scene's map
-- + collision const lives resident at once, so the build overflows MAIN at LINK;
-- with streaming ON the per-scene data must move to a cart archive and load on
-- room change, building under 46.6 KB.
--
-- The world (24 rooms, maps + collision + doors) is DATA in world.toml
-- (assets/gen_world.py). This module owns a minimal real loop -- walk with the
-- collision LAYER (engine.collision.box_blocked over scenes.collision_at) + a
-- follow camera, step through doors to switch rooms -- so EVERY scene's map and
-- collision array is referenced (paint() and collision_at() select them all) and
-- nothing is tree-shaken. Regenerate:
--   python projects/bigworld/assets/gen_world.py
--   python mosaik_scenes.py projects/bigworld/world.toml -o projects/bigworld/src/scenes.mos

module "main" {
    import "platform.video"
    import "platform.input"
    import "graphics.sprite"
    import "graphics.bkg"
    import "scenes"
    import "engine.camera"
    import "engine.collision"

    const SPEED: u8 = 1
    const HALFW: u8 = SCREEN_WIDTH / 2
    const HALFH: u8 = SCREEN_HEIGHT / 2
    const MAXCAMX: u8 = 256 - SCREEN_WIDTH
    const MAXCAMY: u8 = 256 - SCREEN_HEIGHT

    -- One 8x8 player sprite (a little blob).
    const PLAYER_TILE: array[u8, 16] = [
        0x3C, 0x3C, 0x7E, 0x7E, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xDB, 0xDB, 0x7E, 0x7E, 0x3C, 0x3C
    ]

    var room: u8 = 0
    var px: u8 = 120
    var py: u8 = 120

    -- Collision cell at world pixel (x, y) of the current room (the per-scene
    -- collision layer lives in `scenes`).
    function cell(x: u8, y: u8) -> u8 {
        return scenes.collision_at(room, (y / 8) * scenes.MAP_W + (x / 8))
    }

    -- 16x16 box vs the collision layer (four inset corners; SOLID blocks).
    function solid(bx: u8, by: u8) -> bool {
        return collision.box_blocked(cell(bx + 1, by + 1), cell(bx + 14, by + 1), cell(bx + 1, by + 14), cell(bx + 14, by + 14))
    }

    -- Switch to room `id` and paint its map (the generated module owns the
    -- per-room background upload).
    function load_room(id: u8) {
        room = id
        scenes.paint(room)
    }

    function main() {
        bkg.set_data(0, scenes.TILE_COUNT, scenes.TILESET)
        sprite.set_data(0, 1, PLAYER_TILE)
        sprite.set_tile(0, 0)

        -- Start at the first scene's `player` object, if present.
        for i in 0..scenes.OBJ_COUNT {
            if scenes.OBJ_SCENE[i] == 0 and scenes.OBJ_KIND[i] == scenes.KIND_PLAYER {
                px = scenes.OBJ_X[i]
                py = scenes.OBJ_Y[i]
            }
        }

        load_room(0)
        video.enable_lcd()
        video.show_background()
        video.show_sprites()

        loop {
            -- Walk with collision, axis-separated for wall-sliding.
            if input.held(INPUT_LEFT) {
                if not solid(px - SPEED, py) { px -= SPEED }
            } else if input.held(INPUT_RIGHT) {
                if not solid(px + SPEED, py) { px += SPEED }
            }
            if input.held(INPUT_UP) {
                if not solid(px, py - SPEED) { py -= SPEED }
            } else if input.held(INPUT_DOWN) {
                if not solid(px, py + SPEED) { py += SPEED }
            }

            -- Door transition: when the player's BOX overlaps a door trigger cell,
            -- jump to its destination + entry. Match the box's inset CORNERS, not
            -- the centre cell -- a door on the edge column/row 0 can never equal a
            -- centre cell ((px+8)/8 is >= 1 for any px >= 0), so the left/top doors
            -- only ever fired by accident of u8 underflow (px wrapping 0 -> 255).
            -- The corners catch the player right at the doorway (px=0 -> dx0=0).
            -- BREAK after the first match: load_room mutates `room` but the trigger
            -- cells stay fixed, so without the break every later door whose
            -- FROM == the new room and trigger == this same cell fires too -- the
            -- whole chain shares the (31,16) east door, so one step would cascade
            -- room00 -> ... -> room27.
            var dx0: u8 = (px + 1) / 8
            var dx1: u8 = (px + 14) / 8
            var dy0: u8 = (py + 1) / 8
            var dy1: u8 = (py + 14) / 8
            for d in 0..scenes.DOOR_COUNT {
                if scenes.DOOR_FROM[d] == room and (scenes.DOOR_TX[d] == dx0 or scenes.DOOR_TX[d] == dx1) and (scenes.DOOR_TY[d] == dy0 or scenes.DOOR_TY[d] == dy1) {
                    px = scenes.DOOR_EX[d]
                    py = scenes.DOOR_EY[d]
                    load_room(scenes.DOOR_TO[d])
                    break
                }
            }

            camera.follow(px + 8, py + 8, HALFW, HALFH, MAXCAMX, MAXCAMY)
            sprite.move(0, px - camera.camx, py - camera.camy)
            video.wait_vblank()
        }
    }

    export main
}
