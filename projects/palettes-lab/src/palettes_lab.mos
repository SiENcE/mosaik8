-- palettes-lab -- a hand-written game over the world's colour tables
-- (generated by tools/gen_samples/palettes_lab_world.py). The palette library,
-- the slots and the per-tile / per-kind tables are the world's (edit them in the
-- studio's Palettes dock); this code only asks the scenes module to load them.
--
-- A = go to the other room. B = night on/off (a runtime palette write).

module "palettes_lab" {
    import "platform.video"
    import "platform.input"
    import "graphics.bkg"
    import "graphics.sprite"
    import "graphics.palette"
    import "scenes"

    -- OAM bases (each actor is a 2x2 metasprite) and sprite tile bases.
    const HERO: u8 = 0
    const NPC: u8 = 4
    const GEM: u8 = 8
    const T_HERO: u8 = 0
    const T_NPC: u8 = 8
    const T_GEM: u8 = 16
    -- Library index of the palette B writes into background slot 1.
    const NIGHT: u8 = 13
    -- The gem's two frame palettes: sprite slots 3 and 4 (slot 4 shows slot 0
    -- on the 4-slot consoles; the Palettes dock's Consoles tab says so).
    const GEM_SLOT_A: u8 = 3
    const GEM_SLOT_B: u8 = 4

    var room: u8 = 0
    var night: u8 = 0
    var tick: u8 = 0
    var gem_frame: u8 = 0
    var prev_a: u8 = 0
    var prev_b: u8 = 0

    -- SMS / Game Gear have one sprite palette per tile UPLOAD, not per sprite:
    -- a kind's slot rides its sheet through the 2bpp -> CRAM nibble map.
    if platform == "sms" or platform == "gamegear" {
        function upload_sprites() {
            palette.set_2bpp(0x3210)
            sprite.set_data(T_HERO, hero_tile_count, hero_tiles)
            palette.set_2bpp(0xBA90)
            sprite.set_data(T_NPC, npc_tile_count, npc_tiles)
            palette.set_2bpp(0xFED0)
            sprite.set_data(T_GEM, gem_tile_count, gem_tiles)
            palette.set_2bpp(0x3210)
        }
    } else {
        function upload_sprites() {
            sprite.set_data(T_HERO, hero_tile_count, hero_tiles)
            sprite.set_data(T_NPC, npc_tile_count, npc_tiles)
            sprite.set_data(T_GEM, gem_tile_count, gem_tiles)
        }
    }

    -- The DMG tab's registers (studio.toml [dmg]): BGP / OBP0 / OBP1 as the
    -- greys the port quantizes back to those shades. No palettes exist there.
    if platform == "gameboy" or platform == "megaduck" {
        function dmg_registers() {
            palette.set_bkg(0, palette.rgb(255, 255, 255), palette.rgb(170, 170, 170), palette.rgb(90, 90, 90), palette.rgb(0, 0, 0))
            palette.set_sprite(0, palette.rgb(255, 255, 255), palette.rgb(255, 255, 255), palette.rgb(170, 170, 170), palette.rgb(0, 0, 0))
            palette.set_sprite(1, palette.rgb(255, 255, 255), palette.rgb(255, 255, 255), palette.rgb(90, 90, 90), palette.rgb(0, 0, 0))
        }
    } else {
        function dmg_registers() {
        }
    }

    function dress_gem() {
        sprite.set_meta(GEM, T_GEM + gem_frame * 4, 2, 2)
        if gem_frame == 0 {
            sprite.set_palette(GEM, GEM_SLOT_A)
        } else {
            sprite.set_palette(GEM, GEM_SLOT_B)
        }
    }

    function dress() {
        -- per-CELL slots: head and body on two palettes
        sprite.set_meta(HERO, T_HERO, 2, 2)
        scenes.paint_actor(HERO, scenes.KIND_HERO, 2, 2)
        -- whole-sprite KIND slot
        sprite.set_meta(NPC, T_NPC, 2, 2)
        sprite.set_palette(NPC, scenes.KIND_PAL[scenes.KIND_NPC])
        dress_gem()
    }

    function place(r: u8) {
        sprite.move(HERO, 0, SCREEN_HEIGHT)
        sprite.move(NPC, 0, SCREEN_HEIGHT)
        sprite.move(GEM, 0, SCREEN_HEIGHT)
        for i in 0..scenes.OBJ_COUNT {
            if scenes.OBJ_SCENE[i] == r {
                var k: u8 = scenes.OBJ_KIND[i]
                var x: u8 = scenes.OBJ_X[i]
                var y: u8 = scenes.OBJ_Y[i]
                if k == scenes.KIND_HERO {
                    sprite.move(HERO, x, y)
                }
                if k == scenes.KIND_NPC {
                    sprite.move(NPC, x, y)
                }
                if k == scenes.KIND_GEM {
                    sprite.move(GEM, x, y)
                }
            }
        }
    }

    function load_room(r: u8) {
        scenes.load_palettes(r)     -- the room's 8 + 8 slots (world default or its own)
        scenes.paint(r)             -- on SMS / Game Gear this uploads the tiles through their slots
        scenes.paint_attrs(r)       -- the per-tile slots as attributes (GBC / NES / PCE)
        dmg_registers()
        if night == 1 {
            scenes.set_palette(1, 1, NIGHT)
        }
        place(r)
    }

    function main() {
        bkg.set_data(0, scenes.TILE_COUNT, scenes.TILESET)
        upload_sprites()
        dress()
        load_room(0)

        video.enable_lcd()
        video.show_background()
        video.show_sprites()

        loop {
            var a: u8 = 0
            var b: u8 = 0
            if input.held(INPUT_A) {
                a = 1
            }
            if input.held(INPUT_B) {
                b = 1
            }
            if a == 1 and prev_a == 0 {
                room = 1 - room
                load_room(room)
            }
            if b == 1 and prev_b == 0 {
                night = 1 - night
                if night == 1 {
                    scenes.set_palette(1, 1, NIGHT)
                } else {
                    scenes.load_palettes(room)
                    dmg_registers()
                }
            }
            prev_a = a
            prev_b = b
            tick += 1
            if tick == 20 {
                tick = 0
                gem_frame = 1 - gem_frame
                dress_gem()
            }
            video.wait_vblank()
        }
    }

    export main
}
