        79, 10, 83, 72, 65, 82, 68, 76, 73, 78, 71, 63, 32, 84, 72, 69,
        10, 71, 82, 65, 83, 83, 32, 73, 83, 32, 82, 73, 83, 75, 89, 33,
        0, 87, 82, 69, 78, 58, 32, 84, 72, 69, 82, 69, 32, 89, 79, 85,
        10, 65, 82, 69, 33, 32, 77, 73, 78, 69, 32, 66, 69, 65, 84, 83,
        10, 89, 79, 85, 82, 83, 46, 32, 87, 65, 84, 67, 72, 33, 0, 80,
        65, 82, 84, 89, 0, 73, 84, 69, 77, 83, 0, 84, 82, 65, 73, 78,
        69, 82, 0, 67, 76, 79, 83, 69, 0, 78, 79, 32, 83, 72, 65, 82,
        68, 76, 73, 78, 71, 83, 32, 89, 69, 84, 46, 10, 83, 69, 69, 32,
