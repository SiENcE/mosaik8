            146, 4, 161, 4, 177, 4, 199, 4, 226, 4, 248, 4, 8, 5, 16, 5,
            22, 5, 40, 5, 57, 5, 89, 5, 107, 5, 125, 5, 143, 5, 161, 5,
            179, 5, 209, 5, 224, 5, 240, 5, 22, 6, 31, 6, 40, 6, 86, 6,
            132, 6, 176, 6, 219, 6, 255, 6, 45, 7, 90, 7, 138, 7, 178, 7,
            219, 7, 10, 8, 58, 8, 89, 8, 108, 8, 153, 8, 199, 8, 205, 8,
            211, 8, 219, 8, 227, 8, 232, 8, 238, 8, 16, 9, 56, 9, 89, 9,
            95, 9, 102, 9, 108, 9, 115, 9, 120, 9, 126, 9, 132, 9, 137, 9,
            142, 9, 147, 9, 154, 9, 196, 9, 203, 9, 208, 9, 213, 9, 230, 9,
            250, 9, 10, 10, 55, 10, 63, 10, 113, 10, 150, 10, 179, 10, 183, 10,
            186, 10, 210, 10, 235, 10, 242, 10, 15, 11, 38, 11, 42, 11, 46, 11,
            50, 11, 54, 11, 59, 11, 73, 11, 96, 11, 102, 11, 108, 11, 114, 11,
            119, 11, 125, 11, 131, 11, 137, 11, 143, 11, 148, 11, 155, 11, 189, 11,
            204, 11, 215, 11, 230, 11, 240, 11, 27, 12, 31, 12, 43, 12, 55, 12,
            67, 12, 79, 12, 81, 12, 85, 12, 89, 12, 93, 12, 99, 12, 123, 12
        ]
        -- The index is read under its bank's window, so these readers
        -- stay home with the renderers (this module never banks).
        function str_off(sid: u16) -> u16 {
            var k: u16 = sid * 2
            var o: u16 = assets.code_byte(STR_IX, k + 1)
            return o * 256 + assets.code_byte(STR_IX, k)
        }

        var _line: array[u8, 21]   -- scratch: one text line (<=20 cols + null)
        var _ret: u16 = 0          -- E12: where a list item returns to (0 = none)

        -- Draw string `id` (up to 3 lines split on 0x0A) at the bottom box,
        -- SCREEN_ROWS-relative (see the switch form for the row rationale).
        function render_text(id: u8) {
            var off: u16 = str_off(id)
            var lineno: u8 = 0
            var done: u8 = 0
            _ret = 0
            while done == 0 {
                var col: u8 = core.box_left()
                var n: u8 = 0
                var ch: u8 = assets.code_byte(STRINGS, off)
                while ch != 0 and ch != 10 {
                    if ch == 1 {
                        _line[n] = 0
                        text.print_string(col, core.box_top() + lineno, _line)
                        col += n
                        off += 1
                        var vi: u8 = assets.code_byte(STRINGS, off)
                        var vv: u16 = core.var_get(vi)
                        text.print_number(col, core.box_top() + lineno, vv)
                        col += 1
                        if vv > 9 { col += 1 }
                        if vv > 99 { col += 1 }
                        if vv > 999 { col += 1 }
                        if vv > 9999 { col += 1 }
                        n = 0
                    } else if ch == 2 {
                        -- a $list[var]$ token: print item heap[var] of the list here
                        off += 1
                        var lb: u8 = assets.code_byte(STRINGS, off)
                        off += 1
                        var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                        if lb + lk < 200 {
                            _ret = off
                            off = str_off(lb + lk) - 1
                        }
                    } else {
                        if n < 20 {
                            _line[n] = ch
                            n += 1
                        }
                    }
                    off += 1
                    ch = assets.code_byte(STRINGS, off)
                    if _ret != 0 {
                        if ch == 0 or ch == 10 {
                            off = _ret + 1
                            _ret = 0
                            ch = assets.code_byte(STRINGS, off)
                        }
                    }
                }
                _line[n] = 0
                text.print_string(col, core.box_top() + lineno, _line)
                if ch == 0 {
                    done = 1
                } else {
                    off += 1
                }
                lineno += 1
                if lineno >= 3 { done = 1 }
            }
        }

        var _ch: array[u8, 2]      -- scratch: one char + null

        -- Typewriter step: plot printable chars [from, upto), return the
        -- count plotted. Registered as core.set_text_step by rooms.mos.
        function render_text_step(id: u8, from: u8, upto: u8) -> u8 {
            var off: u16 = str_off(id)
            var lineno: u8 = 0
            var col: u8 = core.box_left()
            var n: u8 = 0        -- chars on THIS line (the 20-col clamp)
            var idx: u8 = 0
            var drawn: u8 = 0
            _ret = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            while ch != 0 {
                if idx >= upto {
                    return drawn    -- past the window: nothing left to plot
                }
                if ch == 10 {
                    lineno += 1
                    col = core.box_left()
                    n = 0
                    if lineno >= 3 {
                        return drawn
                    }
                } else if ch == 1 {
                    -- a $var$ token: the digits appear as ONE step
                    off += 1
                    var vi: u8 = assets.code_byte(STRINGS, off)
                    var vv: u16 = core.var_get(vi)
                    if idx >= from {
                        text.print_number(col, core.box_top() + lineno, vv)
                        drawn += 1
                    }
                    col += 1
                    if vv > 9 { col += 1 }
                    if vv > 99 { col += 1 }
                    if vv > 999 { col += 1 }
                    if vv > 9999 { col += 1 }
                    idx += 1
                } else if ch == 2 {
                    -- a $list[var]$ token: print item heap[var] of the list here
                    off += 1
                    var lb: u8 = assets.code_byte(STRINGS, off)
                    off += 1
                    var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                    if lb + lk < 200 {
                        _ret = off
                        off = str_off(lb + lk) - 1
                    }
                } else {
                    if idx >= from {
                        if n < 20 {     -- render_text's _line clamp
                            _ch[0] = ch
                            _ch[1] = 0
                            text.print_string(col, core.box_top() + lineno, _ch)
                        }
                        drawn += 1
                    }
                    col += 1
                    n += 1
                    idx += 1
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
                if _ret != 0 {
                    if ch == 0 or ch == 10 {
                        off = _ret + 1
                        _ret = 0
                        ch = assets.code_byte(STRINGS, off)
                    }
                }
            }
            return drawn
        }

        -- Draw menu option `id` at `row` with a cursor when selected.
        function render_choice(id: u8, row: u8, sel: u8) {
            if sel == 1 {
                text.print_string(1, row, ">")
            } else {
                text.print_string(1, row, " ")
            }
            var off: u16 = str_off(id)
            var n: u8 = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            if ch == 2 {
                -- the option IS a list item: read item heap[var]
                off += 1
                var lb: u8 = assets.code_byte(STRINGS, off)
                off += 1
                var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                ch = 0
                if lb + lk < 200 {
                    off = str_off(lb + lk)
                    ch = assets.code_byte(STRINGS, off)
                }
            }
            while ch != 0 and ch != 10 {
                if n < 20 {
                    _line[n] = ch
                    n += 1
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
            }
            _line[n] = 0
            text.print_string(3, row, _line)
        }

