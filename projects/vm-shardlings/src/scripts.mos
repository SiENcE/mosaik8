        1, 13, 10, 72, 80, 32, 1, 76, 47, 1, 16, 32, 65, 84, 75, 32,
        1, 19, 10, 88, 80, 32, 1, 77, 47, 1, 78, 32, 68, 69, 70, 32,
        1, 21, 0, 80, 79, 84, 73, 79, 78, 83, 32, 32, 120, 1, 4, 10,
        83, 72, 65, 82, 68, 83, 32, 32, 32, 120, 1, 5, 0, 80, 79, 84,
        73, 79, 78, 0, 83, 72, 65, 82, 68, 0, 66, 65, 67, 75, 0, 78,
        79, 32, 80, 79, 84, 73, 79, 78, 83, 32, 76, 69, 70, 84, 46, 0,
        72, 80, 32, 73, 83, 32, 65, 76, 82, 69, 65, 68, 89, 10, 70, 85,
        76, 76, 46, 0, 72, 80, 32, 85, 80, 32, 84, 79, 10, 1, 76, 47,
        1, 16, 33, 0, 84, 72, 82, 79, 87, 32, 83, 72, 65, 82, 68, 83,
        32, 73, 78, 10, 66, 65, 84, 84, 76, 69, 32, 84, 79, 32, 67, 65,
        84, 67, 72, 10, 65, 32, 83, 72, 65, 82, 68, 76, 73, 78, 71, 46,
        0, 71, 79, 76, 68, 32, 32, 32, 1, 6, 10, 83, 69, 69, 78, 32,
        32, 32, 1, 79, 10, 79, 87, 78, 69, 68, 32, 32, 1, 81, 0
    ]
    const STR_OFF: array[u16, 106] = [
        0, 28, 49, 58, 67, 77, 86, 94, 102, 109, 117, 126, 134, 142, 151, 160,
        169, 178, 185, 191, 197, 202, 206, 213, 223, 230, 240, 247, 253, 270, 286, 308,
        335, 355, 377, 394, 415, 435, 452, 472, 488, 522, 538, 564, 594, 609, 626, 643,
        668, 685, 704, 728, 749, 767, 777, 784, 794, 801, 807, 834, 859, 892, 910, 931,
        966, 992, 1016, 1053, 1062, 1108, 1154, 1198, 1241, 1277, 1323, 1368, 1416, 1456, 1497, 1544,
        1592, 1623, 1661, 1673, 1685, 1691, 1710, 1738, 1769, 1796, 1841, 1887, 1893, 1899, 1907, 1913,
        1947, 1987, 2013, 2020, 2026, 2031, 2048, 2068, 2084, 2129
    ]
    var _line: array[u8, 21]   -- scratch: one text line (<=20 cols + null)
    var _ret: u16 = 0          -- E12: where a list item returns to (0 = none)

    -- Draw string `id` (up to 3 lines split on 0x0A) at the bottom box,
    -- SCREEN_ROWS-relative (see the switch form for the row rationale).
    function render_text(id: u8) {
        var off: u16 = STR_OFF[id]
        var lineno: u8 = 0
        var done: u8 = 0
        _ret = 0
        while done == 0 {
            var col: u8 = core.box_left()
            var n: u8 = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            while ch != 0 and ch != 10 {
                if ch == 1 {
                    _line[n] = 0
                    text.print_string(col, core.box_top() + lineno, _line)
                    col += n
                    off += 1
                    var vi: u8 = assets.code_byte(STRINGS, off)
                    var vv: u16 = core.var_get(vi)
                    text.print_number(col, core.box_top() + lineno, vv)
                    col += 1
                    if vv > 9 { col += 1 }
                    if vv > 99 { col += 1 }
                    if vv > 999 { col += 1 }
                    if vv > 9999 { col += 1 }
                    n = 0
                } else if ch == 2 {
                    -- a $list[var]$ token: print item heap[var] of the list here
                    off += 1
                    var lb: u8 = assets.code_byte(STRINGS, off)
                    off += 1
                    var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                    if lb + lk < 106 {
                        _ret = off
                        off = STR_OFF[lb + lk] - 1
                    }
                } else {
                    if n < 20 {
                        _line[n] = ch
                        n += 1
                    }
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
                if _ret != 0 {
                    if ch == 0 or ch == 10 {
                        off = _ret + 1
                        _ret = 0
                        ch = assets.code_byte(STRINGS, off)
                    }
                }
            }
            _line[n] = 0
            text.print_string(col, core.box_top() + lineno, _line)
            if ch == 0 {
                done = 1
            } else {
                off += 1
            }
            lineno += 1
            if lineno >= 3 { done = 1 }
        }
    }

    var _ch: array[u8, 2]      -- scratch: one char + null

    -- Typewriter step: plot printable chars [from, upto), return the
    -- count plotted. Registered as core.set_text_step by rooms.mos.
    function render_text_step(id: u8, from: u8, upto: u8) -> u8 {
        var off: u16 = STR_OFF[id]
        var lineno: u8 = 0
        var col: u8 = core.box_left()
        var n: u8 = 0        -- chars on THIS line (the 20-col clamp)
        var idx: u8 = 0
        var drawn: u8 = 0
        _ret = 0
        var ch: u8 = assets.code_byte(STRINGS, off)
        while ch != 0 {
            if idx >= upto {
                return drawn    -- past the window: nothing left to plot
            }
            if ch == 10 {
                lineno += 1
                col = core.box_left()
                n = 0
                if lineno >= 3 {
                    return drawn
                }
            } else if ch == 1 {
                -- a $var$ token: the digits appear as ONE step
                off += 1
                var vi: u8 = assets.code_byte(STRINGS, off)
                var vv: u16 = core.var_get(vi)
                if idx >= from {
                    text.print_number(col, core.box_top() + lineno, vv)
                    drawn += 1
                }
                col += 1
                if vv > 9 { col += 1 }
                if vv > 99 { col += 1 }
                if vv > 999 { col += 1 }
                if vv > 9999 { col += 1 }
                idx += 1
            } else if ch == 2 {
                -- a $list[var]$ token: print item heap[var] of the list here
                off += 1
                var lb: u8 = assets.code_byte(STRINGS, off)
                off += 1
                var lk: u8 = core.var_get(assets.code_byte(STRINGS, off))
                if lb + lk < 106 {
                    _ret = off
                    off = STR_OFF[lb + lk] - 1
                }
            } else {
                if idx >= from {
                    if n < 20 {     -- render_text's _line clamp
                        _ch[0] = ch
                        _ch[1] = 0
                        text.print_string(col, core.box_top() + lineno, _ch)
                    }
                    drawn += 1
                }
                col += 1
                n += 1
                idx += 1
            }
            off += 1
            ch = assets.code_byte(STRINGS, off)
            if _ret != 0 {
                if ch == 0 or ch == 10 {
                    off = _ret + 1
                    _ret = 0
                    ch = assets.code_byte(STRINGS, off)
                }
            }
        }
        return drawn
    }

    -- Draw menu option `id` at `row` with a cursor when selected.
    function render_choice(id: u8, row: u8, sel: u8) {
        if sel == 1 {
            text.print_string(1, row, ">")
        } else {
            text.print_string(1, row, " ")
        }
        var off: u16 = STR_OFF[id]
        var n: u8 = 0
        var ch: u8 = assets.code_byte(STRINGS, off)
        while ch != 0 and ch != 10 {
            if n < 20 {
                _line[n] = ch
                n += 1
            }
            off += 1
            ch = assets.code_byte(STRINGS, off)
        }
        _line[n] = 0
        text.print_string(3, row, _line)
    }

    -- Data tables (scripts/tables.toml): a 6-byte header per table
    -- (cells u16, rows u16, row stride u8, cell width u8), then the
    -- cells row-major. vm.core's TBL_GET reads it byte by byte through
    -- table_byte (core.set_tables), the twin of fetch.
    const TABLES: array[u8, 172] = [
        12, 0, 16, 0, 4, 1, 76, 0, 16, 0, 6, 2, 0, 20, 7, 6,
        0, 24, 6, 9, 0, 22, 9, 6, 3, 19, 9, 5, 3, 18, 8, 6,
        3, 24, 8, 8, 1, 21, 7, 7, 1, 25, 8, 7, 1, 20, 8, 8,
        2, 20, 6, 10, 2, 24, 9, 8, 2, 23, 10, 9, 3, 22, 10, 7,
        2, 24, 9, 9, 1, 23, 9, 8, 4, 30, 12, 12, 5, 53, 58, 59,
        147, 0, 189, 55, 34, 3, 44, 1, 163, 43, 11, 67, 4, 39, 22, 7,
        62, 33, 37, 2, 42, 35, 29, 3, 20, 0, 23, 20, 206, 35, 5, 0,
        235, 7, 23, 42, 0, 0, 149, 46, 102, 56, 11, 0, 218, 52, 230, 26,
        60, 1, 73, 6, 231, 26, 20, 0, 194, 4, 117, 4, 20, 0, 69, 43,
        195, 4, 146, 0, 108, 16, 23, 44, 236, 0, 32, 4, 248, 14, 140, 1,
        43, 35, 150, 61, 168, 0, 182, 54, 210, 4, 0, 0
    ]
    function table_byte(off: u16) -> u8 {
        return assets.code_byte(TABLES, off)
    }

    export fetch, code_window, render_text, render_choice, text_lines, render_text_step, table_byte, ENTRY_main, ENTRY_battle, ENTRY_sp_stats, ENTRY_calc_damage, ENTRY_add_caught, ENTRY_heal_party, ENTRY_party_load, ENTRY_party_store, ENTRY_draw_hud, ENTRY_draw_names, ENTRY_title, ENTRY_field_init, ENTRY_elder_talk, ENTRY_kid_talk, ENTRY_rival_talk, ENTRY_grass_in_1, ENTRY_grass_out, ENTRY_encounter_tick, ENTRY_house_init, ENTRY_mom_talk, ENTRY_shop_talk, ENTRY_buy_potion, ENTRY_buy_shard, ENTRY_to_mossway, ENTRY_to_ridge, ENTRY_title_glint, ENTRY_glow_tick, ENTRY_kid_walk, ENTRY_wren_spot, ENTRY_pause_menu, ENTRY_menu_party, ENTRY_party_card, ENTRY_menu_items, ENTRY_menu_trainer, ENTRY_menu_watch
}
