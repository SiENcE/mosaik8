        10, 46, 46, 46, 65, 76, 76, 32, 66, 69, 84, 84, 69, 82, 33, 0,
        67, 76, 69, 82, 75, 58, 32, 87, 69, 76, 67, 79, 77, 69, 32, 84,
        79, 10, 84, 69, 83, 83, 69, 76, 32, 83, 72, 79, 80, 33, 0, 89,
