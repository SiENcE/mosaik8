            66, 66, 76, 73, 84, 0, 67, 82, 65, 71, 79, 65, 84, 0, 71, 69,
            79, 68, 82, 65, 75, 69, 0, 83, 84, 69, 65, 77, 79, 84, 72, 0,
            67, 76, 65, 89, 70, 69, 82, 78, 0, 76, 73, 76, 89, 80, 85, 70,
            70, 0, 84, 69, 83, 83, 82, 65, 0, 70, 73, 71, 72, 84, 0, 67,
            65, 84, 67, 72, 0, 73, 84, 69, 77, 0, 82, 85, 78, 0, 84, 65,
            67, 75, 76, 69, 0, 86, 73, 78, 69, 32, 76, 65, 83, 72, 0, 83,
            80, 76, 65, 83, 72, 0, 82, 79, 67, 75, 32, 84, 79, 83, 83, 0,
            67, 73, 78, 68, 69, 82, 0, 80, 82, 73, 83, 77, 0, 89, 79, 85,
            32, 85, 83, 69, 68, 10, 84, 65, 67, 75, 76, 69, 33, 0, 65, 32,
            67, 82, 73, 84, 73, 67, 65, 76, 32, 72, 73, 84, 33, 0, 73, 84,
            39, 83, 32, 83, 85, 80, 69, 82, 10, 69, 70, 70, 69, 67, 84, 73,
            86, 69, 33, 0, 73, 84, 39, 83, 32, 78, 79, 84, 32, 86, 69, 82,
            89, 10, 69, 70, 70, 69, 67, 84, 73, 86, 69, 46, 46, 46, 0, 89,
            79, 85, 32, 85, 83, 69, 68, 10, 86, 73, 78, 69, 32, 76, 65, 83,
            72, 33, 0, 84, 72, 69, 32, 70, 79, 69, 32, 87, 65, 83, 10, 80,
            79, 73, 83, 79, 78, 69, 68, 33, 0, 89, 79, 85, 32, 85, 83, 69,
            68, 10, 83, 80, 76, 65, 83, 72, 33, 0, 84, 72, 69, 32, 70, 79,
