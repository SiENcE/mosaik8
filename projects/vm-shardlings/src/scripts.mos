            103, 1, 142, 1, 148, 1, 160, 1, 172, 1, 196, 1, 222, 1, 252, 1,
            11, 2, 28, 2, 45, 2, 72, 2, 89, 2, 108, 2, 135, 2, 160, 2,
            191, 2, 224, 2, 242, 2, 5, 3, 26, 3, 56, 3, 83, 3, 106, 3,
            111, 3, 117, 3, 122, 3, 128, 3, 133, 3, 138, 3, 144, 3, 150, 3,
