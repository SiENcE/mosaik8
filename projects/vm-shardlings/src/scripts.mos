    ]
    var _line: array[u8, 21]   -- scratch: one text line (<=20 cols + null)

    -- Draw string `id` (up to 3 lines split on 0x0A) at the bottom box,
    -- SCREEN_ROWS-relative (see the switch form for the row rationale).
    function render_text(id: u8) {
        var off: u16 = STR_OFF[id]
        var lineno: u8 = 0
        var done: u8 = 0
        while done == 0 {
            var col: u8 = core.box_left()
            var n: u8 = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            while ch != 0 and ch != 10 {
                if ch == 1 {
                    _line[n] = 0
                    text.print_string(col, core.box_top() + lineno, _line)
                    col += n
                    off += 1
                    var vi: u8 = assets.code_byte(STRINGS, off)
                    var vv: u16 = core.var_get(vi)
                    text.print_number(col, core.box_top() + lineno, vv)
                    col += 1
                    if vv > 9 { col += 1 }
                    if vv > 99 { col += 1 }
                    if vv > 999 { col += 1 }
                    if vv > 9999 { col += 1 }
                    n = 0
                } else {
                    if n < 20 {
                        _line[n] = ch
                        n += 1
                    }
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
            }
            _line[n] = 0
            text.print_string(col, core.box_top() + lineno, _line)
            if ch == 0 {
                done = 1
            } else {
                off += 1
            }
            lineno += 1
            if lineno >= 3 { done = 1 }
        }
    }

    var _ch: array[u8, 2]      -- scratch: one char + null

    -- Typewriter step: plot printable chars [from, upto), return the
    -- count plotted. Registered as core.set_text_step by rooms.mos.
    function render_text_step(id: u8, from: u8, upto: u8) -> u8 {
        var off: u16 = STR_OFF[id]
        var lineno: u8 = 0
        var col: u8 = core.box_left()
        var n: u8 = 0        -- chars on THIS line (the 20-col clamp)
        var idx: u8 = 0
        var drawn: u8 = 0
        var ch: u8 = assets.code_byte(STRINGS, off)
        while ch != 0 {
            if idx >= upto {
                return drawn    -- past the window: nothing left to plot
            }
            if ch == 10 {
                lineno += 1
                col = core.box_left()
                n = 0
                if lineno >= 3 {
                    return drawn
                }
            } else if ch == 1 {
                -- a $var$ token: the digits appear as ONE step
                off += 1
                var vi: u8 = assets.code_byte(STRINGS, off)
                var vv: u16 = core.var_get(vi)
                if idx >= from {
                    text.print_number(col, core.box_top() + lineno, vv)
                    drawn += 1
                }
                col += 1
                if vv > 9 { col += 1 }
                if vv > 99 { col += 1 }
                if vv > 999 { col += 1 }
                if vv > 9999 { col += 1 }
                idx += 1
            } else {
                if idx >= from {
                    if n < 20 {     -- render_text's _line clamp
                        _ch[0] = ch
                        _ch[1] = 0
                        text.print_string(col, core.box_top() + lineno, _ch)
                    }
                    drawn += 1
                }
                col += 1
                n += 1
                idx += 1
            }
            off += 1
            ch = assets.code_byte(STRINGS, off)
        }
        return drawn
    }

    -- Draw menu option `id` at `row` with a cursor when selected.
    function render_choice(id: u8, row: u8, sel: u8) {
        if sel == 1 {
            text.print_string(1, row, ">")
        } else {
            text.print_string(1, row, " ")
        }
        var off: u16 = STR_OFF[id]
        var n: u8 = 0
        var ch: u8 = assets.code_byte(STRINGS, off)
        while ch != 0 and ch != 10 {
            if n < 20 {
                _line[n] = ch
                n += 1
            }
            off += 1
            ch = assets.code_byte(STRINGS, off)
        }
        _line[n] = 0
        text.print_string(3, row, _line)
    }

    export fetch, code_window, render_text, render_choice, text_lines, render_text_step, ENTRY_main, ENTRY_battle, ENTRY_sp_stats, ENTRY_calc_damage, ENTRY_add_caught, ENTRY_heal_party, ENTRY_party_load, ENTRY_party_store, ENTRY_draw_hud, ENTRY_title, ENTRY_field_init, ENTRY_elder_talk, ENTRY_kid_talk, ENTRY_rival_talk, ENTRY_grass_in_1, ENTRY_grass_out, ENTRY_encounter_tick
}
