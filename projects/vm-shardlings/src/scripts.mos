            73, 78, 71, 83, 32, 89, 69, 84, 46, 10, 83, 69, 69, 32, 84, 72,
            69, 32, 69, 76, 68, 69, 82, 33, 0, 2, 2, 12, 32, 76, 1, 13,
            10, 72, 80, 32, 1, 76, 47, 1, 16, 32, 65, 84, 75, 32, 1, 19,
            10, 88, 80, 32, 1, 77, 47, 1, 78, 32, 68, 69, 70, 32, 1, 21,
