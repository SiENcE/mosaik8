            39, 83, 32, 83, 85, 80, 69, 82, 10, 69, 70, 70, 69, 67, 84, 73,
            86, 69, 33, 0, 73, 84, 39, 83, 32, 78, 79, 84, 32, 86, 69, 82,
            89, 10, 69, 70, 70, 69, 67, 84, 73, 86, 69, 46, 46, 46, 0, 89,
            79, 85, 32, 85, 83, 69, 68, 10, 86, 73, 78, 69, 32, 76, 65, 83,
