        1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2,
        2, 1, 3, 3, 1, 1, 1, 3, 3, 3, 3, 3, 3, 3, 3, 3,
        3, 2, 3, 1, 1, 1, 1, 2, 2, 2, 3, 3, 1, 1, 1, 1,
        2, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3,
        3, 2, 1, 1, 1, 1, 2, 2, 3, 3
    ]
    function text_lines(id: u8) -> u8 {
        return STR_LINES[id]
    }

