        -- Each string's offset (little-endian u16, inside its chunk).
        const STR_IX: array[u8, 400] = [
            0, 0, 19, 0, 24, 0, 36, 0, 45, 0, 54, 0, 64, 0, 73, 0,
            81, 0, 89, 0, 96, 0, 104, 0, 113, 0, 121, 0, 129, 0, 138, 0,
            147, 0, 156, 0, 165, 0, 172, 0, 178, 0, 199, 0, 205, 0, 211, 0,
            216, 0, 220, 0, 224, 0, 231, 0, 241, 0, 248, 0, 2, 1, 9, 1,
