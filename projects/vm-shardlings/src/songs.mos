    const CHN: array[u8, 5] = [3, 3, 3, 3, 3]
    const CHOFF: array[u16, 5] = [0, 3, 6, 9, 12]
    const CELLOFF: array[u16, 5] = [0, 512, 1024, 1536, 2048]
    const LEN: array[u16, 5] = [32, 32, 32, 32, 16]
    const FLAGS: array[u8, 5] = [0, 0, 0, 0, 0]

    -- channel COUNT of a song.
    function channels(song: u8) -> u8 {
        return CHN[song]
    }
    -- KIND of channel `ch` (0 pulse / 1 wave / 2 noise).
    function chkind(song: u8, ch: u8) -> u8 {
        return CHKIND[CHOFF[song] + ch]
    }
    -- cell field: 0 = note, 1 = instrument, 2 = volume, 3 = fx cmd, 4 = fx param.
    function cell(song: u8, row: u16, ch: u8, field: u8) -> u8 {
        var i: u16 = CELLOFF[song] + row * (1 + CHN[song] * 5)
        return assets.code_byte(CELLS, i + 1 + ch * 5 + field)
    }
    function frames(song: u8, row: u16) -> u8 {
        var i: u16 = CELLOFF[song] + row * (1 + CHN[song] * 5)
        return assets.code_byte(CELLS, i)
    }
    function rows(song: u8) -> u16 {
        return LEN[song]
    }
    -- per-song VOICING flags (bit0 = GB pulse 2 plays music / bit1 = Lynx-SMS
    -- prefer the wave/bass channel over a 2nd pulse); 0 = the default routing.
    function flags(song: u8) -> u8 {
        return FLAGS[song]
    }

    export channels, chkind, cell, frames, rows, flags
}
