    const CHN: array[u8, 9] = [4, 4, 4, 4, 4, 4, 4, 4, 4]
    const CHOFF: array[u16, 9] = [0, 4, 8, 12, 16, 20, 24, 28, 32]
    const CELLOFF: array[u16, 9] = [0, 6720, 0, 5376, 10752, 0, 4032, 9408, 0]
    const LEN: array[u16, 9] = [320, 256, 256, 256, 128, 192, 256, 256, 256]
    const FLAGS: array[u8, 9] = [3, 3, 3, 3, 3, 3, 3, 3, 3]
    const CELLBLK: array[u8, 9] = [0, 0, 1, 1, 1, 2, 2, 2, 3]

    -- channel COUNT of a song.
    function channels(song: u8) -> u8 {
        return CHN[song]
    }
    -- KIND of channel `ch` (0 pulse / 1 wave / 2 noise).
    function chkind(song: u8, ch: u8) -> u8 {
        return CHKIND[CHOFF[song] + ch]
    }
    -- One byte of a song's cell blob. The chunk fork lives HERE
    -- rather than in both accessors: a seam read cannot bank, so
    -- each arm is resident image and duplicating it is expensive.
    local function cbyte(song: u8, off: u16) -> u8 {
        if CELLBLK[song] == 0 {
            return assets.code_byte(CELLS, off)
        } else if CELLBLK[song] == 1 {
            return assets.code_byte(CELLS2, off)
        } else if CELLBLK[song] == 2 {
            return assets.code_byte(CELLS3, off)
        } else {
            return assets.code_byte(CELLS4, off)
        }
    }

    -- cell field: 0 = note, 1 = instrument, 2 = volume, 3 = fx cmd, 4 = fx param.
    function cell(song: u8, row: u16, ch: u8, field: u8) -> u8 {
        var i: u16 = CELLOFF[song] + row * (1 + CHN[song] * 5)
        return cbyte(song, i + 1 + ch * 5 + field)
    }
    function frames(song: u8, row: u16) -> u8 {
        var i: u16 = CELLOFF[song] + row * (1 + CHN[song] * 5)
        return cbyte(song, i)
    }
    function rows(song: u8) -> u16 {
        return LEN[song]
    }
    -- per-song VOICING flags (bit0 = GB pulse 2 plays music / bit1 = Lynx-SMS
    -- prefer the wave/bass channel over a 2nd pulse); 0 = the default routing.
    function flags(song: u8) -> u8 {
        return FLAGS[song]
    }

    export channels, chkind, cell, frames, rows, flags
}
