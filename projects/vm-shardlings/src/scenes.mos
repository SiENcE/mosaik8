    -- VM8 entity script slots: a selector maps an entity to its
    -- event script entry (scripts.ENTRY_*), NO_SCRIPT = unbound.
    const NO_SCRIPT: u16 = 0xFFFF
    function obj_interact(i: u16) -> u16 {
        if i == 1 {
            return scripts.ENTRY_elder_talk
        }
        if i == 2 {
            return scripts.ENTRY_kid_talk
        }
        if i == 3 {
            return scripts.ENTRY_rival_talk
        }
        return NO_SCRIPT
    }

    function scene_init(scene: u8) -> u16 {
        if scene == 0 {
            return scripts.ENTRY_title
        }
        if scene == 1 {
            return scripts.ENTRY_field_init
        }
        if scene == 2 {
            return scripts.ENTRY_field_init
        }
        if scene == 3 {
            return scripts.ENTRY_battle
        }
        return NO_SCRIPT
    }

    const TRIG_COUNT: u8 = 5
    const TRIG_FROM: array[u8, 5] = [
