        63, 27, 6, 0, 63, 27, 37, 0, 63, 27, 25, 0, 63, 27, 3, 0,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0
    ]

    const SPR_PAL: array[u8, 224] = [
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0,
        0, 27, 3, 17, 0, 63, 6, 17, 0, 27, 11, 17, 0, 27, 3, 17,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0,
        0, 27, 3, 17, 0, 27, 7, 17, 47, 26, 24, 0, 47, 26, 24, 0,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0,
        0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21,
        0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21,
        0, 27, 3, 17, 0, 27, 38, 17, 47, 26, 24, 0, 47, 26, 24, 0,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0,
        0, 27, 3, 17, 0, 63, 6, 17, 47, 26, 24, 0, 47, 26, 24, 0,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0,
        0, 27, 3, 17, 0, 27, 37, 17, 47, 26, 24, 0, 47, 26, 24, 0,
        47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0, 47, 26, 24, 0
    ]
    } else {
    const BKG_PAL: array[u16, 224] = [
        29686, 18219, 6663, 2211, 31709, 23253, 13742, 4229,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        31738, 16139, 4548, 2179, 31738, 16139, 28966, 2179,
        31738, 16139, 6587, 2179, 31738, 16139, 20903, 2179,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 20903, 2211,
        29686, 18219, 18004, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 31709, 23253, 13742, 4229,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        32732, 29422, 19814, 4163, 32732, 29422, 11768, 4163,
        32732, 29422, 11913, 4163, 32732, 29422, 28903, 4163,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        32732, 29422, 19814, 4163, 32732, 29422, 11768, 4163,
        32732, 29422, 11913, 4163, 32732, 29422, 6587, 4163,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        32732, 29422, 19814, 4163, 32732, 29422, 11768, 4163,
        32732, 29422, 11913, 4163, 32732, 29422, 28903, 4163,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211
    ]

    const SPR_PAL: array[u16, 224] = [
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        0, 32597, 28902, 3140, 0, 31641, 17800, 3140,
        0, 32597, 29413, 3140, 0, 32597, 28902, 3140,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        0, 32597, 28902, 3140, 0, 32597, 30212, 3140,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        0, 30476, 12833, 0, 0, 30476, 12833, 0,
        0, 30476, 12833, 0, 0, 30476, 12833, 0,
