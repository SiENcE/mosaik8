    function trigger_leave(i: u16) -> u16 {
        if i == 0 {
            return scripts.ENTRY_grass_out
        }
        if i == 1 {
            return scripts.ENTRY_grass_out
        }
        if i == 2 {
            return scripts.ENTRY_grass_out
