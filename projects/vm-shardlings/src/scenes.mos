        }
        return NO_SCRIPT
    }

    -- No animated tiles: anim_tick() is a no-op, so the game
    -- loop can still call scenes.anim_tick() unconditionally.
    function anim_tick() {
    }

    -- REPLACEMENT TILE BANK (the reference engine's VM_REPLACE_TILE): the
    -- pixels a script may write into a background tile. Baked from
    -- its own art, so it costs no background VRAM - only the 16
    -- bytes a write names ever reach the hardware. The map keeps
    -- its index, which is what makes the change survive a scroll
    -- and a repaint (a changed MAP cell would not).
    const RTILE_COUNT: u8 = 11
    const RTILES: array[u8, 176] = [
        199, 199, 187, 187, 179, 179, 171, 171, 155, 155, 187, 187, 199, 199, 255, 255,
        239, 239, 207, 207, 239, 239, 239, 239, 239, 239, 239, 239, 199, 199, 255, 255,
        199, 199, 187, 187, 251, 251, 231, 231, 223, 223, 191, 191, 131, 131, 255, 255,
        135, 135, 251, 251, 251, 251, 199, 199, 251, 251, 251, 251, 135, 135, 255, 255,
        247, 247, 231, 231, 215, 215, 183, 183, 131, 131, 247, 247, 247, 247, 255, 255,
        131, 131, 191, 191, 135, 135, 251, 251, 251, 251, 187, 187, 199, 199, 255, 255,
        231, 231, 223, 223, 191, 191, 135, 135, 187, 187, 187, 187, 199, 199, 255, 255,
        131, 131, 251, 251, 247, 247, 239, 239, 223, 223, 223, 223, 223, 223, 255, 255,
        199, 199, 187, 187, 187, 187, 199, 199, 187, 187, 187, 187, 199, 199, 255, 255,
        199, 199, 187, 187, 187, 187, 195, 195, 251, 251, 247, 247, 207, 207, 255, 255,
        255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255
    ]
    var rt_buf: array[u8, 16]

    if platform == "sms" or platform == "gamegear" {
    const RT_PAL2BPP: array[u16, 4] = [ 0x3210, 0x7654, 0xBA98, 0xFEDC ]
    local function rt_pal(room: u8, t: u8) {
        palette.set_2bpp(RT_PAL2BPP[tile_pal(room, t) & 3])
    }
    local function rt_pal_off() {
        palette.set_2bpp(RT_PAL2BPP[0])
    }
    } else {
    local function rt_pal(room: u8, t: u8) {
    }
    local function rt_pal_off() {
    }
    }

    -- Write replacement tile `src` over background tile `dst`.
    -- core.set_bkg_tile registers this; the BKG_TILE ops call it.
    function replace_tile(room: u8, dst: u8, src: u8) {
        if src >= RTILE_COUNT {
            return
        }
        var b: u16 = src
        b = b * 16
        var i: u8 = 0
        while i < 16 {
            rt_buf[i] = RTILES[b + i]
            i += 1
        }
        rt_pal(room, dst)
        bkg.set_data(dst, 1, rt_buf)
        rt_pal_off()
    }

