    const MAP_OFF: array[u16, 7] = [
        0, 360, 1080, 2360, 2720, 3080, 3440
    ]

    -- Tile at flat index `idx` of `scene` -- O(1) window read
    -- through the range seam (streams on the Lynx / banks on
    -- the GB family; a resident index elsewhere) (item 33).
    function map_tile(scene: u8, idx: u16) -> u8 {
        return assets.range_byte(MAPS, MAP_OFF[scene], idx)
    }

    -- Paint `scene`'s map -- ONE loop over the descriptor, the
    -- room's window streamed from the cart (item 33).
    function paint(scene: u8) {
        if platform == "sms" or platform == "gamegear" {
            ts_upload(scene)
        } else {
            var tsc: u8 = TS_TC[scene]
            if tsc == 0 {
                bkg.set_data(0, TILE_COUNT, TILESET)
            } else {
                var tso: u16 = TS_OFF[scene]
                var tsn: u16 = tsc
                tsn = tsn * 16
                assets.range_base(TILESETS, 2160)
                assets.use_range(TILESETS, tso, tsn)
                bkg.set_data(0, tsc, assets.ptr_range(TILESETS, tso, tsn))
            }
        }
        var off: u16 = MAP_OFF[scene]
        var w: u8 = SCENE_W[scene]
        var h: u8 = SCENE_H[scene]
        var n: u16 = w * h
        assets.range_base(MAPS, 1280)
        assets.range_base(COLLISION, 1280)
        assets.use_range(COLLISION, off, n)
        bkg.set_tiles(0, 0, w, h, assets.ptr_range(MAPS, off, n))
    }

    -- Wide-room counterpart of paint(): upload the scene's
    -- tileset and warm its map/collision windows, but do NOT
    -- upload the map (engine.scroll streams it by column).
    function warm(scene: u8) {
        if platform == "sms" or platform == "gamegear" {
            ts_upload(scene)
        } else {
            var tsc: u8 = TS_TC[scene]
            if tsc == 0 {
                bkg.set_data(0, TILE_COUNT, TILESET)
            } else {
                var tso: u16 = TS_OFF[scene]
                var tsn: u16 = tsc
                tsn = tsn * 16
                assets.range_base(TILESETS, 2160)
                assets.use_range(TILESETS, tso, tsn)
                bkg.set_data(0, tsc, assets.ptr_range(TILESETS, tso, tsn))
            }
        }
        var off: u16 = MAP_OFF[scene]
        var w: u8 = SCENE_W[scene]
        var h: u8 = SCENE_H[scene]
        var n: u16 = w * h
        assets.range_base(MAPS, 1280)
        assets.range_base(COLLISION, 1280)
        assets.use_range(COLLISION, off, n)
        assets.use_range(MAPS, off, n)
    }

