    }
    function trigger_enter(i: u16) -> u16 {
        if i == 0 {
            return scripts.ENTRY_grass_in_1
        }
        if i == 1 {
            return scripts.ENTRY_grass_in_1
        }
        if i == 2 {
            return scripts.ENTRY_grass_in_1
        }
