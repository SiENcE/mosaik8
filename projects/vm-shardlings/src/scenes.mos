    -- Collision cell at flat index `idx` of `scene` -- O(1).
    function collision_at(scene: u8, idx: u16) -> u8 {
        return assets.range_byte(COLLISION, MAP_OFF[scene], idx)
    }

    -- The world's [[palette]] LIBRARY (`[world] pal_write`):
    -- 4 portable 5-5-5 colour words per entry, indexed by
    -- the library index a script names. Only a world that
    -- declares pal_write carries it.
    const PAL_LIB: array[u16, 100] = [
        29686, 18219, 6663, 2211, 31709, 23253, 13742, 4229,
        32695, 28332, 18823, 7298, 32666, 29032, 17541, 5186,
        28639, 14045, 5526, 2185, 0, 32597, 26854, 3140,
        0, 31641, 17800, 3140, 0, 32597, 30212, 3140,
        0, 32597, 29413, 3140, 0, 30476, 12833, 0,
        0, 17029, 7427, 0, 0, 17060, 4356, 0,
        0, 31671, 31168, 0, 0, 32583, 7336, 0,
        0, 20938, 6275, 0, 0, 29629, 7999, 69,
        0, 19983, 13641, 3137, 0, 32242, 10960, 0,
        0, 20047, 10537, 0, 0, 29527, 16843, 0,
        0, 24216, 7337, 0, 0, 30620, 23255, 1024,
        0, 21926, 2304, 0, 0, 31506, 12903, 1123,
        0, 3862, 15652, 0
    ]

    -- Write library palette `pal` into hardware slot `slot`
    -- of the SPRITE (layer 0) or BACKGROUND (layer 1)
    -- table. Registered as core.set_pal_write by the
    -- generated rooms.mos. It goes through graphics.palette
    -- rather than the hardware, so the CGB/SMS fade SHADOW
    -- records the write and a later ramp cannot undo it.
    -- A console with one palette per layer (DMG, NES) makes
    -- load_*_set an honest no-op, so a script's recolour is
    -- silently nothing there - the same degradation the rest
    -- of the colour tier has.
    function set_palette(layer: u8, slot: u8, pal: u8) {
        var off: u16 = pal
        off = off * 4
        if layer == 0 {
            palette.load_sprite_set(slot, 1, PAL_LIB, off)
        } else {
            palette.load_bkg_set(slot, 1, PAL_LIB, off)
        }
    }

    -- Per-scene hardware palettes: 8 slots x 4 colours per
    -- scene, concatenated. Colours are PORTABLE 5-5-5 RGB
    -- words (like BKG_PALETTE16) -- scenes.mos is one source
    -- compiled per console, so palette.load_bkg_set rounds
    -- each to the target's real depth at runtime. (The SMS
    -- is too shallow to round well at runtime and takes a
    -- build-time-fitted native table instead; see below.)
    -- A room loads its set with an offset of `room * 32`.
    const PAL_SLOTS: u8 = 8
    const PAL_STRIDE: u8 = 32
    if platform == "sms" {
        -- One CRAM entry per BYTE here, fitted at build
        -- time into the 64-colour BGR-222 gamut.
        var CRAM_BUF: array[u8, 32]
    const BKG_PAL: array[u8, 128] = [
        47, 9, 24, 0, 63, 42, 21, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 27, 6, 1, 63, 23, 2, 0, 63, 56, 36, 16,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 27, 6, 1, 63, 42, 21, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 63, 42, 21, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0
    ]

    const SPR_PAL: array[u8, 128] = [
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        0, 27, 22, 17, 0, 63, 6, 17, 0, 27, 11, 17, 0, 27, 22, 17,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        0, 27, 22, 17, 0, 27, 7, 17, 47, 9, 24, 0, 47, 9, 24, 0,
        47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0, 47, 9, 24, 0,
        0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21,
        0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21, 0, 27, 9, 21
    ]
    } else {
    const BKG_PAL: array[u16, 128] = [
        29686, 18219, 6663, 2211, 31709, 23253, 13742, 4229,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 32695, 28332, 18823, 7298,
        32666, 29032, 17541, 5186, 28639, 14045, 5526, 2185,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 32695, 28332, 18823, 7298,
        31709, 23253, 13742, 4229, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 31709, 23253, 13742, 4229,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211
    ]

    const SPR_PAL: array[u16, 128] = [
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        0, 32597, 26854, 3140, 0, 31641, 17800, 3140,
        0, 32597, 29413, 3140, 0, 32597, 26854, 3140,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        29686, 18219, 6663, 2211, 29686, 18219, 6663, 2211,
        0, 32597, 26854, 3140, 0, 32597, 30212, 3140,
