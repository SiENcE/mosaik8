        const PSRC: array[u8, 16] = [
            128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143
        ]
        const PFIX: array[u16, 16] = [
            0, 5120, 10240, 15392, 20544, 25728, 29920, 32096,
            32224, 32353, 32483, 32582, 32651, 32721, 32761, 32767
        ]
        const PLEV: array[u16, 1] = [
            0
        ]
        const PN: u8 = 16
        const PLN: u8 = 1
    }

    -- Upload ONE chunk of this scene. Steps 0..TSTEPS-1 are tile data (128
    -- bytes each, staged through gfx.buf), the rest are map rows. Returns 1
    -- after the last step. A part loads over ~0.5 s with the music running.
    function load_tiles(step: u8) {
        var off: u16 = step
        off = off << 7
        for i in 0..128 {
            gfx.buf[i] = TILES[off + i]
        }
        var first: u8 = step * TPS
        var n: u8 = TPS
        if first + n > NT {
            n = NT - first
        }
        vram.tiles(first, n)
    }

    function row(y: u8) {
        var o: u16 = y
        o = o << 5
        for i in 0..32 {
            gfx.buf[i] = MAP[o + i]
        }
        bkg.set_tiles(0, y, 32, 1, gfx.buf)
        if platform == "gameboy_color" {
            for i in 0..32 {
                gfx.buf[i] = ATTR[o + i]
            }
            bkg.set_attrs(0, y, 32, 1, gfx.buf)
        }
    }

    -- Install this scene's palette layout into the palette engine.
    function layout() {
        if platform == "gameboy" {
            pal.set_dmg(DMGN, DMGB)
        } else {
            for i in 0..PN {
                pal.src[i] = PSRC[i]
            }
            for i in 0..16 {
                pal.fix[i] = PFIX[i]
            }
            for i in 0..PLN {
                pal.lev[i] = PLEV[i]
            }
            pal.cyc_n = PLN
        }
        pal.touch()
    }

    function load(step: u8) -> u8 {
        var st: u8 = step
        if st < TSTEPS {
            load_tiles(st)
            return 0
        }
        st -= TSTEPS
        var y: u8 = st * RPS
        for k in 0..RPS {
            if y < MH {
                row(y)
            }
            y += 1
        }
        if y >= MH {
            return 1
        }
        return 0
    }
    export load, row, layout
}
