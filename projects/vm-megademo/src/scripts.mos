        69, 32, 83, 79, 85, 82, 67, 69, 0, 71, 73, 84, 72, 85, 66, 46,
        67, 79, 77, 10, 47, 83, 73, 69, 78, 67, 69, 47, 77, 79, 83, 65,
        73, 75, 56, 0, 84, 72, 65, 78, 75, 83, 32, 52, 32, 87, 65, 84,
        67, 72, 73, 78, 71, 10, 76, 79, 79, 80, 73, 78, 71, 32, 78, 79,
        87, 46, 46, 0
    ]
    const STR_OFF: array[u16, 8] = [
        0, 28, 55, 70, 96, 124, 153, 180
    ]
    var _line: array[u8, 21]   -- scratch: one text line (<=20 cols + null)

    -- Draw string `id` (up to 3 lines split on 0x0A) at the bottom box,
    -- SCREEN_ROWS-relative (see the switch form for the row rationale).
    function render_text(id: u8) {
        var off: u16 = STR_OFF[id]
        var lineno: u8 = 0
        var done: u8 = 0
        while done == 0 {
            var col: u8 = core.box_left()
            var n: u8 = 0
            var ch: u8 = assets.code_byte(STRINGS, off)
            while ch != 0 and ch != 10 {
                if ch == 1 {
                    _line[n] = 0
                    text.print_string(col, core.box_top() + lineno, _line)
                    col += n
                    off += 1
                    var vi: u8 = assets.code_byte(STRINGS, off)
                    var vv: u16 = core.var_get(vi)
                    text.print_number(col, core.box_top() + lineno, vv)
                    col += 1
                    if vv > 9 { col += 1 }
                    if vv > 99 { col += 1 }
                    if vv > 999 { col += 1 }
                    if vv > 9999 { col += 1 }
                    n = 0
                } else {
                    if n < 20 {
                        _line[n] = ch
                        n += 1
                    }
                }
                off += 1
                ch = assets.code_byte(STRINGS, off)
            }
            _line[n] = 0
            text.print_string(col, core.box_top() + lineno, _line)
            if ch == 0 {
                done = 1
            } else {
                off += 1
            }
            lineno += 1
            if lineno >= 3 { done = 1 }
        }
    }

    var _ch: array[u8, 2]      -- scratch: one char + null

    -- Typewriter step: plot printable chars [from, upto), return the
    -- count plotted. Registered as core.set_text_step by rooms.mos.
    function render_text_step(id: u8, from: u8, upto: u8) -> u8 {
        var off: u16 = STR_OFF[id]
        var lineno: u8 = 0
        var col: u8 = core.box_left()
        var n: u8 = 0        -- chars on THIS line (the 20-col clamp)
        var idx: u8 = 0
        var drawn: u8 = 0
        var ch: u8 = assets.code_byte(STRINGS, off)
        while ch != 0 {
            if idx >= upto {
                return drawn    -- past the window: nothing left to plot
            }
            if ch == 10 {
                lineno += 1
                col = core.box_left()
                n = 0
                if lineno >= 3 {
                    return drawn
                }
            } else if ch == 1 {
                -- a $var$ token: the digits appear as ONE step
                off += 1
                var vi: u8 = assets.code_byte(STRINGS, off)
                var vv: u16 = core.var_get(vi)
                if idx >= from {
                    text.print_number(col, core.box_top() + lineno, vv)
                    drawn += 1
                }
                col += 1
                if vv > 9 { col += 1 }
                if vv > 99 { col += 1 }
                if vv > 999 { col += 1 }
                if vv > 9999 { col += 1 }
                idx += 1
            } else {
                if idx >= from {
                    if n < 20 {     -- render_text's _line clamp
                        _ch[0] = ch
                        _ch[1] = 0
                        text.print_string(col, core.box_top() + lineno, _ch)
                    }
                    drawn += 1
                }
                col += 1
                n += 1
                idx += 1
            }
            off += 1
            ch = assets.code_byte(STRINGS, off)
        }
        return drawn
    }

    -- Draw menu option `id` at `row` with a cursor when selected.
    function render_choice(id: u8, row: u8, sel: u8) {
        if sel == 1 {
            text.print_string(1, row, ">")
        } else {
            text.print_string(1, row, " ")
        }
        var off: u16 = STR_OFF[id]
        var n: u8 = 0
        var ch: u8 = assets.code_byte(STRINGS, off)
        while ch != 0 and ch != 10 {
            if n < 20 {
                _line[n] = ch
                n += 1
            }
            off += 1
            ch = assets.code_byte(STRINGS, off)
        }
        _line[n] = 0
        text.print_string(3, row, _line)
    }

    export fetch, code_window, render_text, render_choice, text_lines, render_text_step, ENTRY_main, ENTRY_enter, ENTRY_leave, ENTRY_skip, ENTRY_beat, ENTRY_enter_beat, ENTRY_p_boot, ENTRY_p_title, ENTRY_star, ENTRY_p_tunnel, ENTRY_dancer0, ENTRY_dancer1, ENTRY_dancer2, ENTRY_dancer3, ENTRY_dancer, ENTRY_p_plasma, ENTRY_plasma_show, ENTRY_p_floor, ENTRY_shape_mood, ENTRY_p_fire, ENTRY_cool, ENTRY_ember, ENTRY_p_sky, ENTRY_show, ENTRY_shell_lo, ENTRY_shell_mid, ENTRY_shell_hi, ENTRY_burst
}
