        const CYCN: u8 = 10
        const RAMP: array[u16, 50] = [
            3, 7180, 18443, 27781, 31137, 32484, 32687, 25499,
            7740, 1166, 39, 275, 633, 6009, 19444, 32751,
            32390, 28936, 20525, 8207, 3079, 15380, 26774, 32182,
