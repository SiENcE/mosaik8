    -- Upload ONE chunk of this scene. Steps 0..TSTEPS-1 are tile data (128
    -- bytes each, staged through gfx.buf), the rest are map rows. Returns 1
    -- after the last step. A part loads over ~0.5 s with the music running.
    function load_tiles(step: u8) {
        var off: u16 = step
        off = off << 7
        for i in 0..128 {
            gfx.buf[i] = TILES[off + i]
        }
        var first: u8 = step * TPS
        var n: u8 = TPS
        if first + n > NT {
            n = NT - first
        }
        vram.tiles(first, n)
    }

    function row_tunnel(y: u8) {
        var o: u16 = y
        o = o << 5
        for i in 0..32 {
            gfx.buf[i] = MAP_T[o + i]
        }
        bkg.set_tiles(0, y, 32, 1, gfx.buf)
        if platform == "gameboy_color" {
            for i in 0..32 {
                gfx.buf[i] = ATTR_T[o + i]
            }
            bkg.set_attrs(0, y, 32, 1, gfx.buf)
        }
    }

    function row_plasma(y: u8) {
        var o: u16 = y
        o = o << 5
        for i in 0..32 {
            gfx.buf[i] = MAP_P[o + i]
        }
        bkg.set_tiles(0, y, 32, 1, gfx.buf)
        if platform == "gameboy_color" {
            for i in 0..32 {
                gfx.buf[i] = ATTR_P[o + i]
            }
            bkg.set_attrs(0, y, 32, 1, gfx.buf)
        }
    }

    -- which: 0 = tunnel, 1 = plasma. `skip` = the tileset is already in VRAM.
    function load(which: u8, step: u8, skip: u8) -> u8 {
        var st: u8 = step
        if skip == 0 {
            if st < TSTEPS {
                load_tiles(st)
                return 0
            }
            st -= TSTEPS
        }
        var y: u8 = st * RPS
        for k in 0..RPS {
            if y < MH {
                if which == 0 {
                    row_tunnel(y)
                } else {
                    row_plasma(y)
                }
            }
            y += 1
        }
        if y >= MH {
            return 1
        }
        return 0
    }

    -- Install colour ramp `r` as the cycling levels (see pal.mos).
    function ramp(r: u8) {
        if platform == "gameboy" {
            pal.set_dmg(4, 0xE4)
        } else {
            var o: u16 = r
            o = o * CYCN
            for i in 0..CYCN {
                pal.lev[i] = RAMP[o + i]
            }
            pal.cyc_n = CYCN
            pal.touch()
        }
    }

    -- The palette LAYOUT of the cyclic tileset: which hardware entries cycle.
    function layout() {
        if platform == "gameboy" {
            pal.set_dmg(4, 0xE4)
        } else if platform == "gameboy_color" {
            -- 8 overlapping palettes: palette p = levels 3p .. 3p+3
            for p in 0..8 {
                for k in 0..4 {
                    var l: u8 = p * 3 + k
                    if l >= 24 {
                        l -= 24
                    }
                    pal.src[p * 4 + k] = l
                }
            }
        } else {
            pal.src[0] = 128
            pal.fix[0] = 0
            for i in 0..10 {
                pal.src[i + 1] = i
            }
            for i in 11..16 {
                pal.src[i] = 128
            }
        }
        pal.touch()
    }
    export load, ramp, layout, row_tunnel, row_plasma
}
