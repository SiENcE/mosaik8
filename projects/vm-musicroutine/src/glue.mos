-- GENERATED by MosaiK8 Studio (mosaik_vm) -- the VM8 subsystem WIRING.
-- The fixed shell calls glue.setup() once; this wires SOUND (always) + the MUSIC
-- driver when the project has songs. Regenerated from project content, so adding a
-- song auto-wires music. Edit the project (tracker / Build > Options), not this file.
-- NOTE: gb play through the REAL hUGEDriver (vm.music_huge over
-- native.huge, a prebuilt object in mosaik8/vendor/hugedriver), so playback is
-- bit-true hUGETracker. Its song DATA is generated C rendered from songs.toml
-- at BUILD time (mosaik_vm.huge), not the songs module -- which is why no song
-- tables are wired on those consoles. It registers the SAME core seam, so
-- vm.core and every music_play script are unchanged.
-- NOTE: pce/nes have no music driver, so setup() forks and wires only sound there
-- (with [build] shake_exports the driver + song data cost them nothing).

module "glue" {
    import "vm.core"
    import "vm.snd"
    import "vm.music_huge"
    import "vm.music"
    import "songs"

    if platform == "lynx" or platform == "sms" or platform == "gamegear" {
        function setup() {
            core.set_sound(snd.sfx, snd.tone, snd.stop)
            core.set_music_voice(snd.mtone, snd.mstop)
            core.set_music_driver(music.play, music.update, music.stop)
            music.set_song(songs.channels, songs.chkind, songs.cell, songs.frames, songs.rows)
            music.set_voicing(songs.flags)
            core.set_music_ctl(music.pause, music.resume, music.mute)
            core.set_music_routines(music.routine_next)
        }
    } else {
        if platform == "gameboy" or platform == "gameboy_color" or platform == "analogue_pocket" or platform == "megaduck" {
            function setup() {
                core.set_sound(snd.sfx, snd.tone, snd.stop)
                core.set_music_voice(snd.mtone, snd.mstop)
                core.set_music_driver(music_huge.play, music_huge.update, music_huge.stop)
                core.set_music_ctl(music_huge.pause, music_huge.resume, music_huge.mute)
                core.set_music_routines(music_huge.routine_next)
            }
        } else {
            function setup() {
                core.set_sound(snd.sfx, snd.tone, snd.stop)
                core.set_music_voice(snd.mtone, snd.mstop)
            }
        }
    }

    export setup
}
